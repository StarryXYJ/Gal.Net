/*
@gal.effect v=1
@input source
@targets layer,scenePost

@param radius
  uniform: radius
  type: float
  default: 0
  range: 0..64
  animatable: true

@param direction
  uniform: direction
  type: vector2
  default: [1,0]
  animatable: false
*/
uniform shader source;
uniform float radius;
uniform float2 direction;
half4 main(float2 p) {
    if (radius <= 0.001) return source.eval(p);
    float4 sum = float4(source.eval(p));
    float weights = 1.0;
    for (int i = 1; i <= 12; i++) {
        float t = float(i) / 12.0;
        float w = exp(-4.5 * t * t);
        float2 d = direction * radius * t;
        sum += (float4(source.eval(p+d)) + float4(source.eval(p-d))) * w;
        weights += 2.0 * w;
    }
    return half4(sum / weights);
}
