/*
@gal.effect v=1
@input source
@targets layer

@param progress
  uniform: progress
  type: float
  default: 0
  range: 0..1
  animatable: true

@param bladeCount
  uniform: bladeCount
  type: float
  default: 12
  range: 1..512
  step: 1
  animatable: false

@param orientation
  uniform: horizontal
  type: enum
  options: Vertical,Horizontal
  default: Vertical
*/
uniform shader source;
uniform float progress;
uniform float bladeCount;
uniform float horizontal;
uniform float2 size;

half4 main(float2 p) {
    float count = max(1.0, floor(bladeCount + 0.5));
    float span = horizontal > 0.5 ? size.y : size.x;
    float coordinate = horizontal > 0.5 ? p.y : p.x;
    // Work in each blade's physical pixel span. This avoids relying on a backend's
    // normalized-fract optimization and makes every blade reveal independently.
    float positionInBlade = mod(coordinate, span / count);
    float reveal = step(positionInBlade, (span / count) * progress);
    return source.eval(p) * reveal;
}
