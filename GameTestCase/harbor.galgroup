    { "id": "40000000000000000000000000000015", "type": "text", "parameters": { "speaker": "Guide", "content": "The snowfall has stopped; the last flakes are still settling." } },
    { "id": "40000000000000000000000000000016", "type": "text", "parameters": { "speaker": "Guide", "content": "And now the platform is quiet again." } },
