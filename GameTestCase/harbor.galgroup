    { "id": "40000000000000000000000000000007", "type": "variable.set", "parameters": { "target": "save.route", "expression": "\"harbor\"" } },
    { "id": "40000000000000000000000000000008", "type": "text", "parameters": { "speaker": "Guide", "content": "<i>Filled background selected.</i>\\d{220} This route keeps the <color=#A7F3D0>Fill</color> display mode." } },
    { "id": "40000000000000000000000000000012", "type": "text", "parameters": { "speaker": "Guide", "content": "Snow has begun to drift across the harbor lights." } },
    { "id": "40000000000000000000000000000013", "type": "text", "parameters": { "speaker": "Guide", "content": "Each flake is borrowed from the emitter pool, then returned when its flight ends." } },
