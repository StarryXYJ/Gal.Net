// Minimal published-game fixture for the Headless simulation script.
layer.show : id: background; asset: assets/backgrounds/station-platform.png; x: 0; y: 0; z: 0; transitionId: black; transitionDuration: 0.2; transitionBlocking: true
layer.show : id: guide; asset: assets/characters/guide-neutral.png; x: 680; y: 230; z: 10
layer.move : id: guide; x: 700; y: 250; z: 10; duration: 0.15
layer.show : id: light; asset: assets/effects/platform-light.png; x: 720; y: 270; z: 20
layer.show : id: foreground; asset: assets/effects/platform-foreground.png; x: 740; y: 290; z: 30
audio.play : channel: bgm; asset: assets/audio/station-loop.ogg; volume: 0.5; mode: loop; times: 1
effect.apply : id: weather.rain; instanceId: platform-rain; duration: -1; blocking: false; parameters: intensity=low
dialogue.show
variable.set : target: player.simulation_completed; expression: true
variable.set : target: save.simulation_slot_marker; expression: 7
text : speaker: Guide; content: <b>The station is ready.</b>\d{450}\n<i>Choose where to continue.</i> <color=#7DD3FC>Both routes are open.</color>
