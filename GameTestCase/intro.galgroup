    { "id": "10000000000000000000000000000001", "type": "layer.show", "parameters": { "handleId": "20000000000000000000000000000001", "assetId": "bg classroom.jpeg", "transform": { "x": 0, "y": 0, "rotationDegrees": 0, "scaleX": 1, "scaleY": 1 }, "z": 0, "displayMode": "Fill", "transitionId": "black", "transitionDuration": 0.2, "transitionBlocking": true } },
    { "id": "10000000000000000000000000000033", "type": "layer.show", "parameters": { "handleId": "missing-layer-demo", "assetId": "__missing_layer_demo__.png", "transform": { "x": -500, "y": -250, "rotationDegrees": 0, "scaleX": 0.18, "scaleY": 0.18 }, "z": 5, "displayMode": "Native" } },
    { "id": "10000000000000000000000000000002", "type": "layer.show", "parameters": { "handleId": "20000000000000000000000000000002", "assetId": "xy  (17).png", "transform": { "x": 680, "y": 230, "rotationDegrees": 0, "scaleX": 1, "scaleY": 1 }, "z": 10, "displayMode": "Native" } },
    { "id": "10000000000000000000000000000007", "type": "audio.play", "parameters": { "channel": "bgm", "asset": "assets/audio/station-loop.ogg", "volume": 0.5, "mode": "loop", "times": 1 } },
    { "id": "10000000000000000000000000000008", "type": "effect.apply", "parameters": { "id": "weather.rain", "instanceId": "platform-rain", "parameters": {} } },
    { "id": "10000000000000000000000000000009", "type": "dialogue.show", "parameters": {} },
    { "id": "10000000000000000000000000000010", "type": "variable.set", "parameters": { "target": "player.simulation_completed", "expression": "true" } },
    { "id": "10000000000000000000000000000011", "type": "variable.set", "parameters": { "target": "save.simulation_slot_marker", "expression": "7" } },
    { "id": "10000000000000000000000000000012", "type": "text", "parameters": { "speaker": "Guide", "content": "<b>The station is ready.</b>\\d{450}\\n<i>Let me show you the platform.</i>" } },
    { "id": "10000000000000000000000000000013", "type": "animation.play", "parameters": { "plan": { "playbackHandleId": "30000000000000000000000000000001", "frameRate": 60, "durationFrames": 120, "blocking": true, "skippable": true, "tracks": [ { "handleId": "20000000000000000000000000000002", "property": "transform.x", "keys": [ { "frame": 0, "value": 680, "interpolationToNext": "Linear" }, { "frame": 45, "value": 540, "outTangent": -3, "interpolationToNext": "CubicHermite" }, { "frame": 105, "value": 420, "inTangent": 0, "interpolationToNext": "Linear" }, { "frame": 120, "value": 420 } ] }, { "handleId": "20000000000000000000000000000002", "property": "transform.y", "keys": [ { "frame": 0, "value": 230, "interpolationToNext": "Step" }, { "frame": 30, "value": 230, "interpolationToNext": "Linear" }, { "frame": 75, "value": 150 }, { "frame": 120, "value": 150 } ] }, { "handleId": "20000000000000000000000000000002", "property": "opacity", "keys": [ { "frame": 0, "value": 1, "interpolationToNext": "Step" }, { "frame": 75, "value": 1, "interpolationToNext": "Linear" }, { "frame": 90, "value": 0.55, "interpolationToNext": "Linear" }, { "frame": 117, "value": 1 }, { "frame": 120, "value": 1 } ] } ] } } },
    { "id": "10000000000000000000000000000014", "type": "animate", "parameters": { "playbackHandleId": "30000000000000000000000000000003", "handleId": "20000000000000000000000000000002", "property": "transform.rotationDegrees", "from": 0, "to": 360, "duration": 1.2, "curve": "Linear", "loopMode": "Loop", "blocking": false, "skippable": false } },
    { "id": "10000000000000000000000000000015", "type": "animate", "parameters": { "playbackHandleId": "30000000000000000000000000000004", "handleId": "20000000000000000000000000000002", "property": "transform.x", "from": 0, "to": 10, "duration": 0.18, "curve": "EaseInOut", "loopMode": "PingPong", "blocking": false, "skippable": false, "blendMode": "Additive" } },
    { "id": "10000000000000000000000000000016", "type": "animate", "parameters": { "playbackHandleId": "30000000000000000000000000000005", "handleId": "20000000000000000000000000000002", "property": "transform.y", "from": 0, "to": -7, "duration": 0.24, "curve": "EaseInOut", "loopMode": "PingPong", "blocking": false, "skippable": false, "blendMode": "Additive" } },
    { "id": "10000000000000000000000000000017", "type": "animate", "parameters": { "playbackHandleId": "30000000000000000000000000000006", "handleId": "20000000000000000000000000000002", "property": "opacity", "from": 0, "to": -0.12, "duration": 0.38, "curve": "EaseInOut", "loopMode": "PingPong", "blocking": false, "skippable": false, "blendMode": "Additive" } },
    { "id": "10000000000000000000000000000018", "type": "text", "parameters": { "speaker": "Guide", "content": "A keyframe AnimationPlan has played Step, Linear, and Hermite tracks together. The portrait now rotates while its relative position and opacity loops are added on top." } },
    { "id": "10000000000000000000000000000020", "type": "text", "parameters": { "speaker": "Guide", "content": "While this dialogue advances, the portrait keeps rotating with a subtle floating and fading offset." } },
    { "id": "10000000000000000000000000000021", "type": "text", "parameters": { "speaker": "Guide", "content": "All loops have separate playback handles and remain non-blocking." } },
    { "id": "10000000000000000000000000000026", "type": "text", "parameters": { "speaker": "Guide", "content": "The platform hums beneath us, and the motion settles into a quick, soft rhythm." } },
    { "id": "10000000000000000000000000000027", "type": "text", "parameters": { "speaker": "Guide", "content": "When we leave the platform, each relative loop will return smoothly to its starting pose." } },
    { "id": "10000000000000000000000000000022", "type": "animation.stop", "parameters": { "playbackHandleId": "30000000000000000000000000000003", "mode": "AfterIteration" } },
    { "id": "10000000000000000000000000000023", "type": "animation.stop", "parameters": { "playbackHandleId": "30000000000000000000000000000004", "mode": "AfterIteration" } },
    { "id": "10000000000000000000000000000032", "type": "text", "parameters": { "speaker": "Guide", "content": "All right" } },
    { "id": "10000000000000000000000000000024", "type": "animation.stop", "parameters": { "playbackHandleId": "30000000000000000000000000000005", "mode": "AfterIteration" } },
    { "id": "10000000000000000000000000000025", "type": "animation.stop", "parameters": { "playbackHandleId": "30000000000000000000000000000006", "mode": "AfterIteration" } },
    { "id": "10000000000000000000000000000019", "type": "text", "parameters": { "speaker": "Guide", "content": "<i>Choose where to continue.</i> <color=#7DD3FC>Both routes are open.</color>" } }
  ]
}
