      "id": "portrait-jitter",
      "type": "animation.animate",
      "condition": "",
      "parameters": {
        "blendMode": "Additive",
        "blocking": "false",
        "curve": "EaseInOut",
        "duration": 0.06,
        "from": 0,
        "handleId": "teacher",
        "loopMode": "PingPong",
