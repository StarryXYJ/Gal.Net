<Project>
  <Import Project="GalNet.Player.targets" />
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)ThirdParty/SDL3/*"
             Link="ThirdParty/SDL3/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
