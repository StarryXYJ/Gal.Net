<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
             x:Class="GalNet.Avalonia.GameView.Page.GalleryMediaPage"
             x:DataType="vm:GalleryMediaPageViewModel">
  <Grid Background="#05060A" RowDefinitions="Auto,*">
    <Grid Margin="24" ColumnDefinitions="*,Auto" ZIndex="2">
      <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
      <Button Grid.Column="1" Classes="player-link" Content="Back" Command="{Binding BackCommand}" />
    </Grid>
    <Image Grid.Row="1" Margin="24" Source="{Binding Image}" Stretch="Uniform" IsVisible="{Binding IsImage}" />
    <vlc:VideoView Grid.Row="1" Margin="24" MediaPlayer="{Binding VideoPlayer}" IsVisible="{Binding IsVideo}" />
    <TextBlock Grid.Row="1" Margin="40" Text="{Binding ErrorMessage}" TextWrapping="Wrap"
               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFE0A0" />
  </Grid>
</UserControl>
