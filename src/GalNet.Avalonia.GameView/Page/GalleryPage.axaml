<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GalNet.Avalonia.GameView.Page"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             x:Class="GalNet.Avalonia.GameView.Page.GalleryPage"
             x:DataType="vm:GalleryPageViewModel">
  <Grid Background="#0B0C15" Margin="44" RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Text="Gallery" FontSize="32" FontWeight="SemiBold" />
        <TextBlock Text="Unlocked memories and artwork" Opacity="0.64" />
      </StackPanel>
      <Button Grid.Column="1" Classes="player-link" Content="Back" Command="{Binding BackCommand}"
              VerticalAlignment="Center" />
    </Grid>
    <Border Grid.Row="1" Margin="0,24,0,0" Background="#48181A2A" BorderBrush="#4D5F6075"
            BorderThickness="1" CornerRadius="10" Padding="28">
      <TextBlock Text="The host's progress service supplies unlocked entries. A game can replace this default page with its own gallery view."
                 TextWrapping="Wrap" Opacity="0.72" VerticalAlignment="Center" HorizontalAlignment="Center"
                 TextAlignment="Center" MaxWidth="440" />
    </Border>
  </Grid>
</UserControl>
