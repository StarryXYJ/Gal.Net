<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GalNet.Avalonia.GameView.Page"
             x:Class="GalNet.Avalonia.GameView.Page.GalleryPage"
             x:DataType="local:GalleryPageViewModel">
  <Grid Margin="64">
    <StackPanel Width="520" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="Gallery" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Text="The host's progress service supplies unlocked entries. This default page is intentionally neutral so projects can replace its template or bind their own gallery model." TextWrapping="Wrap" />
      <Button Content="Back" Command="{Binding BackCommand}" HorizontalAlignment="Right" />
    </StackPanel>
  </Grid>
</UserControl>
