<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GalNet.Avalonia.GameView.Page"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             xmlns:gallery="using:GalNet.Core.Gallery"
             x:Class="GalNet.Avalonia.GameView.Page.GalleryPage"
             x:DataType="vm:GalleryPageViewModel">
  <Grid Background="#0B0C15" Margin="44" RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Text="Gallery" FontSize="32" FontWeight="SemiBold" />
        <TextBlock Text="Unlocked memories and artwork" Opacity="0.64" />
      </StackPanel>
      <Button Grid.Column="1" Classes="player-link" Content="Back" Command="{Binding BackCommand}"
              VerticalAlignment="Center" />
    </Grid>
    <ScrollViewer Grid.Row="1" Margin="0,24,0,0">
      <ItemsControl x:Name="TypeList" ItemsSource="{Binding Types}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel ItemWidth="260" ItemHeight="120" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="gallery:GalleryTypeData">
            <Button Margin="6" Padding="20" HorizontalContentAlignment="Stretch"
                    Command="{Binding #TypeList.DataContext.OpenTypeCommand}" CommandParameter="{Binding}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Type.TypeId}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Type.ResourceTypeName}" Opacity="0.6" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
