<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             x:Class="GalNet.Avalonia.GameView.Page.GalleryContentPage"
             x:DataType="vm:GalleryContentPageViewModel">
  <Grid Background="#0B0C15" Margin="44" RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="SemiBold" />
        <TextBlock Text="Gallery" Opacity="0.64" />
      </StackPanel>
      <Button Grid.Column="1" Classes="player-link" Content="Back" Command="{Binding BackCommand}"
              VerticalAlignment="Center" />
    </Grid>

    <ScrollViewer Grid.Row="1" Margin="0,24,0,0" IsVisible="{Binding IsVisualGrid}">
      <ItemsControl x:Name="VisualList" ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel ItemWidth="260" ItemHeight="190" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GalleryEntryViewModel">
            <Button Margin="6" Padding="0" IsEnabled="{Binding IsUnlocked}"
                    Command="{Binding #VisualList.DataContext.OpenItemCommand}" CommandParameter="{Binding}">
              <Grid RowDefinitions="*,Auto" Background="#171927">
                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding IsUnlocked}" />
                <Border Background="#333647" IsVisible="{Binding IsLocked}">
                  <TextBlock Text="Locked" HorizontalAlignment="Center" VerticalAlignment="Center"
                             FontSize="18" Opacity="0.7" />
                </Border>
                <Border Grid.Row="1" Background="#CC11131E" Padding="10,7">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="Locked" IsVisible="{Binding IsLocked}" Opacity="0.7" />
                  </Grid>
                </Border>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <ScrollViewer Grid.Row="1" Margin="0,24,0,0" IsVisible="{Binding IsAudioList}">
      <ItemsControl x:Name="AudioList" ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GalleryEntryViewModel">
            <Border Margin="0,0,0,8" Padding="14" Background="#48181A2A" CornerRadius="8"
                    BorderBrush="#4D5F6075" BorderThickness="1">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Text="{Binding Title}" FontSize="17" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Locked" IsVisible="{Binding IsLocked}" Opacity="0.7"
                           VerticalAlignment="Center" />
                <ProgressBar Grid.Row="1" Margin="0,10,12,0" Minimum="0" Maximum="100"
                             Value="{Binding Progress}" Height="5" IsVisible="{Binding IsUnlocked}" />
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Orientation="Horizontal" Spacing="10"
                            IsVisible="{Binding IsUnlocked}">
                  <TextBlock Text="{Binding TimeText}" Opacity="0.65" VerticalAlignment="Center" />
                  <Button Content="Play / Pause" Command="{Binding #AudioList.DataContext.OpenItemCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="1" Margin="0,24,0,0" Padding="28" Background="#48181A2A"
            BorderBrush="#4D5F6075" BorderThickness="1" CornerRadius="10"
            IsVisible="{Binding IsUnsupported}">
      <TextBlock Text="{Binding UnsupportedMessage}" TextWrapping="Wrap" Opacity="0.72"
                 VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
    </Border>
  </Grid>
</UserControl>
