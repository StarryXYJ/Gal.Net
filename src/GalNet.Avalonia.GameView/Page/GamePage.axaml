<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:GalNet.Game.Controls"
             xmlns:scene="using:GalNet.Game.Controls.Scene"
             xmlns:local="using:GalNet.Avalonia.GameView.Page"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             x:Class="GalNet.Avalonia.GameView.Page.GamePage"
             x:DataType="vm:GamePageViewModel">
  <Grid Background="#0B0C15">
    <!-- The whole scene pipeline is contained here. Everything below is GameShell UI. -->
    <Grid x:Name="SceneSurface" ClipToBounds="True">
      <scene:SceneLayerHost ItemsSource="{Binding Layers}" />
      <ItemsControl ItemsSource="{Binding SceneVisuals}" IsHitTestVisible="False">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
    </Grid>

    <controls:NvlPresenter ItemsSource="{Binding NvlLines}" IsVisible="{Binding IsNvlOverlayVisible}"
                           Margin="72,56,72,144" ZIndex="12" />
    <controls:DialoguePresenter x:Name="DialogueControl" IsVisible="{Binding IsDialogueOverlayVisible}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom" Margin="72,0,72,42" ZIndex="13" />
    <controls:ChoiceList ItemsSource="{Binding Choices}" SelectionCommand="{Binding CompleteChoiceCommand}"
                         IsVisible="{Binding IsChoiceOverlayVisible}" Width="500"
                         HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="50" />

    <Border IsVisible="{Binding IsGameUiVisible}" Background="Transparent" Padding="4,2"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22" ZIndex="40">
      <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="22">
        <Button Content="Save" Command="{Binding OpenSaveSlotsCommand}" Classes="quick" />
        <Button Content="Load" Command="{Binding OpenLoadSlotsCommand}" Classes="quick" />
        <Button Content="Settings" Command="{Binding OpenSettingsCommand}" Classes="quick" />
        <Button Content="Title" Command="{Binding ReturnToTitleCommand}" Classes="quick" />
        <Button Content="Screenshot" Command="{Binding RequestScreenshotCommand}" Classes="quick" />
        <Button Content="Hide UI" Command="{Binding HideUiCommand}" Classes="quick" />
      </StackPanel>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Button.quick">
      
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="Foreground" Value="#D9D8E7" />
    </Style>
    <Style Selector="Button.quick:pointerover"><Setter Property="Foreground" Value="#C9C5FF" /></Style>
  </UserControl.Styles>
</UserControl>
