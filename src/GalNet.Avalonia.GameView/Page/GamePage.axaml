<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:GalNet.Game.Controls"
             xmlns:local="using:GalNet.Avalonia.GameView.Page"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             x:Class="GalNet.Avalonia.GameView.Page.GamePage"
             x:DataType="vm:GamePageViewModel">
  <Grid Background="#101018">
    <Grid x:Name="SceneSurface">
      <controls:SceneLayerHost ItemsSource="{Binding Layers}" />
      <Border Background="{Binding TransitionBrush}" Opacity="{Binding TransitionOpacity}"
              IsHitTestVisible="False" />
    </Grid>

    <controls:NvlPresenter ItemsSource="{Binding NvlLines}" IsVisible="{Binding IsNvlOverlayVisible}"
                           Margin="64,48,64,138" ZIndex="12" />
    <controls:DialoguePresenter x:Name="DialogueControl" IsVisible="{Binding IsDialogueOverlayVisible}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom" Margin="64,0,64,94" ZIndex="13" />
    <Border IsVisible="{Binding IsChoiceOverlayVisible}" Background="#D9101018" Padding="28"
            CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center"
            Width="460" ZIndex="50">
      <controls:ChoiceList ItemsSource="{Binding Choices}" SelectionCommand="{Binding CompleteChoiceCommand}" />
    </Border>

    <Border IsVisible="{Binding IsGameUiVisible}" Background="#80202030" Padding="12,8"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" ZIndex="40">
      <StackPanel Orientation="Horizontal" Spacing="22">
        <Button Content="Save" Command="{Binding OpenSaveSlotsCommand}" Classes="quick" />
        <Button Content="Load" Command="{Binding OpenLoadSlotsCommand}" Classes="quick" />
        <Button Content="Settings" Command="{Binding OpenSettingsCommand}" Classes="quick" />
        <Button Content="Title" Command="{Binding ReturnToTitleCommand}" Classes="quick" />
        <Button Content="Screenshot" Command="{Binding RequestScreenshotCommand}" Classes="quick" />
        <Button Content="Hide UI" Command="{Binding HideUiCommand}" Classes="quick" />
      </StackPanel>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Button.quick">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="Foreground" Value="#F4F4F7" />
    </Style>
  </UserControl.Styles>
</UserControl>
