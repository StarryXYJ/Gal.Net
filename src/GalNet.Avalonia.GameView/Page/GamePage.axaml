<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:GalNet.Game.Controls"
             xmlns:local="using:GalNet.Avalonia.GameView.Page"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             x:Class="GalNet.Avalonia.GameView.Page.GamePage"
             x:DataType="vm:GamePageViewModel">
  <Grid Background="#101018">
    <controls:SceneLayerHost ItemsSource="{Binding Layers}" />
    <Border Background="{Binding TransitionBrush}" Opacity="{Binding TransitionOpacity}" IsHitTestVisible="False" ZIndex="10" />
    <Button Command="{Binding AdvanceCommand}" Background="Transparent" BorderThickness="0" ZIndex="1" />
    <controls:NvlPresenter ItemsSource="{Binding NvlLines}" IsVisible="{Binding IsNvlMode}" Margin="64,48,64,116" ZIndex="12" />
    <controls:DialoguePresenter x:Name="DialogueControl" IsVisible="{Binding IsDialogueVisible}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="64,0,64,64" ZIndex="13" />
    <Border IsVisible="{Binding IsChoiceVisible}" Background="#CC101018" Padding="24" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" ZIndex="20">
      <controls:ChoiceList ItemsSource="{Binding Choices}" SelectionCommand="{Binding CompleteChoiceCommand}" />
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" ZIndex="30">
      <Button Content="Save / Load" Command="{Binding OpenSaveSlotsCommand}" />
      <Button Content="Settings" Command="{Binding OpenSettingsCommand}" />
      <Button Content="Gallery" Command="{Binding OpenGalleryCommand}" />
      <Button Content="NVL" Command="{Binding ToggleNvlModeCommand}" />
      <Button Content="Menu" Command="{Binding ReturnToTitleCommand}" />
    </StackPanel>
    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Spacing="4" ZIndex="30">
      <TextBlock Text="{Binding StatusMessage}" MaxWidth="520" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding ActiveEffects}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Opacity="0.75" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
  </Grid>
</UserControl>
