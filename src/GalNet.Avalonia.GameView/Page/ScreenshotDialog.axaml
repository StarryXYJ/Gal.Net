<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GalNet.Avalonia.GameView.Page.ScreenshotDialog">
  <Border Width="720"
          Padding="24"
          Background="#2A2A34"
          CornerRadius="8">
    <Grid RowDefinitions="Auto,300,Auto,Auto,Auto,Auto"
          RowSpacing="14">
      <TextBlock Text="Save screenshot"
                 FontSize="22"
                 FontWeight="Bold" />

      <Border Grid.Row="1"
              Padding="8"
              Background="#15151C"
              CornerRadius="4">
        <Image Name="Preview"
               Stretch="Uniform" />
      </Border>

      <Grid Grid.Row="2"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="8">
        <StackPanel Spacing="4">
          <TextBlock Text="Folder" />
          <TextBox Name="DirectoryBox" />
        </StackPanel>
        <Button Grid.Column="1"
                Name="BrowseButton"
                VerticalAlignment="Bottom"
                Content="Choose folder…" />
      </Grid>

      <StackPanel Grid.Row="3"
                  Spacing="4">
        <TextBlock Text="File name" />
        <TextBox Name="FileNameBox"
                 PlaceholderText="Screenshot.png" />
      </StackPanel>

      <StackPanel Grid.Row="4"
                  Spacing="4">
        <CheckBox Name="IncludeUiBox"
                  Content="Include player UI" />
        <TextBlock Name="ErrorBlock"
                   Foreground="Tomato"
                   TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Grid.Row="5"
                  HorizontalAlignment="Right"
                  Orientation="Horizontal"
                  Spacing="8">
        <Button Name="CancelButton"
                Content="Cancel" />
        <Button Name="SaveButton"
                IsDefault="True"
                Content="Save" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
