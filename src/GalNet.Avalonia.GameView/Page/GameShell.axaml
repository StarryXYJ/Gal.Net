<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GalNet.Avalonia.GameView.Page"
             x:Class="GalNet.Avalonia.GameView.Page.GameShell"
             x:DataType="local:GameShellViewModel">
  <Grid Background="#101018">
    <local:TitlePage DataContext="{Binding}" IsVisible="{Binding Navigation.IsTitlePage}" />
    <local:GamePage x:Name="GamePageControl" DataContext="{Binding Game}" IsVisible="{Binding Navigation.IsGameplayPage}" />
    <local:SaveSlotsPage DataContext="{Binding Game}" IsVisible="{Binding Navigation.IsSaveSlotsPage}" />
    <local:SettingsPage DataContext="{Binding}" IsVisible="{Binding Navigation.IsSettingsPage}" />
    <local:GalleryPage DataContext="{Binding Game}" IsVisible="{Binding Navigation.IsGalleryPage}" />
    <local:AboutPage DataContext="{Binding}" IsVisible="{Binding Navigation.IsAboutPage}" />
  </Grid>
</UserControl>
