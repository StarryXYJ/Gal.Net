<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:GalNet.Game.Controls"
             xmlns:local="using:GalNet.Avalonia.GameView.Page"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             x:Class="GalNet.Avalonia.GameView.Page.SaveSlotsPage"
             x:DataType="vm:SaveSlotsPageViewModel"
             x:CompileBindings="True">
  <Grid Background="#0B0C15" Margin="44" RowDefinitions="Auto,*,Auto" RowSpacing="18">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Text="{Binding Heading}" FontSize="32" FontWeight="SemiBold" />
        <TextBlock Text="Choose a slot" Opacity="0.64" />
      </StackPanel>
      <Button Grid.Column="1" Classes="player-link" Content="Back" Command="{Binding BackCommand}"
              VerticalAlignment="Center" />
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Slots}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="4" ColumnSpacing="6" RowSpacing="8"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GameSaveSlotRowViewModel">
            <Panel Margin="7">
              <controls:SaveSlotCard SlotIndex="{Binding SlotIndex}" Timestamp="{Binding Timestamp}" Description="{Binding Description}"
                                      IsEmpty="{Binding IsEmpty}" IsCorrupt="{Binding IsCorrupt}"
                                      Command="{Binding LoadCommand}" IsVisible="{Binding !IsSaveMode}" />
              <controls:SaveSlotCard SlotIndex="{Binding SlotIndex}" Timestamp="{Binding Timestamp}" Description="{Binding Description}"
                                      IsEmpty="{Binding IsEmpty}" IsCorrupt="{Binding IsCorrupt}"
                                      Command="{Binding SaveCommand}" IsVisible="{Binding IsSaveMode}" />
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <TextBlock Grid.Row="2" Text="Saves are managed by the current game host." Opacity="0.45" FontSize="12" />
  </Grid>
</UserControl>
