<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:GalNet.Game.Controls"
             xmlns:local="using:GalNet.Avalonia.GameView.Page"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             x:Class="GalNet.Avalonia.GameView.Page.SaveSlotsPage"
             x:DataType="vm:SaveSlotsPageViewModel"
             x:CompileBindings="True">
  <Grid Margin="64" RowDefinitions="Auto,*,Auto" RowSpacing="14">
    <TextBlock Text="{Binding Heading}" FontSize="28" FontWeight="SemiBold" />
    <ScrollViewer Grid.Row="1" MaxHeight="560">
      <ItemsControl ItemsSource="{Binding Slots}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GameSaveSlotRowViewModel">
            <Grid ColumnDefinitions="*" Margin="0,4">
              <controls:SaveSlotCard SlotIndex="{Binding SlotIndex}" Timestamp="{Binding Timestamp}" Description="{Binding Description}" IsEmpty="{Binding IsEmpty}" IsCorrupt="{Binding IsCorrupt}"
                                      Command="{Binding LoadCommand}" IsVisible="{Binding !IsSaveMode}" />
              <Button Content="Save" Command="{Binding SaveCommand}" IsVisible="{Binding IsSaveMode}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Button Grid.Row="2" Content="Back" Command="{Binding BackCommand}" HorizontalAlignment="Right" />
  </Grid>
</UserControl>
