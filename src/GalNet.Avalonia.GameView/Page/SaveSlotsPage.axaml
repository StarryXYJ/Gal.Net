<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GalNet.Avalonia.GameView.Page"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             x:Class="GalNet.Avalonia.GameView.Page.SaveSlotsPage"
             x:DataType="vm:SaveSlotsPageViewModel"
             x:CompileBindings="True">
  <Grid Background="#0B0C15" Margin="44" RowDefinitions="Auto,*,Auto" RowSpacing="18">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Text="{Binding Heading}" FontSize="32" FontWeight="SemiBold" />
        <TextBlock Text="Choose a slot" Opacity="0.64" />
      </StackPanel>
      <Button Grid.Column="1" Classes="player-link" Content="Back" Command="{Binding BackCommand}"
              VerticalAlignment="Center" />
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Slots}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GameSaveSlotRowViewModel">
            <Grid Margin="7">
              <Button Classes="save-slot" Command="{Binding LoadCommand}" IsVisible="{Binding !IsSaveMode}">
                <Border Classes="slot-surface" MinHeight="136" Padding="16" CornerRadius="8"
                        Background="#B81B1C27" BorderBrush="#665F6075" BorderThickness="1">
                  <Grid RowDefinitions="*,Auto" RowSpacing="12">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                      <TextBlock FontWeight="SemiBold" FontSize="16"><Run Text="Slot " /><Run Text="{Binding SlotIndex}" /></TextBlock>
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.75" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="2">
                      <TextBlock Text="{Binding Timestamp}" FontSize="12" Opacity="0.74" />
                      <TextBlock Text="Empty" FontSize="12" Opacity="0.56" IsVisible="{Binding IsEmpty}" />
                      <TextBlock Text="Corrupt save" FontSize="12" Foreground="IndianRed" IsVisible="{Binding IsCorrupt}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </Button>
              <Button Classes="save-slot" Command="{Binding SaveCommand}" IsVisible="{Binding IsSaveMode}">
                <Border Classes="slot-surface" MinHeight="136" Padding="16" CornerRadius="8"
                        Background="#B81B1C27" BorderBrush="#665F6075" BorderThickness="1">
                  <Grid RowDefinitions="*,Auto" RowSpacing="12">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                      <TextBlock FontWeight="SemiBold" FontSize="16"><Run Text="Slot " /><Run Text="{Binding SlotIndex}" /></TextBlock>
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.75" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="2">
                      <TextBlock Text="{Binding Timestamp}" FontSize="12" Opacity="0.74" />
                      <TextBlock Text="Empty — save here" FontSize="12" Opacity="0.56" IsVisible="{Binding IsEmpty}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </Button>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <TextBlock Grid.Row="2" Text="Saves are managed by the current game host." Opacity="0.45" FontSize="12" />
  </Grid>
</UserControl>
