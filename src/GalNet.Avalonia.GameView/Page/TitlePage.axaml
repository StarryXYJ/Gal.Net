<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GalNet.Avalonia.GameView.Page"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             x:Class="GalNet.Avalonia.GameView.Page.TitlePage"
             x:DataType="vm:TitlePageViewModel">
  <Grid Background="#101018">
    <Border Width="560" Padding="56,42" Background="#B8181A2A" CornerRadius="12"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding GameTitle}" FontSize="40" FontWeight="Bold"
                   HorizontalAlignment="Center" TextAlignment="Center" />
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" HorizontalAlignment="Center"
                   TextAlignment="Center" Opacity="0.78" Margin="0,0,0,18" />
        <Button Content="Start new game" Command="{Binding StartNewGameCommand}"
                IsEnabled="{Binding IsReady}" HorizontalAlignment="Stretch" />
        <Button Content="Continue" Command="{Binding ContinueCommand}"
                IsEnabled="{Binding CanContinue}" HorizontalAlignment="Stretch" />
        <Button Content="Save" Command="{Binding OpenSaveSlotsCommand}" HorizontalAlignment="Stretch" />
        <Button Content="Load" Command="{Binding OpenLoadSlotsCommand}" HorizontalAlignment="Stretch" />
        <Button Content="Settings" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Stretch" />
        <Button Content="Gallery" Command="{Binding OpenGalleryCommand}" HorizontalAlignment="Stretch" />
        <Button Content="About" Command="{Binding OpenAboutCommand}" HorizontalAlignment="Stretch" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
