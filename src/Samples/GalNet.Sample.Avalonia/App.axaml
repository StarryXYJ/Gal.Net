<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GalNet.Sample.Avalonia.App"
             xmlns:semi="https://irihi.tech/semi"            
             xmlns:usemi="https://irihi.tech/ursa/themes/semi"
             xmlns:loc="using:DynamicLocalization.Core"
             xmlns:typography="using:GalNet.Avalonia.Themes"

             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <DataTemplate DataType="loc:LocalizedString" x:DataType="loc:LocalizedString">
            <TextBlock Text="{Binding Value}" />
        </DataTemplate>
    </Application.DataTemplates>
    <Application.Styles>
        <semi:SemiTheme></semi:SemiTheme>
        <semi:UrsaSemiTheme></semi:UrsaSemiTheme>
        <Style Selector=":is(Window)">
            <Setter Property="FontFamily" Value="{x:Static typography:GameTypography.UiFontFamily}" />
        </Style>
    </Application.Styles>
</Application>
