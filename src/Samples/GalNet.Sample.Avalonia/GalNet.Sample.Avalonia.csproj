<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EnableGameDebugging Condition="'$(EnableGameDebugging)' == '' And '$(Configuration)' == 'Debug'">true</EnableGameDebugging>
    <EnableGameDebugging Condition="'$(EnableGameDebugging)' == ''">false</EnableGameDebugging>
    <EnableLaunchArguments Condition="'$(EnableLaunchArguments)' == ''">$(EnableGameDebugging)</EnableLaunchArguments>
    <NuGetLockFilePath Condition="'$(EnableGameDebugging)' != 'true' And '$(PublishProfile)' != 'WindowsReadyToRun' And '$(PublishProfile)' != 'Desktop'">$(MSBuildProjectDirectory)/packages.lock.NoGameDebugging.json</NuGetLockFilePath>
    <DefineConstants Condition="'$(EnableGameDebugging)' == 'true'">$(DefineConstants);GALNET_GAME_DEBUG</DefineConstants>
    <DefineConstants Condition="'$(EnableLaunchArguments)' == 'true'">$(DefineConstants);GALNET_LAUNCH_ARGS</DefineConstants>
    <NuGetLockFilePath Condition="'$(EnableGameDebugging)' == 'true' And '$(PublishProfile)' == 'WindowsReadyToRun'">$(MSBuildProjectDirectory)/packages.lock.WindowsReadyToRun.Debugging.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(EnableGameDebugging)' == 'true' And '$(PublishProfile)' == 'Desktop'">$(MSBuildProjectDirectory)/packages.lock.Desktop.$(RuntimeIdentifier).Debugging.json</NuGetLockFilePath>
    <CopyOutputSymbolsToPublishDirectory Condition="'$(EnableGameDebugging)' != 'true'">false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Shared/GalNet.Debugging/GalNet.Debugging.csproj" Condition="'$(EnableGameDebugging)' == 'true'" />
    <ProjectReference Include="../../Infrastructure/GalNet.Media.LibVlc/GalNet.Media.LibVlc.csproj" />
    <ProjectReference Include="../../Shared/GalNet.GameHost/GalNet.GameHost.csproj" />
    <ProjectReference Include="../../Presentation/GalNet.Avalonia.GameHost/GalNet.Avalonia.GameHost.csproj" />
    <ProjectReference Include="..\..\Presentation\GalNet.Avalonia.Themes\GalNet.Avalonia.Themes.csproj" />
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Localization\*.json" />
    <Folder Include="ViewModels\" />
    <Compile Update="Views\LanguageSelectionView.axaml.cs">
      <DependentUpon>LanguageSelectionView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(EnableGameDebugging)' != 'true'">None</IncludeAssets>
      <PrivateAssets Condition="'$(EnableGameDebugging)' != 'true'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="DynamicLocalization.Core" />
    <PackageReference Include="Irihi.Ursa" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Condition="('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))) Or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GalNet.Sample.Contracts\GalNet.Sample.Contracts.csproj" />
    <ProjectReference Include="..\..\Presentation\GalNet.Avalonia.Controls\GalNet.Avalonia.Controls.csproj" />
    <ProjectReference Include="..\..\Presentation\GalNet.Avalonia.GameView\GalNet.Avalonia.GameView.csproj" />
    <ProjectReference Include="..\..\Shared\GalNet.Assets\GalNet.Assets.csproj" />
    <ProjectReference Include="..\..\Shared\GalNet.Core\GalNet.Core.csproj" />
    <ProjectReference Include="..\..\Shared\GalNet.Presentation.Abstractions\GalNet.Presentation.Abstractions.csproj" />
    <ProjectReference Include="..\..\Shared\GalNet.Primitives.Builtins\GalNet.Primitives.Builtins.csproj" />
    <ProjectReference Include="..\..\Shared\GalNet.Contracts.Builtins\GalNet.Contracts.Builtins.csproj" />
    <ProjectReference Include="..\..\Shared\GalNet.Runtime\GalNet.Runtime.csproj" />
    <ProjectReference Include="..\..\Infrastructure\GalNet.Storage.FileSystem\GalNet.Storage.FileSystem.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Benchmark)' == 'true'">
    <ProjectReference Include="../../Shared/GalNet.Diagnostics/GalNet.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableGameDebugging)' != 'true'">
    <Compile Remove="Debug/**/*.cs;Services/SampleDebug*.cs;Services/SampleGameSessionService.Debug.cs;Views/Debug*.cs;Views/MainWindow.Debug.cs" />
    <AvaloniaResource Remove="Views/Debug*.axaml" />
    <AvaloniaXaml Remove="Views/Debug*.axaml" />
  </ItemGroup>
  <!-- The SDK property alone does not exclude referenced-project and native-package PDBs. -->
  <Target Name="ValidateSampleLaunchCapabilities" BeforeTargets="CoreCompile">
    <Error Condition="'$(EnableGameDebugging)' == 'true' And '$(EnableLaunchArguments)' != 'true'" Text="Game debugging requires EnableLaunchArguments=true." />
  </Target>
  <Target Name="ExcludePlayerPublishSymbols" AfterTargets="ComputeFilesToPublish" Condition="'$(CopyOutputSymbolsToPublishDirectory)' == 'false'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
