<ursa:UrsaWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:GalNet.Game.Controls"
        xmlns:debug="using:GalNet.Sample.Avalonia.Debug"
        xmlns:loc="clr-namespace:GalNet.Sample.Avalonia.MarkupExtensions"
        xmlns:ursa="https://irihi.tech/ursa"
        x:Class="GalNet.Sample.Avalonia.Views.MainWindow"
        Width="1280" Height="720" MinWidth="800" MinHeight="500"
        Background="Black"
        Icon="/Assets/avalonia-logo.ico"
        Title="{loc:Localize App.Title}">
  <ursa:UrsaWindow.LeftContent>
    <Menu x:Name="DebugMenu" IsVisible="False" x:DataType="debug:SampleDebugViewModel">
      <MenuItem Header="{loc:Localize Debug.Menu}">
        <MenuItem Header="{loc:Localize Debug.ClearPlayerState}" Command="{Binding ClearPlayerStateCommand}" />
        <MenuItem Header="{loc:Localize Debug.ReloadGameResources}" Command="{Binding ReloadGameResourcesCommand}" />
        <Separator />
        <MenuItem Header="{loc:Localize Debug.Save}">
          <MenuItem Header="{loc:Localize Debug.SaveProgressOnly}" Command="{Binding SaveProgressOnlyCommand}" />
          <MenuItem Header="{loc:Localize Debug.SaveGalgroup}" Command="{Binding SaveGalGroupStartCommand}" />
        </MenuItem>
        <Separator />
        <MenuItem Header="{loc:Localize Debug.ShowLog}" Command="{Binding ShowLogCommand}" />
        <MenuItem Header="{loc:Localize Debug.OpenLogDirectory}" Command="{Binding OpenLogDirectoryCommand}" />
      </MenuItem>
    </Menu>
  </ursa:UrsaWindow.LeftContent>
  <controls:GameCanvasHost x:Name="GameCanvas"
                           DesignWidth="1920"
                           DesignHeight="1080" />
</ursa:UrsaWindow>
