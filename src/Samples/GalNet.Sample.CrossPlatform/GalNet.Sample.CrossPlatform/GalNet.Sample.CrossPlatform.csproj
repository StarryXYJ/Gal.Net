<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <GalNetPlayerAssembly>true</GalNetPlayerAssembly>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectReference Include="../../../Presentation/GalNet.Avalonia.GameHost/GalNet.Avalonia.GameHost.csproj" Condition="'$(GalNetUsePackages)' != 'true'" />
    <ProjectReference Include="../../../Presentation/GalNet.Avalonia.Themes/GalNet.Avalonia.Themes.csproj" Condition="'$(GalNetUsePackages)' != 'true'" />
    <ProjectReference Include="../../GalNet.Sample.Contracts/GalNet.Sample.Contracts.csproj" />
    <ProjectReference Include="../../../Presentation/GalNet.Avalonia.Debugging/GalNet.Avalonia.Debugging.csproj" Condition="'$(EnableGameDebugging)' == 'true' And '$(GalNetUsePackages)' != 'true'" />
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="..\..\..\Branding\galnet.ico" Link="Assets\galnet.ico" />
    <AvaloniaResource Include="..\..\..\Branding\galnet.png" Link="Assets\galnet.png" />
    <EmbeddedResource Include="Localization/*.json" />
  </ItemGroup>

  <ItemGroup Condition="'$(GalNetUsePackages)' == 'true'">
    <PackageReference Include="GalNet.Avalonia" />
    <PackageReference Include="GalNet.Avalonia.Debugging" Condition="'$(EnableGameDebugging)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(EnableGameDebugging)' != 'true'">None</IncludeAssets>
      <PrivateAssets Condition="'$(EnableGameDebugging)' != 'true'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\MainWindow.Debug.cs">
      <DependentUpon>MainWindow.axaml.cs</DependentUpon>
    </Compile>
    <Compile Update="Views\MainWindow.Fullscreen.cs">
      <DependentUpon>MainWindow.axaml.cs</DependentUpon>
    </Compile>
    <Compile Update="Views\MainWindow.Chrome.cs">
      <DependentUpon>MainWindow.axaml.cs</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
