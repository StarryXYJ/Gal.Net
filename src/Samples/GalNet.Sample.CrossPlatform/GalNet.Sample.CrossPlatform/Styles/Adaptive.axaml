<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector=".compact-player Border.player-page-frame">
    <Setter Property="Margin" Value="12" />
    <Setter Property="Padding" Value="8" />
  </Style>
  <Style Selector=".compact-player Grid#PageHeader">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="ColumnSpacing" Value="12" />
  </Style>
  <Style Selector=".compact-player Grid#PageHeader TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector=".compact-player Border#PageFrame > Grid > Border">
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style Selector=".compact-player Border#PageFrame > Grid > ScrollViewer">
    <Setter Property="Margin" Value="0,12,0,0" />
  </Style>
  <Style Selector=".compact-player Button.player-back">
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="14,7" />
  </Style>
  <Style Selector=".compact-player Border.player-settings-card">
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector=".compact-player Button.player-menu">
    <Setter Property="MinHeight" Value="40" />
  </Style>
  <Style Selector=".compact-player Button.player-input-binding, .compact-player ComboBox">
    <Setter Property="MinHeight" Value="40" />
  </Style>
  <Style Selector=".compact-player Button, .compact-player ToggleButton, .compact-player CheckBox, .compact-player Slider, .compact-player ComboBoxItem">
    <Setter Property="MinHeight" Value="40" />
  </Style>
  <Style Selector=".compact-player Button, .compact-player ToggleButton">
    <Setter Property="MinWidth" Value="40" />
  </Style>
  <Style Selector=".compact-player ScrollViewer#TitleMenu">
    <Setter Property="Margin" Value="0,12,0,0" />
    <Setter Property="MaxWidth" Value="340" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector=".compact-player StackPanel#TitleButtons">
    <Setter Property="Margin" Value="0" />
  </Style>
</Styles>
