<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:page="using:GalNet.Avalonia.GameView.Page">
  <CornerRadius x:Key="GalNet.Theme.CornerRadius">6</CornerRadius>
  <Thickness x:Key="GalNet.Theme.PageMargin">48,36</Thickness>
  <Thickness x:Key="GalNet.Theme.PanelPadding">0</Thickness>
  <x:Double x:Key="GalNet.Theme.PageMaxWidth">1480</x:Double>
  <x:Double x:Key="GalNet.Theme.PageHeaderMinHeight">64</x:Double>
  <x:Double x:Key="GalNet.Theme.BackMinWidth">80</x:Double>
  <x:Double x:Key="GalNet.Theme.BackMinHeight">40</x:Double>
  <x:Double x:Key="GalNet.Theme.ControlMinHeight">40</x:Double>
  <x:Double x:Key="GalNet.Theme.CardHeight">210</x:Double>
  <x:Double x:Key="GalNet.Theme.PanelWidth">640</x:Double>
  <x:Double x:Key="GalNet.Theme.DialogueHeight">210</x:Double>
  <Thickness x:Key="GalNet.Theme.DialoguePadding">28</Thickness>
  <Thickness x:Key="GalNet.Theme.ChoicePadding">24,16</Thickness>
  <Thickness x:Key="GalNet.Theme.ChoiceMargin">0,7</Thickness>
  <x:Int32 x:Key="GalNet.Theme.CardColumns">4</x:Int32>
  <x:Double x:Key="GalNet.Theme.PageHeaderSpacing">16</x:Double>
  <Thickness x:Key="GalNet.Theme.ContentMargin">0,20,0,0</Thickness>
  <Thickness x:Key="GalNet.Theme.RuleMargin">0,12,0,0</Thickness>
</ResourceDictionary>
