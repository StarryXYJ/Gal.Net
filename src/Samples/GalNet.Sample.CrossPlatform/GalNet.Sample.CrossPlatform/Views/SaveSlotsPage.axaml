<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
             xmlns:controls="using:GalNet.Game.Controls"
             xmlns:local="using:GalNet.Avalonia.GameView.Page"
             xmlns:sharedvm="using:GalNet.Avalonia.GameView.ViewModels"
             xmlns:vm="using:GalNet.Sample.CrossPlatform.ViewModels"
             x:Class="GalNet.Sample.CrossPlatform.Views.SaveSlotsPage"
             x:DataType="vm:SaveSlotsPageViewModel"
             x:CompileBindings="True">
  <Grid Background="{DynamicResource GalNet.Brush.Background}">
    <Border x:Name="PageFrame" Classes="player-page-frame" BorderThickness="0" Background="Transparent">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" x:Name="PageHeader" MinHeight="{DynamicResource GalNet.Theme.PageHeaderMinHeight}" ColumnSpacing="{DynamicResource GalNet.Theme.PageHeaderSpacing}">
          <text:PlayerTextBlock Key="{Binding HeadingKey}" Fallback="{Binding Heading}" FontSize="{DynamicResource GalNet.Theme.HeadingSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="player-back" Content="{text:PlayerText Common.Back, 'Back'}" Command="{Binding BackCommand}" VerticalAlignment="Center" x:Name="PageBackButton" />
        </Grid>
        <Border Grid.Row="1" Height="1" Margin="{DynamicResource GalNet.Theme.RuleMargin}" Background="{DynamicResource GalNet.Brush.Divider}" />
        <Grid RowDefinitions="*,Auto" RowSpacing="18" Grid.Row="2" Margin="{DynamicResource GalNet.Theme.ContentMargin}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Classes="player-card-grid" ItemsSource="{Binding Slots}" VerticalAlignment="Top">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sharedvm:GameSaveSlotRowViewModel">
                  <controls:SaveSlotCard Margin="7" Preview="{Binding Preview}" SlotIndex="{Binding SlotIndex}" Timestamp="{Binding Timestamp}" Description="{Binding Description}" IsEmpty="{Binding IsEmpty}" IsCorrupt="{Binding IsCorrupt}" CanRename="{Binding CanRename}" RenameCommand="{Binding RenameCommand}" RenameError="{Binding RenameError}" Command="{Binding ActivateCommand}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Grid.Row="1" Text="{text:PlayerText SaveSlots.Hint, 'Saves are managed by the current game host.'}" Opacity="0.45" FontSize="{DynamicResource GalNet.Theme.AuxiliaryFontSize}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
