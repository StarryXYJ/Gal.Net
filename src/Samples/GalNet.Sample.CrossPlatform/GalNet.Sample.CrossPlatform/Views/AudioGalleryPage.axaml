<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ursa="https://irihi.tech/ursa"
             xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:common="using:GalNet.Avalonia.GameView.Controls"
             xmlns:sharedvm="using:GalNet.Avalonia.GameView.ViewModels"
             xmlns:vm="using:GalNet.Sample.CrossPlatform.ViewModels"
             x:Class="GalNet.Sample.CrossPlatform.Views.AudioGalleryPage"
             x:DataType="vm:AudioGalleryPageViewModel">
  <Grid Background="{DynamicResource GalNet.Brush.Background}">
    <Border x:Name="PageFrame" Classes="player-page-frame" BorderThickness="0" Background="Transparent">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto" x:Name="PageHeader" Classes="player-page-header">
          <TextBlock Text="{Binding State.Title}" Classes="player-page-title" />
          <Button Grid.Column="1" Classes="player-back" Content="{text:PlayerText Common.Back, 'Back'}" Command="{Binding BackCommand}" x:Name="PageBackButton" VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="1" Classes="player-page-rule" />
        <TextBlock Grid.Row="2" Text="{Binding State.ErrorMessage}" IsVisible="{Binding State.ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" Foreground="{DynamicResource GalNet.Brush.Error}" TextWrapping="Wrap" Margin="0,12,0,0" />
        <ScrollViewer Grid.Row="3" Margin="{DynamicResource GalNet.Theme.ContentMargin}" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="Items" ItemsSource="{Binding Pages.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sharedvm:GalleryEntryViewModel">
                <Border Margin="0,0,0,8" Padding="14" Background="{DynamicResource GalNet.Brush.Surface}" CornerRadius="{DynamicResource GalNet.Theme.CornerRadius}" BorderBrush="{DynamicResource GalNet.Brush.Border}" BorderThickness="1">
                  <common:AudioGalleryRow ToggleCommand="{Binding #Items.DataContext.State.ToggleAudioCommand}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <ursa:Pagination Grid.Row="4" HorizontalAlignment="Center" CurrentPage="{Binding Pages.CurrentPage, Mode=TwoWay}" TotalCount="{Binding Pages.TotalCount}" PageSize="{Binding Pages.PageSize}" IsVisible="{Binding Pages.HasMultiplePages}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
