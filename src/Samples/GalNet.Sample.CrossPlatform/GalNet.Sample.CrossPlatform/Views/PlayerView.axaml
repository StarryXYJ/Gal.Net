<views:PlayerSurface xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:GalNet.Game.Controls"
             xmlns:loc="clr-namespace:GalNet.Avalonia.GameView.MarkupExtensions;assembly=GalNet.Avalonia.GameView"
             xmlns:views="using:GalNet.Avalonia.GameHost.Views"
             xmlns:project="using:GalNet.Sample.CrossPlatform.Views"
             xmlns:ursa="https://irihi.tech/ursa"
             x:Class="GalNet.Sample.CrossPlatform.Views.PlayerView">
  <UserControl.Resources>
    <ControlTheme x:Key="MusicToastTheme" TargetType="ursa:ToastCard">
      <Setter Property="MinWidth" Value="280" />
      <Setter Property="MaxWidth" Value="360" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Foreground" Value="{DynamicResource GalNet.Brush.TextPrimary}" />
      <Setter Property="Background">
        <SolidColorBrush Color="{DynamicResource GalNet.Palette.SurfaceColor}" Opacity="0.84" />
      </Setter>
      <Setter Property="BorderBrush" Value="{DynamicResource GalNet.Brush.Border}" />
      <Setter Property="RenderTransform"><TranslateTransform /></Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="MusicToastSurface" Padding="20,12" Margin="8" CornerRadius="6"
                  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" BoxShadow="0 4 16 0 #20000000">
            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                       FontSize="14" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^[IsClosing=False]">
        <Style.Animations>
          <Animation Duration="0:0:0.8" Easing="CubicEaseOut" FillMode="Forward">
            <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="-320" /><Setter Property="Opacity" Value="0" /></KeyFrame>
            <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="Opacity" Value="1" /></KeyFrame>
          </Animation>
        </Style.Animations>
      </Style>
      <Style Selector="^[IsClosing=True]">
        <Style.Animations>
          <Animation Duration="0:0:0.8" Easing="CubicEaseIn" FillMode="Forward">
            <KeyFrame Cue="0%">
              <Setter Property="TranslateTransform.X" Value="0" />
              <Setter Property="Opacity" Value="1" />
              <Setter Property="IsClosed" Value="False" />
            </KeyFrame>
            <KeyFrame Cue="100%">
              <Setter Property="TranslateTransform.X" Value="-320" />
              <Setter Property="Opacity" Value="0" />
              <Setter Property="IsClosed" Value="True" />
            </KeyFrame>
          </Animation>
        </Style.Animations>
      </Style>
    </ControlTheme>
  </UserControl.Resources>
  <Grid x:Name="PlayerRoot" Classes="galnet-player" Background="{DynamicResource GalNet.Brush.Background}">
    <Grid x:Name="PlayerContent">
      <controls:GameCanvasHost x:Name="GameCanvas" IsVisible="False"
                               DesignWidth="1920"
                               DesignHeight="1080" />
      <project:LanguageSelectionView x:Name="LanguageSelection" IsVisible="False" />
      <TextBlock x:Name="StartupStatus" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{DynamicResource GalNet.Brush.TextPrimary}" Text="{loc:Localize Onboarding.Loading}" TextWrapping="Wrap" MaxWidth="600" />
    </Grid>
    <ursa:WindowToastManager x:Name="AudioToast" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="24,24,24,88" MaxItems="1" IsHitTestVisible="False">
      <ursa:WindowToastManager.Template>
        <ControlTemplate>
          <!-- Outgoing and incoming tracks share one anchor during replacement. -->
          <Grid x:Name="PART_Items" ClipToBounds="True" />
        </ControlTemplate>
      </ursa:WindowToastManager.Template>
      <ursa:WindowToastManager.Styles>
        <Style Selector="ursa|ToastCard"><Setter Property="Theme" Value="{StaticResource MusicToastTheme}" /></Style>
      </ursa:WindowToastManager.Styles>
    </ursa:WindowToastManager>
    <Grid x:Name="ExitConfirmation" IsVisible="False" Background="#66000000" KeyboardNavigation.TabNavigation="Cycle">
      <Border MaxWidth="360" Margin="24" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
              CornerRadius="6" Background="{DynamicResource GalNet.Brush.Surface}"
              BorderBrush="{DynamicResource GalNet.Brush.Border}" BorderThickness="1" BoxShadow="0 8 24 0 #26000000">
        <StackPanel Spacing="24">
          <StackPanel x:Name="ExitCopy" Spacing="8">
            <TextBlock Text="{loc:Localize Exit.Title}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Localize Exit.Message}" FontSize="14" LineHeight="22"
                       Foreground="{DynamicResource GalNet.Brush.TextSecondary}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel x:Name="ReturnToTitleCopy" Spacing="8" IsVisible="False">
            <TextBlock Text="{loc:Localize ReturnToTitle.Title}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Localize ReturnToTitle.Message}" FontSize="14" LineHeight="22"
                       Foreground="{DynamicResource GalNet.Brush.TextSecondary}" TextWrapping="Wrap" />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Right">
            <Button x:Name="CancelExitButton" Content="{loc:Localize Common.Cancel}"
                    FontSize="14" FontWeight="Normal" MinWidth="80" MinHeight="34" Padding="16,6" CornerRadius="4" HorizontalContentAlignment="Center" />
            <Button x:Name="ConfirmExitButton" Grid.Column="1" Classes="player-primary" Content="{loc:Localize Title.Exit}"
                    FontSize="14" FontWeight="Normal" MinWidth="80" MinHeight="34" Padding="16,6" CornerRadius="4" HorizontalContentAlignment="Center"
                    Background="{DynamicResource GalNet.Brush.Primary}" Foreground="{DynamicResource GalNet.Brush.OnPrimary}" BorderBrush="{DynamicResource GalNet.Brush.Primary}" />
            <Button x:Name="ConfirmReturnToTitleButton" Grid.Column="1" Classes="player-primary" IsVisible="False"
                    Content="{loc:Localize ReturnToTitle.Confirm}"
                    FontSize="14" FontWeight="Normal" MinWidth="80" MinHeight="34" Padding="16,6" CornerRadius="4" HorizontalContentAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
  <UserControl.Styles>
    <Style Selector="Button.player-primary">
      <Setter Property="Background" Value="{DynamicResource GalNet.Brush.Primary}" />
      <Setter Property="Foreground" Value="{DynamicResource GalNet.Brush.OnPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GalNet.Brush.Primary}" />
    </Style>
    <Style Selector="Button.player-primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource GalNet.Brush.PrimaryHover}" />
      <Setter Property="Foreground" Value="{DynamicResource GalNet.Brush.OnPrimary}" />
    </Style>
  </UserControl.Styles>
</views:PlayerSurface>
