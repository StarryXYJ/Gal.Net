<views:PlayerSurface xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:GalNet.Game.Controls"
             xmlns:loc="clr-namespace:GalNet.Avalonia.GameView.MarkupExtensions;assembly=GalNet.Avalonia.GameView"
             xmlns:views="using:GalNet.Avalonia.GameHost.Views"
             xmlns:project="using:GalNet.Sample.CrossPlatform.Views"
             xmlns:ursa="https://irihi.tech/ursa"
             x:Class="GalNet.Sample.CrossPlatform.Views.PlayerView">
  <UserControl.Resources>
    <ControlTheme x:Key="TextCardTheme.default" TargetType="ContentControl">
      <Setter Property="Foreground" Value="{DynamicResource GalNet.Brush.TextPrimary}" />
      <Setter Property="Template"><ControlTemplate>
        <Border Padding="20,12" Margin="8" CornerRadius="6" MinWidth="280" MaxWidth="560"
                BorderBrush="{DynamicResource GalNet.Brush.Border}" BorderThickness="1">
          <Border.Background><SolidColorBrush Color="{DynamicResource GalNet.Palette.SurfaceColor}" Opacity="0.84" /></Border.Background>
          <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap"
                     Foreground="{TemplateBinding Foreground}" FontSize="{DynamicResource GalNet.Theme.ModalFontSize}" />
        </Border>
      </ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="TextCardTheme.music" TargetType="ContentControl" BasedOn="{StaticResource TextCardTheme.default}" />
    <ControlTheme x:Key="TextCardTheme.location" TargetType="ContentControl" BasedOn="{StaticResource TextCardTheme.default}" />
    <ControlTheme x:Key="TextCardTheme.chapter" TargetType="ContentControl" BasedOn="{StaticResource TextCardTheme.default}">
      <Setter Property="Foreground" Value="{DynamicResource GalNet.Brush.Primary}" />
    </ControlTheme>
  </UserControl.Resources>
  <Grid x:Name="PlayerRoot" Classes="galnet-player" Background="{DynamicResource GalNet.Brush.Background}">
    <Grid x:Name="PlayerContent">
      <controls:GameCanvasHost x:Name="GameCanvas" IsVisible="False"
                               DesignWidth="1920"
                               DesignHeight="1080" />
      <project:LanguageSelectionView x:Name="LanguageSelection" IsVisible="False" />
      <TextBlock x:Name="StartupStatus" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{DynamicResource GalNet.Brush.TextPrimary}" IsVisible="False" TextWrapping="Wrap" MaxWidth="600" />
    </Grid>
    <Grid x:Name="ExitConfirmation" IsVisible="False" Background="#66000000" KeyboardNavigation.TabNavigation="Cycle">
      <Border MaxWidth="360" Margin="24" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
              CornerRadius="6" Background="{DynamicResource GalNet.Brush.Surface}"
              BorderBrush="{DynamicResource GalNet.Brush.Border}" BorderThickness="1" BoxShadow="0 8 24 0 #26000000">
        <StackPanel Spacing="24">
          <StackPanel x:Name="ExitCopy" Spacing="8">
            <TextBlock Text="{loc:Localize Exit.Title}" FontSize="{DynamicResource GalNet.Theme.ModalHeadingSize}" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Localize Exit.Message}" FontSize="{DynamicResource GalNet.Theme.ModalFontSize}" LineHeight="{DynamicResource GalNet.Theme.ModalLineHeight}"
                       Foreground="{DynamicResource GalNet.Brush.TextSecondary}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel x:Name="ReturnToTitleCopy" Spacing="8" IsVisible="False">
            <TextBlock Text="{loc:Localize ReturnToTitle.Title}" FontSize="{DynamicResource GalNet.Theme.ModalHeadingSize}" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Localize ReturnToTitle.Message}" FontSize="{DynamicResource GalNet.Theme.ModalFontSize}" LineHeight="{DynamicResource GalNet.Theme.ModalLineHeight}"
                       Foreground="{DynamicResource GalNet.Brush.TextSecondary}" TextWrapping="Wrap" />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Right">
            <Button x:Name="CancelExitButton" Content="{loc:Localize Common.Cancel}"
                    FontSize="{DynamicResource GalNet.Theme.ModalFontSize}" FontWeight="Normal" MinWidth="80" MinHeight="34" Padding="16,6" CornerRadius="4" HorizontalContentAlignment="Center" />
            <Button x:Name="ConfirmExitButton" Grid.Column="1" Classes="player-primary" Content="{loc:Localize Title.Exit}"
                    FontSize="{DynamicResource GalNet.Theme.ModalFontSize}" FontWeight="Normal" MinWidth="80" MinHeight="34" Padding="16,6" CornerRadius="4" HorizontalContentAlignment="Center"
                    Background="{DynamicResource GalNet.Brush.Primary}" Foreground="{DynamicResource GalNet.Brush.OnPrimary}" BorderBrush="{DynamicResource GalNet.Brush.Primary}" />
            <Button x:Name="ConfirmReturnToTitleButton" Grid.Column="1" Classes="player-primary" IsVisible="False"
                    Content="{loc:Localize ReturnToTitle.Confirm}"
                    FontSize="{DynamicResource GalNet.Theme.ModalFontSize}" FontWeight="Normal" MinWidth="80" MinHeight="34" Padding="16,6" CornerRadius="4" HorizontalContentAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
  <UserControl.Styles>
    <Style Selector="Button.player-primary">
      <Setter Property="Background" Value="{DynamicResource GalNet.Brush.Primary}" />
      <Setter Property="Foreground" Value="{DynamicResource GalNet.Brush.OnPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GalNet.Brush.Primary}" />
    </Style>
    <Style Selector="Button.player-primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource GalNet.Brush.PrimaryHover}" />
      <Setter Property="Foreground" Value="{DynamicResource GalNet.Brush.OnPrimary}" />
    </Style>
  </UserControl.Styles>
</views:PlayerSurface>
