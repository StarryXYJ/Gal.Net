<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:GalNet.Avalonia.GameView.Presentation" xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
 x:Class="GalNet.Sample.CrossPlatform.Views.VideoGalleryControls" x:DataType="vm:GalleryVideoState">
 <Grid x:Name="ControlsGrid" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" RowSpacing="4" MinHeight="44">
  <Grid>
   <Button x:Name="PlayButton" IsVisible="{Binding !IsPlaying}" IsEnabled="{Binding HasVideo}" Command="{Binding TogglePlaybackCommand}" AutomationProperties.Name="{text:PlayerText Gallery.Play, 'Play'}" ToolTip.Tip="{text:PlayerText Gallery.Play, 'Play'}"><PathIcon Width="16" Height="16" Data="M 4,2 L 14,8 L 4,14 Z" /></Button>
   <Button x:Name="PauseButton" IsVisible="{Binding IsPlaying}" Command="{Binding TogglePlaybackCommand}" AutomationProperties.Name="{text:PlayerText Gallery.Pause, 'Pause'}" ToolTip.Tip="{text:PlayerText Gallery.Pause, 'Pause'}"><PathIcon Width="16" Height="16" Data="M 3,2 L 6,2 L 6,14 L 3,14 Z M 10,2 L 13,2 L 13,14 L 10,14 Z" /></Button>
  </Grid>
  <Slider x:Name="Seek" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=TwoWay}" IsEnabled="{Binding CanSeek}" VerticalAlignment="Center" ToolTip.Tip="{Binding TimeText}" AutomationProperties.Name="{text:PlayerText Gallery.Seek, 'Playback position'}" />
  <TextBlock x:Name="TimeLabel" Grid.Column="2" Text="{Binding TimeText}" VerticalAlignment="Center" FontSize="{DynamicResource GalNet.Theme.AuxiliaryFontSize}" />
 </Grid>
</UserControl>
