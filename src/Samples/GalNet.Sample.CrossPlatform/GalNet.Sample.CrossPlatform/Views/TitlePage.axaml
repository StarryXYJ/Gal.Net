<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GalNet.Sample.CrossPlatform.ViewModels"
    xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
    x:Class="GalNet.Sample.CrossPlatform.Views.TitlePage"
    x:DataType="vm:TitlePageViewModel">
  <Grid Background="{DynamicResource GalNet.Brush.Background}" ClipToBounds="True">
    <Viewbox Stretch="UniformToFill" IsHitTestVisible="False">
    <Grid Width="1920" Height="1080" Opacity="0.3">
      <Ellipse Width="1000" Height="1000" Fill="{DynamicResource GalNet.Brush.Primary}" HorizontalAlignment="Right" Margin="0,0,-240,-480" VerticalAlignment="Bottom"/>
      <Ellipse Width="640" Height="640" Stroke="{DynamicResource GalNet.Brush.Primary}" StrokeThickness="2" HorizontalAlignment="Right" Margin="0,0,80,-200" VerticalAlignment="Bottom"/>
    </Grid>
    </Viewbox>
    <Grid x:Name="TitleLayout" Margin="64,48" MaxWidth="1600" ColumnDefinitions="380,*" RowDefinitions="Auto,*">
      <StackPanel Grid.ColumnSpan="2" Spacing="12">
        <TextBlock x:Name="GameTitleText" Text="{Binding GameTitle}" ToolTip.Tip="{Binding GameTitle}" Foreground="{DynamicResource GalNet.Brush.TextPrimary}" FontSize="{DynamicResource GalNet.Theme.TitleSize}" FontWeight="Bold" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/>
        <ProgressBar x:Name="TitleProgress" IsIndeterminate="True" IsVisible="{Binding !IsReady}" Width="120" Height="2" HorizontalAlignment="Left" />
      </StackPanel>
      <ScrollViewer x:Name="TitleMenu" Grid.Row="1" VerticalAlignment="Bottom" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" Margin="0,32,0,0">
        <StackPanel x:Name="TitleButtons" Spacing="10" VerticalAlignment="Top">
          <Button x:Name="NewGameButton" Classes="player-menu" Content="{text:PlayerText Title.NewGame, 'New Game'}" Command="{Binding StartNewGameCommand}" IsEnabled="{Binding CanStartNewGame}"/>
          <Button Classes="player-menu" Content="{text:PlayerText Title.Continue, Continue}" Command="{Binding ContinueCommand}" IsEnabled="{Binding CanContinueGame}" IsVisible="{Binding CanContinue}"/>
          <Button Classes="player-menu" Content="{text:PlayerText Title.Load, Load}" Command="{Binding OpenLoadSlotsCommand}" IsEnabled="{Binding IsNavigationEnabled}"/>
          <Button Classes="player-menu" Content="{text:PlayerText Settings.Title, Settings}" Command="{Binding OpenSettingsCommand}" IsEnabled="{Binding IsNavigationEnabled}"/>
          <Button Classes="player-menu" Content="{text:PlayerText Title.Gallery, Gallery}" Command="{Binding OpenGalleryCommand}" IsEnabled="{Binding CanOpenGallery}" IsVisible="{Binding HasGallery}"/>
          <Button Classes="player-menu" Content="{text:PlayerText Title.About, About}" Command="{Binding OpenAboutCommand}"/>
          <Button Classes="player-menu" Content="{text:PlayerText Title.Exit, Exit}" Command="{Binding ExitCommand}" IsVisible="{Binding CanExit}"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
