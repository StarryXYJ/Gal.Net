<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GalNet.Avalonia.GameView.Page"
             xmlns:sharedvm="using:GalNet.Avalonia.GameView.ViewModels"
             xmlns:vm="using:GalNet.Sample.CrossPlatform.ViewModels"
             xmlns:common="using:GalNet.Avalonia.GameView.Controls"
             xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
             x:Class="GalNet.Sample.CrossPlatform.Views.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">
  <Grid Background="{DynamicResource GalNet.Brush.Background}">
    <Border x:Name="PageFrame" Classes="player-page-frame" MaxWidth="800" BorderThickness="0" Background="Transparent">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" x:Name="PageHeader" Classes="player-page-header">
          <TextBlock Text="{text:PlayerText Settings.Title, Settings}" Classes="player-page-title" />
          <Button Grid.Column="1" Classes="player-back" Content="{text:PlayerText Common.Back, Back}" Command="{Binding BackCommand}" VerticalAlignment="Center" x:Name="PageBackButton" />
        </Grid>
        <Border Grid.Row="1" Classes="player-page-rule" />
        <Grid Grid.Row="2" Margin="{DynamicResource GalNet.Theme.ContentMargin}" RowDefinitions="*,Auto" RowSpacing="16" HorizontalAlignment="Stretch">
          <common:SettingsCategories Categories="{Binding Categories}" Editors="{Binding Editors}" HorizontalAlignment="Stretch" />
          <TextBlock Grid.Row="1" Text="{text:PlayerText Settings.Hint, 'Changes apply immediately.'}" TextWrapping="Wrap" FontSize="{DynamicResource GalNet.Theme.AuxiliaryFontSize}" Foreground="{DynamicResource GalNet.Brush.TextSecondary}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
