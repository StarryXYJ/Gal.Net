<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GalNet.Sample.CrossPlatform.ViewModels"
    x:Class="GalNet.Sample.CrossPlatform.Views.LoadingPage"
    x:DataType="vm:LoadingPageViewModel">
  <Grid Background="{DynamicResource GalNet.Brush.Background}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <TextBlock Margin="16" Text="{Binding Message}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{DynamicResource GalNet.Brush.TextSecondary}" FontSize="16"/>
  </Grid>
</UserControl>
