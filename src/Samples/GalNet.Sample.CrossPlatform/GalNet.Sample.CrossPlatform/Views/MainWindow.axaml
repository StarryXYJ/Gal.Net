<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="GalNet.Sample.CrossPlatform.Views.MainWindow"
        WindowDecorations="None"
        Icon="/Assets/avalonia-logo.ico"
        Width="1280" Height="720" MinWidth="800" MinHeight="500"
        Classes="galnet-player"
        Background="{DynamicResource GalNet.Brush.Background}"
        Foreground="{DynamicResource GalNet.Brush.TextPrimary}"
        Title="GalNet Avalonia CrossPlatform Player">
</Window>
