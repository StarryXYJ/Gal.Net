<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
             xmlns:sharedvm="using:GalNet.Avalonia.GameView.ViewModels"
             xmlns:vm="using:GalNet.Sample.CrossPlatform.ViewModels"
             x:Class="GalNet.Sample.CrossPlatform.Views.MissingGalleryPage"
             x:DataType="vm:MissingGalleryPageViewModel">
  <Grid Background="{DynamicResource GalNet.Brush.Background}">
    <Border x:Name="PageFrame" Classes="player-page-frame" BorderThickness="0" Background="Transparent">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" x:Name="PageHeader" Classes="player-page-header">
          <TextBlock Text="{text:PlayerText Gallery.Unavailable, 'Gallery page unavailable'}" Classes="player-page-title" />
          <Button Grid.Column="1" Classes="player-back" Content="{text:PlayerText Common.Back, 'Back'}" Command="{Binding BackCommand}" x:Name="PageBackButton" VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="1" Classes="player-page-rule" />
        <Border Grid.Row="2" Margin="{DynamicResource GalNet.Theme.ContentMargin}" Padding="28" Background="{DynamicResource GalNet.Brush.Surface}" BorderBrush="{DynamicResource GalNet.Brush.Border}" BorderThickness="0" CornerRadius="{DynamicResource GalNet.Theme.CornerRadius}">
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
