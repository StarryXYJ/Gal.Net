<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseMonoRuntime Condition="'$(UseMonoRuntime)' == ''">true</UseMonoRuntime>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
    <PackageReference Include="SDL3-CS.Windows" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="SDL3-CS.Linux" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="SDL3-CS.MacOS" ExcludeAssets="all" PrivateAssets="all" />
    <BundleResource Include="$(GalNetGamePackage)" LogicalName="game.galpak" Condition="'$(GalNetGamePackage)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GalNet.Sample.CrossPlatform\GalNet.Sample.CrossPlatform.csproj" />
  </ItemGroup>
</Project>
