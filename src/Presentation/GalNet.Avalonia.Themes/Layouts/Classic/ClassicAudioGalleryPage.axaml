<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:common="using:GalNet.Avalonia.Themes.Common"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             x:Class="GalNet.Avalonia.Themes.Layouts.Classic.ClassicAudioGalleryPage"
             x:DataType="vm:AudioGalleryPageViewModel">
  <Grid Background="{DynamicResource GalNet.Brush.Background}">
    <Border x:Name="PageFrame" Classes="player-page-frame" BorderThickness="0" Background="Transparent">
      <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" x:Name="PageHeader" MinHeight="{DynamicResource GalNet.Theme.PageHeaderMinHeight}" ColumnSpacing="24">
          <TextBlock Text="{Binding Title}" FontSize="{DynamicResource GalNet.Theme.HeadingSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="player-back" Content="{text:PlayerText Common.Back, 'Back'}" Command="{Binding BackCommand}" x:Name="PageBackButton" VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="1" Margin="0,20,0,0" Height="1" Background="{DynamicResource GalNet.Brush.Divider}" />
        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" Foreground="{DynamicResource GalNet.Brush.Error}" TextWrapping="Wrap" Margin="0,12,0,0" />
        <ScrollViewer Grid.Row="3" Margin="0,24,0,0" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="Items" ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GalleryEntryViewModel">
                <Border Margin="0,0,0,8" Padding="14" Background="{DynamicResource GalNet.Brush.Surface}" CornerRadius="{DynamicResource GalNet.Theme.CornerRadius}" BorderBrush="{DynamicResource GalNet.Brush.Border}" BorderThickness="1">
                  <common:AudioGalleryRow ToggleCommand="{Binding #Items.DataContext.ToggleAudioCommand}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
