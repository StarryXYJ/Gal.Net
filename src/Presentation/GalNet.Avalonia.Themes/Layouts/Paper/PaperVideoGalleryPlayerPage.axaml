<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             xmlns:scene="using:GalNet.Rendering.Scene"
             x:Class="GalNet.Avalonia.Themes.Layouts.Paper.PaperVideoGalleryPlayerPage"
             x:DataType="vm:VideoGalleryPlayerPageViewModel">
  <Grid Background="{DynamicResource GalNet.Brush.Background}">
    <Border x:Name="PageFrame" Classes="player-page-frame" BorderThickness="0" Background="Transparent">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="140,*,140" x:Name="PageHeader" MinHeight="{DynamicResource GalNet.Theme.PageHeaderMinHeight}" ColumnSpacing="24">
          <TextBlock Text="{Binding Title}" FontSize="{DynamicResource GalNet.Theme.HeadingSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Grid.Column="1" HorizontalAlignment="Center" />
          <Button Grid.Column="0" Classes="player-back" Content="{text:PlayerText Common.Back, 'Back'}" Command="{Binding BackCommand}" x:Name="PageBackButton" VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="1" Margin="0,20,0,0" Height="1" Background="{DynamicResource GalNet.Brush.Divider}" />
        <Border Classes="player-media-stage" Grid.Row="2" Margin="0,32,0,0">
          <Grid>
            <scene:SceneLayerHost ItemsSource="{Binding VideoLayers}" ClipToBounds="True" x:Name="PageMedia" />
            <TextBlock Margin="32" Text="{Binding ErrorMessage}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource GalNet.Brush.Warning}" />
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>