<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
             xmlns:local="using:GalNet.Avalonia.GameView.Page"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             x:Class="GalNet.Avalonia.Themes.Layouts.Paper.PaperAboutPage"
             x:DataType="vm:AboutPageViewModel">
  <Grid Background="{DynamicResource GalNet.Brush.Background}">
    <Border x:Name="PageFrame" Classes="player-page-frame" BorderThickness="0" Background="Transparent">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="140,*,140" x:Name="PageHeader" MinHeight="{DynamicResource GalNet.Theme.PageHeaderMinHeight}" ColumnSpacing="24">
          <TextBlock Text="{text:PlayerText Title.About, 'About'}" FontSize="{DynamicResource GalNet.Theme.HeadingSize}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Grid.Column="1" HorizontalAlignment="Center" />
          <Button Grid.Column="0" Classes="player-back" Content="{text:PlayerText Common.Back, 'Back'}" Command="{Binding BackCommand}" VerticalAlignment="Center" x:Name="PageBackButton" />
        </Grid>
        <Border Grid.Row="1" Height="1" Margin="0,20,0,0" Background="{DynamicResource GalNet.Brush.Divider}" />
        <ScrollViewer Grid.Row="2" Margin="0,32,0,0">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding GameTitle}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{text:PlayerText About.Description, 'This default player shell is fully replaceable by a game client without changing its runtime or game data.'}" TextWrapping="Wrap" Opacity="0.72" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>