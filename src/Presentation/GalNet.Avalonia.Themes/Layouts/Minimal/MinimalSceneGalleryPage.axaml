<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             x:Class="GalNet.Avalonia.Themes.Layouts.Minimal.MinimalSceneGalleryPage"
             x:DataType="vm:GalleryVisualPageViewModelBase">
  <Grid Background="{DynamicResource GalNet.Brush.Background}">
    <Border x:Name="PageFrame" Classes="player-page-frame" BorderThickness="0" Background="Transparent">
      <Grid ColumnDefinitions="200,*" ColumnSpacing="36">
        <Grid x:Name="PageHeader" RowDefinitions="Auto,*,Auto">
          <TextBlock Text="{Binding Title}" FontSize="{DynamicResource GalNet.Theme.HeadingSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <Button Classes="player-back" Content="{text:PlayerText Common.Back, 'Back'}" Command="{Binding BackCommand}" x:Name="PageBackButton" VerticalAlignment="Bottom" Grid.Row="2" HorizontalAlignment="Stretch" />
        </Grid>
        <ScrollViewer Margin="0" HorizontalScrollBarVisibility="Disabled" Grid.Column="1">
          <ItemsControl x:Name="Items" ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemWidth="260" ItemHeight="190" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GalleryEntryViewModel">
                <Grid Margin="6" RowDefinitions="*,Auto" ClipToBounds="True">
                  <Button Grid.RowSpan="2" Margin="0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ClipToBounds="True" IsEnabled="{Binding IsUnlocked}" Command="{Binding #Items.DataContext.OpenItemCommand}" CommandParameter="{Binding}" ToolTip.Tip="{Binding NameTooltip}">
                    <Grid ClipToBounds="True" RowDefinitions="*" Background="{DynamicResource GalNet.Brush.Surface}">
                      <PathIcon Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" IsVisible="{Binding !HasThumbnail}" Data="M 4,2 L 14,8 L 4,14 Z" />
                      <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding IsUnlocked}" />
                      <Border Background="{DynamicResource GalNet.Brush.SurfaceRaised}" IsVisible="{Binding IsLocked}">
                        <TextBlock Text="{text:PlayerText Gallery.Locked, 'Locked'}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Opacity="0.7" />
                      </Border>

                    </Grid>
                  </Button>
                  <Border Grid.Row="1" Background="{DynamicResource GalNet.Brush.Overlay}" Padding="10,7" IsHitTestVisible="False">
                    <TextBlock x:Name="CardTitle" Text="{Binding Title}" TextAlignment="Center" Foreground="{DynamicResource GalNet.Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
