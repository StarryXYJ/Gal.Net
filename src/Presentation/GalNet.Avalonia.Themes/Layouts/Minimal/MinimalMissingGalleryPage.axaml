<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             x:Class="GalNet.Avalonia.Themes.Layouts.Minimal.MinimalMissingGalleryPage"
             x:DataType="vm:MissingGalleryPageViewModel">
  <Grid Background="{DynamicResource GalNet.Brush.Background}">
    <Border x:Name="PageFrame" Classes="player-page-frame" BorderThickness="0" Background="Transparent">
      <Grid ColumnDefinitions="200,*" ColumnSpacing="36">
        <Grid x:Name="PageHeader" RowDefinitions="Auto,*,Auto">
          <TextBlock Text="{text:PlayerText Gallery.Unavailable, 'Gallery page unavailable'}" FontSize="{DynamicResource GalNet.Theme.HeadingSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <Button Classes="player-back" Content="{text:PlayerText Common.Back, 'Back'}" Command="{Binding BackCommand}" x:Name="PageBackButton" VerticalAlignment="Bottom" Grid.Row="2" HorizontalAlignment="Stretch" />
        </Grid>
        <Border Margin="0" Padding="28" Background="{DynamicResource GalNet.Brush.Surface}" BorderBrush="{DynamicResource GalNet.Brush.Border}" BorderThickness="0" CornerRadius="{DynamicResource GalNet.Theme.CornerRadius}" Grid.Column="1">
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>