<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:page="using:GalNet.Avalonia.GameView.Page" xmlns:common="using:GalNet.Avalonia.Themes.Common"
                    xmlns:controls="using:GalNet.Game.Controls">
  <CornerRadius x:Key="GalNet.Theme.CornerRadius">2</CornerRadius>
  <Thickness x:Key="GalNet.Theme.PageMargin">32</Thickness>
  <Thickness x:Key="GalNet.Theme.PanelPadding">28</Thickness>
  <x:Double x:Key="GalNet.Theme.PanelWidth">760</x:Double>
  <x:Double x:Key="GalNet.Theme.HeadingSize">28</x:Double>
  <x:Double x:Key="GalNet.Theme.TitleSize">48</x:Double>
  <x:Double x:Key="GalNet.Theme.DialogueHeight">160</x:Double>
  <x:Double x:Key="GalNet.Theme.DialogueFontSize">20</x:Double>
  <x:Double x:Key="GalNet.Theme.SpeakerFontSize">24</x:Double>
  <Thickness x:Key="GalNet.Theme.DialoguePadding">24</Thickness>
  <Thickness x:Key="GalNet.Theme.ChoicePadding">20,12</Thickness>
  <Thickness x:Key="GalNet.Theme.ChoiceMargin">0,3</Thickness>
  <x:Int32 x:Key="GalNet.Theme.SaveColumns">3</x:Int32>
  <ControlTheme x:Key="{x:Type controls:DialoguePresenter}" TargetType="controls:DialoguePresenter">
    <Setter Property="Template">
      <ControlTemplate>
        <Border MinHeight="{DynamicResource GalNet.Theme.DialogueHeight}" Padding="{DynamicResource GalNet.Theme.DialoguePadding}"
                Background="{DynamicResource GalNet.Brush.Overlay}" BorderBrush="{DynamicResource GalNet.Brush.Primary}" BorderThickness="3,0,0,0">
          <StackPanel Spacing="14">
            <Border HorizontalAlignment="Left" Background="{DynamicResource GalNet.Brush.Primary}" Padding="10,3">
              <TextBlock Text="{TemplateBinding Speaker}" Foreground="{DynamicResource GalNet.Brush.OnPrimary}" FontSize="{DynamicResource GalNet.Theme.SpeakerFontSize}" />
            </Border>
            <controls:TypewriterTextBlock Name="PART_Typewriter" SourceText="{TemplateBinding Text}"
                                         CharactersPerSecond="{TemplateBinding CharactersPerSecond}"
                                         Foreground="{DynamicResource GalNet.Brush.TextPrimary}" FontSize="{DynamicResource GalNet.Theme.DialogueFontSize}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type page:GamePage}" TargetType="page:GamePage">
    <Setter Property="Background" Value="{DynamicResource GalNet.Brush.Background}" />
    <Setter Property="Template">
      <ControlTemplate>
            <Grid Background="{TemplateBinding Background}">
              <ContentPresenter Name="PART_Scene" Content="{TemplateBinding Scene}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
              <common:GameToolbar HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24" ZIndex="40" />
              <ContentPresenter Name="PART_Nvl" Content="{TemplateBinding Nvl}" Width="780" MaxHeight="580" HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="12" />
              <ContentPresenter Name="PART_Dialogue" Content="{TemplateBinding Dialogue}" Width="620" Margin="32" HorizontalAlignment="Right" VerticalAlignment="Bottom" HorizontalContentAlignment="Stretch" ZIndex="13" />
              <ContentPresenter Name="PART_Choice" Content="{TemplateBinding Choice}" Width="520" Margin="32" HorizontalAlignment="Left" VerticalAlignment="Center" ZIndex="50" />
            </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
