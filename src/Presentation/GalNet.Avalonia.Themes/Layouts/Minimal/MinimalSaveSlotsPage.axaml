<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
             xmlns:controls="using:GalNet.Game.Controls"
             xmlns:local="using:GalNet.Avalonia.GameView.Page"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             x:Class="GalNet.Avalonia.Themes.Layouts.Minimal.MinimalSaveSlotsPage"
             x:DataType="vm:SaveSlotsPageViewModel"
             x:CompileBindings="True">
  <Grid Background="{DynamicResource GalNet.Brush.Background}">
    <Border x:Name="PageFrame" Classes="player-page-frame" BorderThickness="0" Background="Transparent">
      <Grid ColumnDefinitions="200,*" ColumnSpacing="36">
        <Grid x:Name="PageHeader" RowDefinitions="Auto,*,Auto">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource GalNet.Theme.HeadingSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Text="{text:PlayerText SaveSlots.Choose, 'Choose a slot'}" Opacity="0.64" />
          </StackPanel>
          <Button Classes="player-back" Content="{text:PlayerText Common.Back, 'Back'}" Command="{Binding BackCommand}" VerticalAlignment="Bottom" x:Name="PageBackButton" Grid.Row="2" HorizontalAlignment="Stretch" />
        </Grid>
        <Grid RowDefinitions="*,Auto" RowSpacing="18" Margin="0" Grid.Column="1">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Slots}" VerticalAlignment="Top">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="{DynamicResource GalNet.Theme.SaveColumns}" ColumnSpacing="6" RowSpacing="8" VerticalAlignment="Top" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GameSaveSlotRowViewModel">
                  <Panel Margin="7">
                    <controls:SaveSlotCard SlotIndex="{Binding SlotIndex}" Timestamp="{Binding Timestamp}" Description="{Binding Description}" IsEmpty="{Binding IsEmpty}" IsCorrupt="{Binding IsCorrupt}" Command="{Binding LoadCommand}" IsVisible="{Binding !IsSaveMode}" />
                    <controls:SaveSlotCard SlotIndex="{Binding SlotIndex}" Timestamp="{Binding Timestamp}" Description="{Binding Description}" IsEmpty="{Binding IsEmpty}" IsCorrupt="{Binding IsCorrupt}" Command="{Binding SaveCommand}" IsVisible="{Binding IsSaveMode}" />
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Grid.Row="1" Text="{text:PlayerText SaveSlots.Hint, 'Saves are managed by the current game host.'}" Opacity="0.45" FontSize="12" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>