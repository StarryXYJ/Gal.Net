<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GalNet.Avalonia.GameView.Page"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             xmlns:common="using:GalNet.Avalonia.Themes.Common"
             xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
             x:Class="GalNet.Avalonia.Themes.Layouts.Minimal.MinimalSettingsPage"
             x:DataType="vm:SettingsPageViewModel">
  <Grid Background="{DynamicResource GalNet.Brush.Background}">
    <Border x:Name="PageFrame" Classes="player-page-frame" BorderThickness="0" Background="Transparent">
      <Grid ColumnDefinitions="200,*" ColumnSpacing="36">
        <Grid x:Name="PageHeader" RowDefinitions="Auto,*,Auto">
          <StackPanel Spacing="3">
            <TextBlock Text="{text:PlayerText Settings.Title, Settings}" FontSize="{DynamicResource GalNet.Theme.HeadingSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Text="{text:PlayerText Settings.Description, 'Playback preferences'}" Opacity="0.64" />
          </StackPanel>
          <Button Classes="player-back" Content="{text:PlayerText Common.Back, Back}" Command="{Binding BackCommand}" VerticalAlignment="Bottom" x:Name="PageBackButton" Grid.Row="2" HorizontalAlignment="Stretch" />
        </Grid>
        <ScrollViewer Margin="0" HorizontalScrollBarVisibility="Disabled" Grid.Column="1">
          <Border Classes="player-settings-card" Background="Transparent" Padding="0">
            <StackPanel Spacing="28">
              <common:SettingsCategories Categories="{Binding Categories}" />
              <TextBlock Text="{text:PlayerText Settings.Hint, 'Changes apply immediately.'}" FontSize="12" Foreground="{DynamicResource GalNet.Brush.TextSecondary}" />
            </StackPanel>
          </Border>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
