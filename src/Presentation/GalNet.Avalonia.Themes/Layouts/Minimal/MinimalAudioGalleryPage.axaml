<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             x:Class="GalNet.Avalonia.Themes.Layouts.Minimal.MinimalAudioGalleryPage"
             x:DataType="vm:AudioGalleryPageViewModel">
  <Grid Background="{DynamicResource GalNet.Brush.Background}">
    <Border x:Name="PageFrame" Classes="player-page-frame" BorderThickness="0" Background="Transparent">
      <Grid ColumnDefinitions="200,*" ColumnSpacing="36">
        <Grid x:Name="PageHeader" RowDefinitions="Auto,*,Auto">
          <TextBlock Text="{Binding Title}" FontSize="{DynamicResource GalNet.Theme.HeadingSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <Button Classes="player-back" Content="{text:PlayerText Common.Back, 'Back'}" Command="{Binding BackCommand}" x:Name="PageBackButton" VerticalAlignment="Bottom" Grid.Row="2" HorizontalAlignment="Stretch" />
        </Grid>
        <ScrollViewer Margin="0" HorizontalScrollBarVisibility="Disabled" Grid.Column="1">
          <ItemsControl x:Name="Items" ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GalleryEntryViewModel">
                <Border Margin="0,0,0,8" Padding="14" Background="{DynamicResource GalNet.Brush.Surface}" CornerRadius="{DynamicResource GalNet.Theme.CornerRadius}" BorderBrush="{DynamicResource GalNet.Brush.Border}" BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding Title}" FontSize="17" />
                    <TextBlock Grid.Column="1" Text="{text:PlayerText Gallery.Locked, 'Locked'}" IsVisible="{Binding IsLocked}" Opacity="0.7" />
                    <ProgressBar Grid.Row="1" Margin="0,10,12,0" Minimum="0" Maximum="100" Value="{Binding Progress}" Height="5" IsVisible="{Binding IsUnlocked}" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsUnlocked}">
                      <TextBlock Text="{Binding TimeText}" Opacity="0.65" />
                      <Button Content="{text:PlayerText Gallery.PlayPause, 'Play / Pause'}" Command="{Binding #Items.DataContext.ToggleAudioCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>