<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             xmlns:shared="using:GalNet.Avalonia.Themes.Base"
             x:Class="GalNet.Avalonia.Themes.Layouts.Minimal.MinimalTitlePage"
             x:DataType="vm:TitlePageViewModel">
  <Grid Background="{DynamicResource GalNet.Brush.Background}">
   <Grid Margin="64" ColumnDefinitions="*,380" ColumnSpacing="64">
    <StackPanel VerticalAlignment="Center" Spacing="24">
      <Border Width="56" Height="4" Background="{DynamicResource GalNet.Brush.Primary}" HorizontalAlignment="Left" />
      <TextBlock Text="{Binding GameTitle}" FontSize="{DynamicResource GalNet.Theme.TitleSize}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource GalNet.Brush.TextSecondary}" TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Column="1" BorderBrush="{DynamicResource GalNet.Brush.Divider}" BorderThickness="1,0,0,0" Padding="32,0,0,0">
      <ScrollViewer VerticalAlignment="Center" HorizontalScrollBarVisibility="Disabled">
        <shared:TitleMenu />
      </ScrollViewer>
    </Border>
   </Grid>
  </Grid>
</UserControl>
