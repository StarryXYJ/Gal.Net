<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels" xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
 x:Class="GalNet.Avalonia.Themes.Common.SceneGalleryPlayerPage" x:DataType="vm:SceneGalleryPlayerPageViewModel">
 <UserControl.KeyBindings>
  <KeyBinding Gesture="Space" Command="{Binding Gameplay.AdvanceCommand}" />
  <KeyBinding Gesture="Enter" Command="{Binding Gameplay.AdvanceCommand}" />
 </UserControl.KeyBindings>
 <Grid Background="{DynamicResource GalNet.Brush.Background}">
  <ContentControl Content="{Binding Surface}" />
  <Button Content="{text:PlayerText Common.Back, 'Back'}" Command="{Binding BackCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24" />
  <TextBlock Text="{Binding ErrorMessage}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="600" />
 </Grid>
</UserControl>