<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:forms="using:GalNet.Game.Controls.Forms" xmlns:settings="using:GalNet.Avalonia.GameView.Settings"
             xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
             xmlns:common="using:GalNet.Avalonia.Themes.Common"
             x:Class="GalNet.Avalonia.Themes.Common.SettingsCategories" x:CompileBindings="False">
  <TabControl x:Name="CategoryTabs" ItemsSource="{Binding VisibleCategories, RelativeSource={RelativeSource AncestorType=UserControl}}">
    <TabControl.ItemTemplate>
      <DataTemplate DataType="settings:SettingCategory"><ContentControl Content="{Binding Label}" /></DataTemplate>
    </TabControl.ItemTemplate>
    <TabControl.ContentTemplate>
      <DataTemplate DataType="settings:SettingCategory">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Items}" Margin="0,20,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="settings:SettingItem">
                <Grid ColumnDefinitions="180,*" ColumnSpacing="22" Margin="0,0,0,24" IsVisible="{Binding IsVisible}">
                  <StackPanel Spacing="4">
                    <ContentControl Content="{Binding Label}" />
                    <text:PlayerTextBlock Key="{Binding DescriptionKey}" TextWrapping="Wrap" Opacity="0.64" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <ToolTip.Tip><text:PlayerTextBlock Key="{Binding Availability.ReasonKey}" /></ToolTip.Tip>
                    <ContentControl Content="{Binding}" IsEnabled="{Binding IsEnabled}">
                      <ContentControl.DataTemplates>
                        <DataTemplate DataType="settings:ActionSetting"><Button Content="{Binding Label}" Command="{Binding ExecuteCommand}" /></DataTemplate>
                        <DataTemplate DataType="settings:ICustomSetting"><settings:CustomSettingEditor /></DataTemplate>
                        <DataTemplate DataType="settings:SettingItem">
                          <forms:SchemaForm Schema="{Binding Fields}" Binding="{Binding FieldBinding}"
                                            Registry="{Binding Editors, RelativeSource={RelativeSource AncestorType=common:SettingsCategories}}">
                            <forms:SchemaForm.Template>
                              <ControlTemplate>
                                <StackPanel>
                                  <ItemsControl ItemsSource="{TemplateBinding Editors}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <StackPanel Spacing="4">
                                          <ContentControl Content="{Binding Control}" />
                                          <text:PlayerTextBlock Key="{Binding Context.Field.Editor.UnitKey}" Opacity="0.64" />
                                          <TextBlock Text="{Binding Context.Issue.Message}" TextWrapping="Wrap" />
                                        </StackPanel>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                  <ItemsControl ItemsSource="{TemplateBinding Diagnostics}">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Message}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </ControlTemplate>
                            </forms:SchemaForm.Template>
                          </forms:SchemaForm>
                        </DataTemplate>
                      </ContentControl.DataTemplates>
                    </ContentControl>
                    <text:PlayerTextBlock Key="{Binding Availability.ReasonKey}" TextWrapping="Wrap" Opacity="0.64" />
                    <text:PlayerTextBlock Key="{Binding ErrorKey}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DataTemplate>
    </TabControl.ContentTemplate>
  </TabControl>
</UserControl>
