<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:GalNet.Avalonia.GameView.Settings"
             xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
             xmlns:common="using:GalNet.Avalonia.Themes.Common"
             x:Class="GalNet.Avalonia.Themes.Common.SettingsCategories" x:CompileBindings="False">
  <TabControl x:Name="CategoryTabs" ItemsSource="{Binding VisibleCategories, RelativeSource={RelativeSource AncestorType=UserControl}}">
    <TabControl.ItemTemplate>
      <DataTemplate DataType="settings:SettingCategory"><ContentControl Content="{Binding Label}" /></DataTemplate>
    </TabControl.ItemTemplate>
    <TabControl.ContentTemplate>
      <DataTemplate DataType="settings:SettingCategory">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Items}" Margin="0,20,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="settings:SettingItem">
                <Grid ColumnDefinitions="180,*" ColumnSpacing="22" Margin="0,0,0,24" IsVisible="{Binding IsVisible}">
                  <StackPanel Spacing="4">
                    <ContentControl Content="{Binding Label}" />
                    <text:PlayerTextBlock Key="{Binding DescriptionKey}" TextWrapping="Wrap" Opacity="0.64" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <ToolTip.Tip><text:PlayerTextBlock Key="{Binding Availability.ReasonKey}" /></ToolTip.Tip>
                    <common:SettingEditor Content="{Binding}" IsEnabled="{Binding IsEnabled}"
                                          EditorTemplates="{Binding EditorTemplates, RelativeSource={RelativeSource AncestorType=common:SettingsCategories}}">
                      <common:SettingEditor.DataTemplates>
                        <DataTemplate DataType="settings:INumericSetting">
                          <StackPanel>
                            <Slider IsVisible="{Binding IsSlider}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                    Value="{Binding EditorValue, Mode=TwoWay}" SmallChange="{Binding Step}" TickFrequency="1" IsSnapToTickEnabled="{Binding IsInteger}" />
                            <NumericUpDown IsVisible="{Binding !IsSlider}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                           Increment="{Binding Step}" Value="{Binding NumericValue, Mode=TwoWay}" FormatString="{Binding Format, TargetNullValue=G}" />
                            <text:PlayerTextBlock Key="{Binding UnitKey}" Opacity="0.64" />
                          </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="settings:IChoiceSetting">
                          <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}">
                            <ComboBox.ItemTemplate><DataTemplate><ContentControl Content="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                          </ComboBox>
                        </DataTemplate>
                        <DataTemplate DataType="settings:BoolSetting"><CheckBox IsChecked="{Binding Value, Mode=TwoWay}" /></DataTemplate>
                        <DataTemplate DataType="settings:StringSetting"><TextBox Text="{Binding Value, Mode=TwoWay}" /></DataTemplate>
                        <DataTemplate DataType="settings:ActionSetting"><Button Content="{Binding Label}" Command="{Binding ExecuteCommand}" /></DataTemplate>
                        <DataTemplate DataType="settings:ICustomSetting"><settings:CustomSettingEditor /></DataTemplate>
                        <DataTemplate DataType="settings:SettingItem"><text:PlayerTextBlock Key="Settings.MissingEditor" /></DataTemplate>
                      </common:SettingEditor.DataTemplates>
                    </common:SettingEditor>
                    <text:PlayerTextBlock Key="{Binding Availability.ReasonKey}" TextWrapping="Wrap" Opacity="0.64" />
                    <text:PlayerTextBlock Key="{Binding ErrorKey}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DataTemplate>
    </TabControl.ContentTemplate>
  </TabControl>
</UserControl>
