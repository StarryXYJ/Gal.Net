<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             x:Class="GalNet.Avalonia.GameView.Page.MissingGalleryPage"
             x:DataType="vm:MissingGalleryPageViewModel">
  <Grid Background="{DynamicResource GalNet.Brush.Background}" Margin="{DynamicResource GalNet.Theme.PageMargin}" RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{text:PlayerText Gallery.Unavailable, 'Gallery page unavailable'}" FontSize="{DynamicResource GalNet.Theme.HeadingSize}" FontWeight="SemiBold"/><Button Grid.Column="1" Classes="player-link" Content="{text:PlayerText Common.Back, 'Back'}" Command="{Binding BackCommand}"/></Grid><Border Grid.Row="1" Margin="0,24,0,0" Padding="28" Background="{DynamicResource GalNet.Brush.Surface}" BorderBrush="{DynamicResource GalNet.Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource GalNet.Theme.CornerRadius}"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/></Border></Grid>
</UserControl>
