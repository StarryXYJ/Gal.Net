<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GalNet.Avalonia.GameView.Page"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             x:Class="GalNet.Avalonia.GameView.Page.GameShell"
             x:DataType="vm:GameShellViewModel"
             Classes="galnet-player"
             Background="{DynamicResource GalNet.Brush.Background}">
  <Grid Background="{DynamicResource GalNet.Brush.Background}">
    <TransitioningContentControl x:Name="PageHost"
                                 Background="{DynamicResource GalNet.Brush.Background}"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Stretch" />
  </Grid>
</UserControl>
