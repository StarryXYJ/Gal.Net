<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             x:Class="GalNet.Avalonia.GameView.Page.GameShell"
             x:DataType="vm:GameShellViewModel"
             Classes="galnet-player">
  <Grid>
    <TransitioningContentControl x:Name="PageHost"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Stretch" />
  </Grid>
</UserControl>
