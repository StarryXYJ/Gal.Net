<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             xmlns:page="using:GalNet.Avalonia.GameView.Page"
             x:Class="GalNet.Avalonia.GameView.Page.GameShell"
             x:DataType="vm:GameShellViewModel"
             Classes="galnet-player">
  <Grid>
    <TransitioningContentControl x:Name="PageHost"
                                 IsEnabled="{Binding !IsVisible, ElementName=SkipPrompt}"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Stretch" />
    <page:SkipConfirmation x:Name="SkipPrompt" x:CompileBindings="False"
                           IsVisible="{Binding IsSkipConfirmationOpen, FallbackValue=False}" />
  </Grid>
</UserControl>
