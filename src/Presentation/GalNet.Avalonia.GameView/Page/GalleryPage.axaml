<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions" xmlns:local="using:GalNet.Avalonia.GameView.Page" xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels" xmlns:gallery="using:GalNet.Core.Gallery" x:Class="GalNet.Avalonia.GameView.Page.GalleryPage" x:DataType="vm:GalleryPageViewModel">
  <Grid Background="{DynamicResource GalNet.Brush.Background}">
    <Border x:Name="PageFrame" Classes="player-page-frame">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" x:Name="PageHeader" MinHeight="{DynamicResource GalNet.Theme.PageHeaderMinHeight}" ColumnSpacing="24">
          <StackPanel Spacing="3">
            <TextBlock Text="{text:PlayerText Title.Gallery, 'Gallery'}" FontSize="{DynamicResource GalNet.Theme.HeadingSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Text="{text:PlayerText Gallery.Description, 'Unlocked memories and artwork'}" Opacity="0.64" />
          </StackPanel>
          <Button Grid.Column="1" Classes="player-back" Content="{text:PlayerText Common.Back, 'Back'}" Command="{Binding BackCommand}" VerticalAlignment="Center" x:Name="PageBackButton" />
        </Grid>
        <Border Grid.Row="1" Margin="0,20,0,0" Height="1" Background="{DynamicResource GalNet.Brush.Divider}" />
        <ScrollViewer Grid.Row="2" Margin="0,24,0,0" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="TypeList" ItemsSource="{Binding Types}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemWidth="260" ItemHeight="120" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="gallery:GalleryTypeData">
                <Button Margin="6" Padding="20" HorizontalContentAlignment="Stretch" Command="{Binding #TypeList.DataContext.OpenTypeCommand}" CommandParameter="{Binding}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Type.TypeId}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Type.ResourceTypeId}" Opacity="0.6" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>