<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
             xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels"
             x:Class="GalNet.Avalonia.GameView.Page.CgGalleryPage"
             x:DataType="vm:CgGalleryPageViewModel">
  <Grid Background="{DynamicResource GalNet.Brush.Background}" Margin="{DynamicResource GalNet.Theme.PageMargin}" RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Title}" FontSize="{DynamicResource GalNet.Theme.HeadingSize}" FontWeight="SemiBold" /><Button Grid.Column="1" Classes="player-link" Content="{text:PlayerText Common.Back, 'Back'}" Command="{Binding BackCommand}" /></Grid>
    <ScrollViewer Grid.Row="1" Margin="0,24,0,0"><ItemsControl x:Name="Items" ItemsSource="{Binding Items}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="260" ItemHeight="190" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:GalleryEntryViewModel"><Button Margin="6" Padding="0" IsEnabled="{Binding IsUnlocked}" Command="{Binding #Items.DataContext.OpenItemCommand}" CommandParameter="{Binding}"><Grid RowDefinitions="*,Auto" Background="{DynamicResource GalNet.Brush.Surface}"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding IsUnlocked}"/><Border Background="{DynamicResource GalNet.Brush.SurfaceRaised}" IsVisible="{Binding IsLocked}"><TextBlock Text="{text:PlayerText Gallery.Locked, 'Locked'}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Opacity="0.7" /></Border><Border Grid.Row="1" Background="{DynamicResource GalNet.Brush.Overlay}" Padding="10,7"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" /></Border></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  </Grid>
</UserControl>
