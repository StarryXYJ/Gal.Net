<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:page="using:GalNet.Avalonia.GameView.Page" xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions">
  <Style Selector="page|SkipConfirmation">
    <Setter Property="Template">
      <ControlTemplate x:CompileBindings="False">
        <Grid Background="#80000000">
          <Border MaxWidth="360" Margin="16" Padding="24" CornerRadius="6" Background="{DynamicResource GalNet.Brush.Surface}"
                  BorderBrush="{DynamicResource GalNet.Brush.Border}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="20">
              <TextBlock Text="{text:PlayerText Playback.SkipTitle, 'Skip read text?'}" FontSize="{DynamicResource GalNet.Theme.ModalHeadingSize}" FontWeight="SemiBold" />
              <TextBlock Text="{text:PlayerText Playback.SkipMessage, 'Continue along the current story until unread text or the next choice.'}" TextWrapping="Wrap" FontSize="{DynamicResource GalNet.Theme.ModalFontSize}" LineHeight="{DynamicResource GalNet.Theme.ModalLineHeight}" Foreground="{DynamicResource GalNet.Brush.TextSecondary}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button MinWidth="80" MinHeight="36" Padding="16,6" FontSize="{DynamicResource GalNet.Theme.ModalFontSize}" Content="{text:PlayerText Common.Cancel, Cancel}" Command="{Binding CancelSkipCommand}" />
                <Button Classes="player-primary" MinWidth="80" MinHeight="36" Padding="16,6" FontSize="{DynamicResource GalNet.Theme.ModalFontSize}" Content="{text:PlayerText Common.Confirm, Confirm}" Command="{Binding ConfirmSkipCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
<Styles.Resources>
  <ControlTheme x:Key="{x:Type page:GamePage}" TargetType="page:GamePage">
    <Setter Property="Background" Value="{DynamicResource GalNet.Brush.Background}" />
    <Setter Property="Template">
      <ControlTemplate>
            <Grid Background="{TemplateBinding Background}">
              <ContentPresenter Name="PART_Scene" Content="{TemplateBinding Scene}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
              <ContentPresenter Name="PART_Nvl" Content="{TemplateBinding Nvl}" Width="840" MaxHeight="540" HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="12" />
              <ContentPresenter Name="PART_Dialogue" Content="{TemplateBinding Dialogue}" Margin="64,0,64,70" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" HorizontalContentAlignment="Stretch" ZIndex="13" />
              <ContentPresenter Name="PART_Choice" Content="{TemplateBinding Choice}" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="50" />
              <ContentPresenter Name="PART_History" Content="{TemplateBinding History}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ZIndex="100" />
            </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</Styles.Resources>
</Styles>
