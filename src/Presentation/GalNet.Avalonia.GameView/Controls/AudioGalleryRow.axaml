<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:GalNet.Avalonia.GameView.ViewModels" xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
 x:Class="GalNet.Avalonia.GameView.Controls.AudioGalleryRow" x:Name="RowRoot" x:DataType="vm:GalleryEntryViewModel">
 <Grid x:Name="RowGrid" ColumnDefinitions="200,*,Auto" ColumnSpacing="16" RowSpacing="4" MinHeight="40">
  <TextBlock x:Name="TrackName" Text="{Binding Title}" TextAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding NameTooltip}" />
  <Grid x:Name="Timeline" Grid.Column="1" RowDefinitions="Auto,Auto">
   <Slider x:Name="Seek" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=TwoWay}" IsEnabled="{Binding CanSeek}" ToolTip.Tip="{Binding TimeText}" VerticalAlignment="Center" />
   <TextBlock x:Name="TrackTime" Grid.Row="1" Text="{Binding TimeText}" Foreground="{DynamicResource GalNet.Brush.TextSecondary}" FontSize="11" HorizontalAlignment="Right" />
  </Grid>
  <Grid x:Name="Actions" Grid.Column="2">
   <Button IsVisible="{Binding !IsPlaying}" IsEnabled="{Binding IsUnlocked}" Command="{Binding #RowRoot.ToggleCommand}" CommandParameter="{Binding}" AutomationProperties.Name="{text:PlayerText Gallery.Play, 'Play'}" ToolTip.Tip="{text:PlayerText Gallery.Play, 'Play'}"><PathIcon Width="16" Height="16" Data="M 4,2 L 14,8 L 4,14 Z" /></Button>
   <Button IsVisible="{Binding IsPlaying}" Command="{Binding #RowRoot.ToggleCommand}" CommandParameter="{Binding}" AutomationProperties.Name="{text:PlayerText Gallery.Pause, 'Pause'}" ToolTip.Tip="{text:PlayerText Gallery.Pause, 'Pause'}"><PathIcon Width="16" Height="16" Data="M 3,2 L 6,2 L 6,14 L 3,14 Z M 10,2 L 13,2 L 13,14 L 10,14 Z" /></Button>
  </Grid>
 </Grid>
</UserControl>