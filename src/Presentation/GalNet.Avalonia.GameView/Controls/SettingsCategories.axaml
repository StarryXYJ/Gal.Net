<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:forms="using:GalNet.Game.Controls.Forms" xmlns:settings="using:GalNet.Avalonia.GameView.Settings"
             xmlns:text="using:GalNet.Avalonia.GameView.MarkupExtensions"
             xmlns:common="using:GalNet.Avalonia.GameView.Controls" xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="GalNet.Avalonia.GameView.Controls.SettingsCategories" x:CompileBindings="False">
  <UserControl.Resources>
    <DataTemplate x:Key="MuteEditor" DataType="settings:BoolSetting">
      <StackPanel Spacing="3" IsVisible="{Binding IsVisible}">
        <ToggleButton Classes="player-mute" IsChecked="{Binding Value, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                      ToolTip.Tip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
          <Viewbox Width="22" Height="22">
            <Canvas Width="24" Height="24">
              <Path Classes="speaker" Data="M 3,9 L 7,9 L 12,5 L 12,19 L 7,15 L 3,15 Z" Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="1.6" StrokeJoin="Round" />
              <Path Classes="sound-waves" Data="M 16,8 C 19,10 19,14 16,16 M 19,5 C 24,9 24,15 19,19" Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="1.6" StrokeLineCap="Round" />
              <Path Classes="mute-slash" Data="M 3,3 L 21,21" Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="2" StrokeLineCap="Round" />
            </Canvas>
          </Viewbox>
        </ToggleButton>
        <text:PlayerTextBlock Key="{Binding ErrorKey}" Foreground="{DynamicResource GalNet.Brush.Error}" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <TabControl x:Name="CategoryTabs" ItemsSource="{Binding VisibleCategories, RelativeSource={RelativeSource AncestorType=UserControl}}">
    <TabControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></TabControl.ItemsPanel>
    <TabControl.Template>
      <ControlTemplate>
        <Grid RowDefinitions="Auto,*">
          <ScrollViewer Name="CategoryHeaderScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </ScrollViewer>
          <ContentPresenter Name="PART_SelectedContentHost" Grid.Row="1" Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
      </ControlTemplate>
    </TabControl.Template>
    <TabControl.ItemTemplate>
      <DataTemplate DataType="settings:SettingCategory"><ContentControl Content="{Binding Label}" /></DataTemplate>
    </TabControl.ItemTemplate>
    <TabControl.ContentTemplate>
      <DataTemplate DataType="settings:SettingCategory">
        <ScrollViewer Name="CategoryContentScroll" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" PropertyChanged="ContentPropertyChanged" AttachedToVisualTree="ContentAttached">
          <ItemsControl ItemsSource="{Binding DisplayItems}" Margin="0,16,0,0" HorizontalAlignment="Stretch">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="settings:SettingItem">
                <common:SettingRow MinHeight="44" Margin="0,0,0,16" IsVisible="{Binding IsVisible}" Classes.setting-unavailable="{Binding !IsEnabled}">
                  <StackPanel Spacing="4" VerticalAlignment="Center" IsVisible="{Binding !IsFullWidth}">
                    <ContentControl Classes="setting-label" Content="{Binding Label}" />
                    <text:PlayerTextBlock Key="{Binding DescriptionKey}" TextWrapping="Wrap" Opacity="0.64" />
                  </StackPanel>
                  <StackPanel Spacing="4" VerticalAlignment="Center">
                    <ContentControl Content="{Binding}" IsEnabled="{Binding IsEnabled}" VerticalAlignment="Center">
                      <ContentControl.DataTemplates>
                        <DataTemplate DataType="settings:ActionSetting"><Button Content="{Binding Label}" Command="{Binding ExecuteCommand}" /></DataTemplate>
                        <DataTemplate DataType="settings:ICustomSetting"><settings:CustomSettingEditor /></DataTemplate>
                        <DataTemplate DataType="settings:SettingItem">
                          <forms:DtoEditorHost Item="{Binding EditorItem}"
                                            Registry="{Binding Editors, RelativeSource={RelativeSource AncestorType=common:SettingsCategories}}">
                            <forms:DtoEditorHost.FormTheme><ControlTheme TargetType="forms:SchemaForm"><Setter Property="Template">
                              <ControlTemplate>
                                <StackPanel>
                                  <ItemsControl ItemsSource="{TemplateBinding Editors}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <StackPanel Spacing="4">
                                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                            <ContentControl Content="{Binding Control}" VerticalAlignment="Center" />
                                            <ContentControl Grid.Column="1" Content="{Binding DataContext.InlineToggle, RelativeSource={RelativeSource AncestorType={x:Type forms:DtoEditorHost}}}" ContentTemplate="{StaticResource MuteEditor}" VerticalAlignment="Center" />
                                          </Grid>
                                          <text:PlayerTextBlock Key="{Binding Context.Field.Editor.UnitKey}" Opacity="0.64" />
                                          <TextBlock Text="{Binding Context.Issue.Message}" IsVisible="{Binding Context.Issue.Message, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" TextWrapping="Wrap" />
                                        </StackPanel>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                  <ItemsControl ItemsSource="{TemplateBinding Diagnostics}">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Message}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </ControlTemplate>
                            </Setter></ControlTheme></forms:DtoEditorHost.FormTheme>
                          </forms:DtoEditorHost>
                        </DataTemplate>
                      </ContentControl.DataTemplates>
                    </ContentControl>
                    <text:PlayerTextBlock Key="{Binding Availability.ReasonKey}" TextWrapping="Wrap" Opacity="0.64" />
                    <text:PlayerTextBlock Key="{Binding ErrorKey}" TextWrapping="Wrap" />
                  </StackPanel>
                </common:SettingRow>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DataTemplate>
    </TabControl.ContentTemplate>
  </TabControl>
  <UserControl.Styles>
    <Style Selector="Grid.setting-unavailable ContentControl.setting-label">
      <Setter Property="Foreground" Value="{DynamicResource GalNet.Brush.TextDisabled}" />
    </Style>
    <Style Selector="CheckBox"><Setter Property="HorizontalAlignment" Value="Left" /></Style>
    <Style Selector="ToggleButton.player-mute">
      <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="8" /><Setter Property="CornerRadius" Value="{DynamicResource GalNet.Theme.CornerRadius}" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource GalNet.Brush.TextSecondary}" />
      <Setter Property="Template"><ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate></Setter>
    </Style>
    <Style Selector="ToggleButton.player-mute:checked"><Setter Property="Foreground" Value="{DynamicResource GalNet.Brush.Primary}" /><Setter Property="Background" Value="{DynamicResource GalNet.Brush.Selection}" /></Style>
    <Style Selector="ToggleButton.player-mute:pointerover"><Setter Property="Background" Value="{DynamicResource GalNet.Brush.SurfaceRaised}" /><Setter Property="Foreground" Value="{DynamicResource GalNet.Brush.TextPrimary}" /></Style>
    <Style Selector="ToggleButton.player-mute:focus-visible"><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource GalNet.Brush.Focus}" /></Style>
    <Style Selector="ToggleButton.player-mute:disabled">
      <Setter Property="Foreground" Value="{DynamicResource GalNet.Brush.TextDisabled}" />
      <Setter Property="Background" Value="{DynamicResource GalNet.Brush.DisabledSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GalNet.Brush.DisabledBorder}" />
    </Style>
    <Style Selector="ToggleButton.player-mute Path.mute-slash"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="ToggleButton.player-mute:checked Path.mute-slash"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="ToggleButton.player-mute:checked Path.sound-waves"><Setter Property="IsVisible" Value="False" /></Style>
  </UserControl.Styles>
</UserControl>
