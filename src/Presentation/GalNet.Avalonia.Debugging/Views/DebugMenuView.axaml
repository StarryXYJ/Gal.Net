<Menu xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:debug="using:GalNet.Avalonia.Debugging"
      xmlns:loc="clr-namespace:GalNet.Avalonia.GameView.MarkupExtensions;assembly=GalNet.Avalonia.GameView"
      x:Class="GalNet.Avalonia.Debugging.Views.DebugMenuView"
      x:DataType="debug:GameDebugViewModel"
      Background="{DynamicResource GalNet.Brush.Background}"
      Foreground="{DynamicResource GalNet.Brush.TextPrimary}">
  <Menu.Resources>
    <SolidColorBrush x:Key="DebugCaptionHoverBackground" Color="{DynamicResource GalNet.Palette.TextPrimaryColor}" Opacity="0.08" />
    <SolidColorBrush x:Key="DebugCaptionPressedBackground" Color="{DynamicResource GalNet.Palette.TextPrimaryColor}" Opacity="0.14" />
  </Menu.Resources>
  <Menu.Styles>
    <Style Selector="MenuItem#DebugCaption:not(:disabled):pointerover /template/ Border#PART_LayoutRoot, MenuItem#DebugCaption:not(:disabled):selected /template/ Border#PART_LayoutRoot, MenuItem#DebugCaption:not(:disabled):open /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource DebugCaptionHoverBackground}" />
    </Style>
    <Style Selector="MenuItem#DebugCaption:not(:disabled):pressed /template/ Border#PART_LayoutRoot:pointerover">
      <Setter Property="Background" Value="{DynamicResource DebugCaptionPressedBackground}" />
    </Style>
    <Style Selector="MenuItem#DebugCaption:not(:disabled):selected /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="{Binding $parent[MenuItem].Foreground}" />
    </Style>
  </Menu.Styles>
  <MenuItem x:Name="DebugCaption" Header="{loc:Localize Debug.Menu}" Foreground="{DynamicResource GalNet.Brush.TextPrimary}">
    <MenuItem Header="{loc:Localize Debug.ClearPlayerState}" Command="{Binding ClearPlayerStateCommand}" IsEnabled="{Binding IsGameReady}" />
    <MenuItem Header="{loc:Localize Debug.ReloadGameResources}" Command="{Binding ReloadGameResourcesCommand}" />
    <Separator />
    <MenuItem Header="{loc:Localize Debug.Save}" IsEnabled="{Binding IsGameReady}">
      <MenuItem Header="{loc:Localize Debug.SaveProgressOnly}" Command="{Binding SaveProgressOnlyCommand}" />
      <MenuItem Header="{loc:Localize Debug.SaveGalgroup}" Command="{Binding SaveGalGroupStartCommand}" />
    </MenuItem>
    <Separator />
    <MenuItem Header="{loc:Localize Debug.ShowLog}" Command="{Binding ShowLogCommand}" />
    <MenuItem Header="{loc:Localize Debug.OpenLogDirectory}" Command="{Binding OpenLogDirectoryCommand}" IsVisible="{Binding CanOpenLogDirectory}" />
  </MenuItem>
</Menu>
