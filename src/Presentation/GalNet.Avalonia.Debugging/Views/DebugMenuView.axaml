<Menu xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:debug="using:GalNet.Avalonia.Debugging"
      xmlns:loc="clr-namespace:GalNet.Avalonia.GameView.MarkupExtensions;assembly=GalNet.Avalonia.GameView"
      x:Class="GalNet.Avalonia.Debugging.Views.DebugMenuView"
      x:DataType="debug:GameDebugViewModel"
      Background="{DynamicResource GalNet.Brush.Background}"
      Foreground="{DynamicResource GalNet.Brush.TextPrimary}">
  <MenuItem Header="{loc:Localize Debug.Menu}" Foreground="{DynamicResource GalNet.Brush.TextPrimary}">
    <MenuItem Header="{loc:Localize Debug.ClearPlayerState}" Command="{Binding ClearPlayerStateCommand}" IsEnabled="{Binding IsGameReady}" />
    <MenuItem Header="{loc:Localize Debug.ReloadGameResources}" Command="{Binding ReloadGameResourcesCommand}" />
    <Separator />
    <MenuItem Header="{loc:Localize Debug.Save}" IsEnabled="{Binding IsGameReady}">
      <MenuItem Header="{loc:Localize Debug.SaveProgressOnly}" Command="{Binding SaveProgressOnlyCommand}" />
      <MenuItem Header="{loc:Localize Debug.SaveGalgroup}" Command="{Binding SaveGalGroupStartCommand}" />
    </MenuItem>
    <Separator />
    <MenuItem Header="{loc:Localize Debug.ShowLog}" Command="{Binding ShowLogCommand}" />
    <MenuItem Header="{loc:Localize Debug.OpenLogDirectory}" Command="{Binding OpenLogDirectoryCommand}" IsVisible="{Binding CanOpenLogDirectory}" />
  </MenuItem>
</Menu>
