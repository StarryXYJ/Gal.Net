<UserControl xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:debug="using:GalNet.Avalonia.Debugging"
                 xmlns:loc="clr-namespace:GalNet.Avalonia.GameView.MarkupExtensions;assembly=GalNet.Avalonia.GameView"
                 xmlns:views="using:GalNet.Avalonia.Debugging.Views"
                 x:Class="GalNet.Avalonia.Debugging.Views.DebugLogView"
                 x:DataType="views:DebugLogView"
                 Background="{DynamicResource GalNet.Brush.Background}">
  <Grid RowDefinitions="Auto,*" Margin="12">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="{loc:Localize DebugLog.Clear}" Click="OnClearLogsClick" />
      <Button Content="{loc:Localize DebugLog.OpenDirectory}" Command="{Binding Actions.OpenLogDirectoryCommand}" IsVisible="{Binding Actions.CanOpenLogDirectory}" />
      <Button Content="{loc:Localize DebugLog.Close}" Click="OnCloseLogsClick" />
    </StackPanel>

    <ListBox x:Name="LogListBox"
             Grid.Row="1"
             ItemsSource="{Binding Lines}"
             Margin="0,8,0,0"
             Background="Transparent">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="debug:GameDebugLogLine">
          <TextBlock Text="{Binding FullText}"
                     FontSize="12"
                     TextWrapping="Wrap" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
