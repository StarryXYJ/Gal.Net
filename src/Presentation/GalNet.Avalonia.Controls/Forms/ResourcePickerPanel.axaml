<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GalNet.Game.Controls.Forms" x:Class="GalNet.Game.Controls.Forms.ResourcePickerPanel">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
    <TextBox Name="SearchBox" TextChanged="OnSearchChanged"/>
    <ListBox Name="ResourceList" Grid.Row="1" SelectionChanged="OnSelectionChanged" PointerReleased="OnReleased">
      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate><DataTemplate x:DataType="local:ResourcePickerItem">
        <Border Classes="resource-card" Width="116" MinHeight="132" Margin="3" Padding="6" CornerRadius="6" BorderThickness="1" ToolTip.Tip="{Binding Detail}">
          <StackPanel Spacing="4">
            <Border Height="82" CornerRadius="4"><Grid>
              <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}"/>
              <TextBlock Text="{Binding Icon}" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasThumbnail}"/>
            </Grid></Border>
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Badge}" FontSize="10" Opacity="0.7" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
      </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Name="DetailLabel" Grid.Row="2" TextWrapping="Wrap" Opacity="0.7"/>
  </Grid>
</UserControl>
