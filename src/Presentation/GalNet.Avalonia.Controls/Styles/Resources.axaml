<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Neutral fallbacks keep the behavior controls usable without an official theme. -->
  <SolidColorBrush x:Key="GalNet.Brush.Primary" Color="#7B8797" />
  <SolidColorBrush x:Key="GalNet.Brush.PrimaryHover" Color="#929DAC" />
  <SolidColorBrush x:Key="GalNet.Brush.PrimaryPressed" Color="#626E7F" />
  <SolidColorBrush x:Key="GalNet.Brush.OnPrimary" Color="White" />
  <SolidColorBrush x:Key="GalNet.Brush.Secondary" Color="#526071" />
  <SolidColorBrush x:Key="GalNet.Brush.OnSecondary" Color="White" />
  <SolidColorBrush x:Key="GalNet.Brush.Background" Color="#15181D" />
  <SolidColorBrush x:Key="GalNet.Brush.Surface" Color="#242A33" />
  <SolidColorBrush x:Key="GalNet.Brush.SurfaceRaised" Color="#303946" />
  <SolidColorBrush x:Key="GalNet.Brush.Overlay" Color="#D9242A33" />
  <SolidColorBrush x:Key="GalNet.Brush.TextPrimary" Color="#F1F3F5" />
  <SolidColorBrush x:Key="GalNet.Brush.TextSecondary" Color="#B8C0CB" />
  <SolidColorBrush x:Key="GalNet.Brush.TextDisabled" Color="#727E8E" />
  <SolidColorBrush x:Key="GalNet.Brush.Border" Color="#526071" />
  <SolidColorBrush x:Key="GalNet.Brush.Divider" Color="#3B4553" />
  <SolidColorBrush x:Key="GalNet.Brush.Focus" Color="#A8B4C4" />
  <SolidColorBrush x:Key="GalNet.Brush.Selection" Color="#465467" />
  <SolidColorBrush x:Key="GalNet.Brush.Success" Color="#74BD91" />
  <SolidColorBrush x:Key="GalNet.Brush.Warning" Color="#E4BF75" />
  <SolidColorBrush x:Key="GalNet.Brush.Error" Color="#F09999" />
  <SolidColorBrush x:Key="GalNet.Brush.Info" Color="#8BBCE0" />
  <CornerRadius x:Key="GalNet.Theme.CornerRadius">4</CornerRadius>
  <Thickness x:Key="GalNet.Theme.DialoguePadding">24</Thickness>
  <x:Double x:Key="GalNet.Theme.DialogueHeight">200</x:Double>
  <x:Double x:Key="GalNet.Theme.DialogueFontSize">20</x:Double>
  <x:Double x:Key="GalNet.Theme.SpeakerFontSize">18</x:Double>
  <Thickness x:Key="GalNet.Theme.ChoicePadding">20,14</Thickness>
  <Thickness x:Key="GalNet.Theme.ChoiceMargin">0,5</Thickness>
  <x:Double x:Key="GalNet.Theme.NvlSpacing">14</x:Double>
  <x:Double x:Key="GalNet.Theme.SaveMinHeight">150</x:Double>
</ResourceDictionary>
