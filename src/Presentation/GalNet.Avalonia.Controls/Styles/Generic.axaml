<?xml version="1.0" encoding="utf-8"?>
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:GalNet.Game.Controls" xmlns:conv="using:Avalonia.Data.Converters">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://GalNet.Avalonia.Controls/Styles/Resources.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <ControlTheme x:Key="{x:Type local:DialoguePresenter}" TargetType="local:DialoguePresenter">
        <Setter Property="Template">
          <ControlTemplate>
            <Border MinHeight="{DynamicResource GalNet.Theme.DialogueHeight}" Background="{DynamicResource GalNet.Brush.Overlay}" BorderBrush="{DynamicResource GalNet.Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource GalNet.Theme.CornerRadius}" Padding="{DynamicResource GalNet.Theme.DialoguePadding}">
              <StackPanel Spacing="8">
                <TextBlock Text="{TemplateBinding Speaker}" FontWeight="SemiBold" FontSize="{DynamicResource GalNet.Theme.SpeakerFontSize}" Foreground="{DynamicResource GalNet.Brush.Primary}" />
                <local:TypewriterTextBlock Name="PART_Typewriter" SourceText="{TemplateBinding Text}" CharactersPerSecond="{TemplateBinding CharactersPerSecond}" FontSize="{DynamicResource GalNet.Theme.DialogueFontSize}" Foreground="{DynamicResource GalNet.Brush.TextPrimary}" />
              </StackPanel>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="{x:Type local:ChoiceList}" TargetType="local:ChoiceList">
        <Setter Property="ItemContainerTheme" Value="{DynamicResource GalNet.Theme.ChoiceItem}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsPresenter />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="GalNet.Theme.ChoiceItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="{DynamicResource GalNet.Theme.ChoiceMargin}" />
        <Setter Property="Padding" Value="{DynamicResource GalNet.Theme.ChoicePadding}" />
        <Setter Property="Background" Value="{DynamicResource GalNet.Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource GalNet.Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GalNet.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource GalNet.Theme.CornerRadius}">
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource GalNet.Brush.Selection}" />
        </Style>
        <Style Selector="^:selected">
          <Setter Property="Background" Value="{DynamicResource GalNet.Brush.Primary}" />
          <Setter Property="Foreground" Value="{DynamicResource GalNet.Brush.OnPrimary}" />
        </Style>
        <Style Selector="^:focus-visible">
          <Setter Property="BorderBrush" Value="{DynamicResource GalNet.Brush.Focus}" />
          <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Foreground" Value="{DynamicResource GalNet.Brush.TextDisabled}" />
          <Setter Property="Opacity" Value="0.6" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="{x:Type local:SaveSlotCard}" TargetType="local:SaveSlotCard">
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="PART_Frame" Height="210" Background="{DynamicResource GalNet.Brush.Surface}"
                    BorderBrush="{DynamicResource GalNet.Brush.Border}" BorderThickness="1"
                    CornerRadius="{DynamicResource GalNet.Theme.CornerRadius}" ClipToBounds="True">
              <Grid>
                <Image Name="PART_Preview" Source="{TemplateBinding Preview}" Stretch="UniformToFill" />
                <Button Name="PART_Activate" Command="{TemplateBinding Command}" CommandParameter="{TemplateBinding CommandParameter}"
                        Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        AutomationProperties.Name="{TemplateBinding Description}">
                  <Button.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></Button.Template>
                </Button>
                <Grid VerticalAlignment="Bottom" MinHeight="84">
                  <Border Background="{DynamicResource GalNet.Brush.SaveCaption}" IsHitTestVisible="False" />
                  <StackPanel Spacing="4" Margin="16,12">
                    <TextBox Name="PART_Name" Text="{TemplateBinding Description, Mode=OneWay}"
                             IsReadOnly="{Binding !CanRename, RelativeSource={RelativeSource TemplatedParent}}"
                             Focusable="{TemplateBinding CanRename}" IsHitTestVisible="{TemplateBinding CanRename}" MaxLength="120" AcceptsReturn="False"
                             Background="Transparent" BorderThickness="0" Padding="0" MinHeight="26"
                             FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource GalNet.Brush.TextPrimary}"
                             ToolTip.Tip="{TemplateBinding RenameError}">
                      <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                          <ScrollViewer Name="PART_ScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <TextPresenter Name="PART_TextPresenter" Text="{TemplateBinding Text, Mode=TwoWay}"
                                           CaretBrush="{DynamicResource GalNet.Brush.TextPrimary}"
                                           SelectionBrush="{DynamicResource GalNet.Brush.Selection}"
                                           SelectionForegroundBrush="{DynamicResource GalNet.Brush.TextPrimary}" />
                          </ScrollViewer>
                        </ControlTemplate>
                      </TextBox.Template>
                    </TextBox>
                    <TextBlock Text="{TemplateBinding Timestamp}" FontSize="12" Foreground="{DynamicResource GalNet.Brush.TextSecondary}" IsHitTestVisible="False" />
                    <TextBlock Text="{TemplateBinding RenameError}" IsVisible="{Binding RenameError, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" FontSize="12" Foreground="{DynamicResource GalNet.Brush.Error}" TextWrapping="Wrap" IsHitTestVisible="False" />
                  </StackPanel>
                </Grid>
                <Border Name="PART_Highlight" Background="{DynamicResource GalNet.Brush.Selection}" Opacity="0" IsHitTestVisible="False" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Frame"><Setter Property="BorderBrush" Value="{DynamicResource GalNet.Brush.PrimaryHover}" /></Style>
        <Style Selector="^:pointerover /template/ Border#PART_Highlight"><Setter Property="Opacity" Value="0.18" /></Style>
        <Style Selector="^:focus-within /template/ Border#PART_Frame"><Setter Property="BorderBrush" Value="{DynamicResource GalNet.Brush.Focus}" /></Style>
        <Style Selector="^:focus-within /template/ Border#PART_Highlight"><Setter Property="Opacity" Value="0.3" /></Style>
      </ControlTheme>
      <ControlTheme x:Key="{x:Type local:NvlPresenter}" TargetType="local:NvlPresenter">
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{DynamicResource GalNet.Brush.Overlay}" BorderBrush="{DynamicResource GalNet.Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource GalNet.Theme.CornerRadius}" Padding="{DynamicResource GalNet.Theme.DialoguePadding}">
              <ScrollViewer Name="PART_ScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel Name="PART_Lines" Spacing="{DynamicResource GalNet.Theme.NvlSpacing}" />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="{x:Type local:NvlLinePresenter}" TargetType="local:NvlLinePresenter">
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel Spacing="3">
              <local:TypewriterTextBlock Name="PART_Typewriter" SourceText="{TemplateBinding Text}" CharactersPerSecond="{TemplateBinding CharactersPerSecond}" FontSize="{DynamicResource GalNet.Theme.DialogueFontSize}" Foreground="{DynamicResource GalNet.Brush.TextPrimary}" />
            </StackPanel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="local|TypewriterTextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</Styles>
