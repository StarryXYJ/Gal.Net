<ursa:UrsaWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:debug="using:GalNet.Sample.Avalonia.Debug"
                 xmlns:views="using:GalNet.Sample.Avalonia.Views"
                 xmlns:ursa="https://irihi.tech/ursa"
                 x:Class="GalNet.Sample.Avalonia.Views.DebugLogWindow"
                 x:DataType="views:DebugLogWindow"
                 Width="960" Height="600" MinWidth="600" MinHeight="360"
                 Title="Debug log"
                 WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*" Margin="12">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="清空日志" Click="OnClearLogsClick" />
    </StackPanel>

    <ListBox x:Name="LogListBox"
             Grid.Row="1"
             ItemsSource="{Binding Lines}"
             Margin="0,8,0,0"
             Background="Transparent">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="debug:SampleDebugLogLine">
          <TextBlock Text="{Binding FullText}"
                     FontFamily="Consolas"
                     FontSize="12"
                     TextWrapping="Wrap" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</ursa:UrsaWindow>
