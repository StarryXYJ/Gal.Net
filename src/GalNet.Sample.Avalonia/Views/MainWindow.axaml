<ursa:UrsaWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:GalNet.Game.Controls"
        xmlns:ursa="https://irihi.tech/ursa"
        x:Class="GalNet.Sample.Avalonia.Views.MainWindow"
        Width="1280" Height="720" MinWidth="800" MinHeight="500"
        Icon="/Assets/avalonia-logo.ico"
        Title="GalNet Avalonia Sample Player">
  <controls:GameCanvasHost x:Name="GameCanvas"
                           DesignWidth="1920"
                           DesignHeight="1080" />
</ursa:UrsaWindow>
