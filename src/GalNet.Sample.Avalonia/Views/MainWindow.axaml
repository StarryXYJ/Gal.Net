<ursa:UrsaWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:GalNet.Game.Controls"
        xmlns:ursa="https://irihi.tech/ursa"
        x:Class="GalNet.Sample.Avalonia.Views.MainWindow"
        Width="1280" Height="720" MinWidth="800" MinHeight="500"
        Background="Black"
        Icon="/Assets/avalonia-logo.ico"
        Title="GalNet Avalonia Sample Player">
  <Grid RowDefinitions="Auto,*">
    <Menu x:Name="DebugMenu" IsVisible="False">
      <MenuItem Header="调试">
        <MenuItem Header="清空游戏数据..." Click="OnClearPlayerStateClick" />
        <MenuItem Header="日志面板 (L)" Click="OnShowDebugLogClick" />
      </MenuItem>
    </Menu>
    <controls:GameCanvasHost x:Name="GameCanvas"
                             Grid.Row="1"
                             DesignWidth="1920"
                             DesignHeight="1080" />
  </Grid>
</ursa:UrsaWindow>
