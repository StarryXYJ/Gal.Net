<Project Sdk="Microsoft.NET.SDK">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Models\" />
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Dock.Avalonia" />
        <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
        <PackageReference Include="Dock.Model" />
        <PackageReference Include="Dock.Model.Avalonia" />
        <PackageReference Include="Dock.Model.Mvvm" />
        <PackageReference Include="Dock.Settings" />
        <PackageReference Include="DynamicLocalization.Core" />
        <PackageReference Include="Irihi.Ursa" />
        <PackageReference Include="Irihi.Ursa.Themes.Semi" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Semi.Avalonia.ColorPicker" />
        <PackageReference Include="Semi.Avalonia.Dock" />
        <PackageReference Include="Serilog" />
        <PackageReference Include="Serilog.Sinks.Console" />
        <PackageReference Include="Serilog.Sinks.Debug" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Localization\*.json" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\GalNet.Editor.Abstraction\GalNet.Editor.Abstraction.csproj" />
      <ProjectReference Include="..\GalNet.Assets\GalNet.Assets.csproj" />
      <ProjectReference Include="..\GalNet.Avalonia.Controls\GalNet.Avalonia.Controls.csproj" />
      <ProjectReference Include="..\GalNet.Avalonia.GameView\GalNet.Avalonia.GameView.csproj" Aliases="GameViewAssembly" />
      <ProjectReference Include="..\GalNet.Core\GalNet.Core.csproj" />
      <ProjectReference Include="..\GalNet.Editor.Shared\GalNet.Editor.Shared.csproj" />
      <ProjectReference Include="..\GalNet.Presentation.Abstractions\GalNet.Presentation.Abstractions.csproj" />
      <ProjectReference Include="..\GalNet.Runtime\GalNet.Runtime.csproj" />
      <ProjectReference Include="..\GalNet.Storage.Abstractions\GalNet.Storage.Abstractions.csproj" />
      <ProjectReference Include="..\GalNet.Storage.FileSystem\GalNet.Storage.FileSystem.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\EditorPageView.axaml.cs">
        <DependentUpon>EditorPageView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\ProjectSettingsPanelView.axaml.cs">
        <DependentUpon>ProjectSettingsPanelView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\EditorSettingsPanelView.axaml.cs">
        <DependentUpon>EditorSettingsPanelView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\GamePreviewPanelView.axaml.cs">
        <DependentUpon>GamePreviewPanelView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\ProjectSettingsWindow.axaml.cs">
        <DependentUpon>ProjectSettingsWindow.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\EditorSettingsWindow.axaml.cs">
        <DependentUpon>EditorSettingsWindow.axaml</DependentUpon>
      </Compile>
      <Compile Update="Controls\BranchOptionListEditorControl.axaml.cs">
        <DependentUpon>BranchOptionListEditorControl.axaml</DependentUpon>
      </Compile>
      <Compile Update="Inspector\Views\InspectorHostView.axaml.cs">
        <DependentUpon>InspectorHostView.axaml</DependentUpon>
      </Compile>
    </ItemGroup>
</Project>
