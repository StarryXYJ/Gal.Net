<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GalNet.Editor.ViewModels"
             xmlns:loc="clr-namespace:GalNet.Editor.MarkupExtensions"
             x:Class="GalNet.Editor.Views.NewProjectPanelView"
             x:DataType="vm:NewProjectPanelViewModel"
             Background="{DynamicResource SemiColorBackground0}">
    <ScrollViewer>
        <StackPanel Margin="12" Spacing="10" MaxWidth="520" IsEnabled="{Binding !IsBusy}">
            <TextBlock Text="{loc:Localize Startup.NewProject}"
                       FontSize="16"
                       FontWeight="SemiBold" />

            <TextBlock Text="{loc:Localize NewProject.Name}" />
            <TextBox Name="ProjectNameInput" Text="{Binding ProjectName}" />

            <TextBlock Text="{loc:Localize NewProject.Parent}" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Name="ProjectRootInput" Text="{Binding ProjectRoot}" />
                <Button Grid.Column="1" Content="{loc:Localize Common.Browse}" Command="{Binding BrowseProjectRootCommand}" Margin="8,0,0,0" />
            </Grid>

            <TextBlock Text="{loc:Localize NewProject.Application}" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Name="ApplicationPathInput" Text="{Binding ApplicationPath}" PlaceholderText="{loc:Localize NewProject.ApplicationHint}" />
                <Button Name="BrowseApplicationButton" Grid.Column="1" Content="{loc:Localize Common.Browse}" Command="{Binding BrowseApplicationCommand}" Margin="8,0,0,0" />
            </Grid>

            <TextBlock Text="{loc:Localize NewProject.Contracts}" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Name="ContractsDirectoryInput" Text="{Binding ContractsDirectory}" PlaceholderText="{loc:Localize NewProject.ContractsHint}" />
                <Button Name="BrowseContractsButton" Grid.Column="1" Content="{loc:Localize Common.Browse}" Command="{Binding BrowseContractsCommand}" Margin="8,0,0,0" />
            </Grid>

            <TextBlock Text="{loc:Localize NewProject.Resolution}" />
            <ComboBox ItemsSource="{Binding ResolutionPresets}"
                      Text="{Binding Resolution}"
                      IsEditable="True" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="CreateProjectButton" Content="{loc:Localize NewProject.Create}"
                        Command="{Binding CreateCommand}" />
                <Button Content="{loc:Localize Common.Cancel}"
                        Command="{Binding CancelCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding Message}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SemiColorText2}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
