<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:globalization="clr-namespace:System.Globalization;assembly=System.Runtime"
             xmlns:loc="using:GalNet.Editor.MarkupExtensions"
             xmlns:forms="using:GalNet.Game.Controls.Forms"
             xmlns:vm="using:GalNet.Editor.ViewModels"
             x:Class="GalNet.Editor.Views.EditorSettingsPanelView"
             x:DataType="vm:EditorSettingsPanelViewModel"
             Background="{DynamicResource SemiColorBackground0}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <TextBlock Grid.Row="0" Text="{loc:Localize Settings.Editor.Title}"
                   FontSize="{DynamicResource Editor.Font.Heading}" FontWeight="Bold"
                   Foreground="{DynamicResource SemiColorText0}"
                   Margin="0,0,0,12" />

        <TabControl Grid.Row="1" TabStripPlacement="Left">
          <TabItem Header="{loc:Localize Settings.Editor.Title}">
          <ScrollViewer>
            <StackPanel Spacing="8" Margin="12,0,0,0">
                <forms:FieldEditorRow Name="ThemeRow" ShowActions="False" LabelWidth="150">
                  <forms:FieldEditorRow.Label><TextBlock Text="{loc:Localize Settings.Theme}" TextWrapping="Wrap"/></forms:FieldEditorRow.Label>
                  <forms:FieldEditorRow.Editor>
                    <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ThemeSelectionItem"><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                  </forms:FieldEditorRow.Editor>
                </forms:FieldEditorRow>
                <forms:FieldEditorRow ShowActions="False" LabelWidth="150">
                  <forms:FieldEditorRow.Label><TextBlock Text="{loc:Localize Settings.UiLanguage}" TextWrapping="Wrap"/></forms:FieldEditorRow.Label>
                  <forms:FieldEditorRow.Editor>
                    <ComboBox ItemsSource="{Binding AvailableCultures}" SelectedItem="{Binding SelectedCulture, Mode=TwoWay}" HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate><DataTemplate x:DataType="globalization:CultureInfo"><TextBlock Text="{Binding NativeName}"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                  </forms:FieldEditorRow.Editor>
                </forms:FieldEditorRow>
                <forms:FieldEditorRow ShowActions="False" LabelWidth="150">
                  <forms:FieldEditorRow.Label><TextBlock Text="{loc:Localize Settings.FontSize}" TextWrapping="Wrap"/></forms:FieldEditorRow.Label>
                  <forms:FieldEditorRow.Editor><NumericUpDown Name="EditorFontSize" Minimum="10" Maximum="18" Increment="1" FormatString="0" Width="120" HorizontalAlignment="Left" Value="{Binding FontSize, Mode=TwoWay}"/></forms:FieldEditorRow.Editor>
                </forms:FieldEditorRow>
                <forms:FieldEditorRow ShowActions="False" LabelWidth="150">
                  <forms:FieldEditorRow.Label><TextBlock Text="{loc:Localize Settings.DefaultApplication}" TextWrapping="Wrap"/></forms:FieldEditorRow.Label>
                  <forms:FieldEditorRow.Editor><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding DefaultApplicationPath}"/><Button Grid.Column="1" Content="{loc:Localize Common.Browse}" Command="{Binding BrowseDefaultApplicationCommand}"/></Grid></forms:FieldEditorRow.Editor>
                </forms:FieldEditorRow>
                <forms:FieldEditorRow ShowActions="False" LabelWidth="150">
                  <forms:FieldEditorRow.Label><TextBlock Text="{loc:Localize Settings.DefaultContracts}" TextWrapping="Wrap"/></forms:FieldEditorRow.Label>
                  <forms:FieldEditorRow.Editor><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding DefaultContractsDirectory}"/><Button Grid.Column="1" Content="{loc:Localize Common.Browse}" Command="{Binding BrowseDefaultContractsCommand}"/></Grid></forms:FieldEditorRow.Editor>
                </forms:FieldEditorRow>
                <CheckBox Name="ExpandNewEntries" Content="{loc:Localize Settings.ExpandNewEntries}" IsChecked="{Binding ExpandNewEntries,Mode=TwoWay}"/>
                <!-- Auto-save is intentionally forced on for the current editor experience. -->

            </StackPanel>
          </ScrollViewer>
          </TabItem>
          <TabItem Name="ShortcutsTab" Header="{loc:Localize Settings.Shortcuts}">
          <ScrollViewer>
            <StackPanel Spacing="8" Margin="12,0,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{loc:Localize Settings.Shortcuts}" FontWeight="SemiBold"
                               Foreground="{DynamicResource SemiColorText0}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{loc:Localize Settings.Shortcuts.ResetAll}"
                            Click="OnResetAll" />
                </Grid>
                <TextBox Text="{Binding ShortcutSearchText, Mode=TwoWay}" PlaceholderText="{loc:Localize Settings.SearchCommands}" />
                <ItemsControl ItemsSource="{Binding Shortcuts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShortcutSettingItemViewModel">
                            <Border BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1" Padding="0,7">
                                <Grid ColumnDefinitions="2*,1*,Auto" ColumnSpacing="12">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource SemiColorText0}" />
                                        <TextBlock Text="{Binding Category}" FontSize="{DynamicResource Editor.Font.Caption}" Foreground="{DynamicResource SemiColorText2}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Button Name="ShortcutCapture" Content="{Binding GestureText}" HorizontalAlignment="Stretch" Click="OnCaptureShortcut" ToolTip.Tip="{loc:Localize Settings.Shortcuts.CaptureHint}" />
                                        <TextBlock Text="{Binding ValidationMessage}" FontSize="{DynamicResource Editor.Font.Micro}" Foreground="{DynamicResource SemiColorDanger}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Theme="{DynamicResource EditorIconButton}" Command="{Binding ResetCommand}" ToolTip.Tip="{loc:Localize Common.Reset}" AutomationProperties.Name="{loc:Localize Common.Reset}"><PathIcon Width="16" Height="16" Data="{StaticResource ResetIcon}" /></Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          </TabItem>
        </TabControl>

        <Grid Grid.Row="2" ColumnDefinitions="*" Margin="0,12,0,0">
            <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                       Foreground="{DynamicResource SemiColorText2}"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
