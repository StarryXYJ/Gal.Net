<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GalNet.Editor.MarkupExtensions"
             xmlns:vm="using:GalNet.Editor.ViewModels"
             x:Class="GalNet.Editor.Views.ExportPanelView"
             x:DataType="vm:ExportPanelViewModel"
             Background="{DynamicResource SemiColorBackground0}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto"
          RowSpacing="5" Margin="16">
        <TextBlock Text="{loc:Localize Export.Title}" FontSize="16" FontWeight="Bold" />
        <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="{loc:Localize Export.Mode}" Foreground="{DynamicResource SemiColorText2}" />
        <ComboBox Grid.Row="2" Name="ExportModeSelector"
                  ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                  IsEnabled="{Binding !IsExporting}" />
        <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="{loc:Localize Export.OutputDirectory}" Foreground="{DynamicResource SemiColorText2}" />
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Name="ExportOutputInput" Text="{Binding OutputDirectory}" IsEnabled="{Binding !IsExporting}" />
            <Button Grid.Column="1" Content="{loc:Localize Export.Browse}" Command="{Binding BrowseCommand}" IsEnabled="{Binding !IsExporting}" />
        </Grid>
        <TextBlock Grid.Row="5" Margin="0,8,0,0" Text="{loc:Localize Export.DirectoryHint}" TextWrapping="Wrap" IsVisible="{Binding !IsPackageMode}" />
        <StackPanel Grid.Row="6" Margin="0,8,0,0" Spacing="4">
            <TextBlock Text="{loc:Localize Export.Package}" Foreground="{DynamicResource SemiColorText2}" />
            <TextBlock Text="{Binding PackagePath}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="7" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <Button Grid.Column="1" Content="{loc:Localize Export.Action}" Click="OnExportClicked" IsEnabled="{Binding !IsExporting}" />
        </Grid>
    </Grid>
</UserControl>
