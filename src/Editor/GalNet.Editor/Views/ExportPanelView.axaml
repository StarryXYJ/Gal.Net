<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GalNet.Editor.MarkupExtensions"
             xmlns:vm="using:GalNet.Editor.ViewModels"
             x:Class="GalNet.Editor.Views.ExportPanelView"
             x:DataType="vm:ExportPanelViewModel"
             Background="{DynamicResource SemiColorBackground0}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto"
          RowSpacing="5"
          Margin="16">
        <TextBlock Text="{loc:Localize Export.Title}" FontSize="16" FontWeight="Bold" />

        <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="{loc:Localize Export.Mode}" Foreground="{DynamicResource SemiColorText2}" />
        <ComboBox Grid.Row="2"
                  ItemsSource="{Binding Modes}"
                  SelectedItem="{Binding SelectedMode}"
                  IsEnabled="{Binding !IsExporting}" />

        <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="{loc:Localize Export.OutputDirectory}" Foreground="{DynamicResource SemiColorText2}" IsVisible="{Binding IsPackageMode}" />
        <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="{loc:Localize Export.ReleaseOutput}" Foreground="{DynamicResource SemiColorText2}" IsVisible="{Binding IsReleaseMode}" />
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsPackageMode}">
            <TextBox Text="{Binding OutputDirectory}" IsEnabled="{Binding !IsExporting}" />
            <Button Grid.Column="1" Content="{loc:Localize Export.Browse}" Command="{Binding BrowseCommand}" IsEnabled="{Binding !IsExporting}" />
        </Grid>
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsReleaseMode}">
            <TextBox Text="{Binding ReleaseOutputRoot}" IsEnabled="{Binding !IsExporting}" />
            <Button Grid.Column="1" Content="{loc:Localize Export.Browse}" Command="{Binding BrowseCommand}" IsEnabled="{Binding !IsExporting}" />
        </Grid>

        <StackPanel Grid.Row="5" Spacing="5" IsVisible="{Binding IsReleaseMode}">
            <TextBlock Text="{loc:Localize Export.Version}" Foreground="{DynamicResource SemiColorText2}" />
            <TextBox Text="{Binding ReleaseVersion}" IsEnabled="{Binding !IsExporting}" />
        </StackPanel>

        <StackPanel Grid.Row="6" Spacing="5" IsVisible="{Binding IsIntegratedSample}">
            <TextBlock Text="{loc:Localize Export.IntegrationSource}" Foreground="{DynamicResource SemiColorText2}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding GalpakPath}" PlaceholderText="{loc:Localize Export.ProjectDefault}" IsEnabled="{Binding !IsExporting}" />
                <Button Grid.Column="1" Content="{loc:Localize Export.SelectGalpakButton}" Command="{Binding BrowseGalpakCommand}" IsEnabled="{Binding !IsExporting}" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="7" Margin="0,8,0,0" Spacing="4">
            <TextBlock Text="{loc:Localize Export.Package}" Foreground="{DynamicResource SemiColorText2}" />
            <TextBlock Text="{Binding PackagePath}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="8" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <Button Grid.Column="1" Content="{loc:Localize Export.Action}" Click="OnExportClicked" IsEnabled="{Binding !IsExporting}" />
        </Grid>
    </Grid>
</UserControl>
