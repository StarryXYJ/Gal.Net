<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GalNet.Editor.ViewModels" xmlns:services="using:GalNet.Editor.Services"
             xmlns:timeline="using:GalNet.Game.Controls.Timeline"
             xmlns:controls="using:GalNet.Editor.Controls"
             xmlns:loc="clr-namespace:GalNet.Editor.MarkupExtensions"
             x:Class="GalNet.Editor.Views.TimelinePanelView" x:Name="Root" x:DataType="vm:TimelinePanelViewModel"
             Background="{DynamicResource SemiColorBackground0}" Foreground="{DynamicResource SemiColorText0}">
  <UserControl.Styles>
    <Style Selector="CheckBox">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="NumericUpDown /template/ RepeatButton, NumericUpDown /template/ ButtonSpinner /template/ RepeatButton">
      <Setter Property="Delay" Value="250"/>
      <Setter Property="Interval" Value="30"/>
    </Style>
  </UserControl.Styles>
  <Grid Margin="8,6,8,4" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,4">
      <TextBlock Text="{Binding Session.Source}" Opacity="0.7" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Session.Source}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding Session.CanEdit}">
        <TextBlock Text="{loc:Localize Timeline.Duration}" VerticalAlignment="Center"/>
        <NumericUpDown Name="TimelineDurationDraft" Width="95" Minimum="{Binding Session.MinimumDuration}" Maximum="2147483647" Increment="1" FormatString="0" Value="{Binding Session.TimingDurationDraft,Mode=TwoWay}" LostFocus="OnTimingLostFocus"/>
        <TextBlock Text="FPS" VerticalAlignment="Center"/>
        <NumericUpDown Name="TimelineFpsDraft" Width="75" Minimum="1" Maximum="240" Increment="1" FormatString="0" Value="{Binding Session.TimingFrameRateDraft,Mode=TwoWay}" LostFocus="OnTimingLostFocus"/>
        <Button Name="TimelinePreviousKey" Theme="{DynamicResource EditorIconButton}" Command="{Binding PreviousKeyCommand}" ToolTip.Tip="{loc:Localize Timeline.PreviousKey}" AutomationProperties.Name="{loc:Localize Timeline.PreviousKey}"><PathIcon Width="16" Height="16" Data="M4 4H6V20H4Z M17 4L9 12L17 20L19 18L13 12L19 6Z"/></Button>
        <Button Name="TimelineNextKey" Theme="{DynamicResource EditorIconButton}" Command="{Binding NextKeyCommand}" ToolTip.Tip="{loc:Localize Timeline.NextKey}" AutomationProperties.Name="{loc:Localize Timeline.NextKey}"><PathIcon Width="16" Height="16" Data="M18 4H20V20H18Z M7 4L15 12L7 20L5 18L11 12L5 6Z"/></Button>
        <Button Name="TimelineAddKey" Theme="{DynamicResource EditorIconButton}" Command="{Binding AddKeyCommand}" ToolTip.Tip="{loc:Localize Timeline.AddKey}" AutomationProperties.Name="{loc:Localize Timeline.AddKey}"><PathIcon Width="16" Height="16" Data="{StaticResource AddIcon}"/></Button>
        <Button Name="TimelineDeleteKeys" Theme="{DynamicResource EditorIconButton}" Command="{Binding DeleteKeysCommand}" ToolTip.Tip="{loc:Localize Timeline.DeleteKeys}" AutomationProperties.Name="{loc:Localize Timeline.DeleteKeys}"><PathIcon Width="16" Height="16" Data="{StaticResource DeleteRegularIcon}"/></Button>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !Session.CanEdit}">
      <TextBlock x:Name="TimelineStatus" Text="{loc:Localize Path=Session.StatusKey}" VerticalAlignment="Center"/>
      <Button x:Name="CreateTimeline" Content="{loc:Localize Timeline.Create}" Command="{Binding CreateCommand}" IsVisible="{Binding Session.CanCreate}"/>
    </StackPanel>
    <Grid Grid.Row="2" IsVisible="{Binding Session.CanEdit}">
      <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="64"/><RowDefinition Height="6"/><RowDefinition Height="*" MinHeight="64"/></Grid.RowDefinitions>
      <Grid Name="TimelineObjectsSection" RowDefinitions="32,*" IsVisible="{Binding Session.CanEdit}"><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding #Root.TreeColumnWidth,Mode=TwoWay}" MinWidth="180" MaxWidth="600"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid ColumnDefinitions="*,Auto" Margin="4,0,6,0">
          <TextBlock Text="{loc:Localize Timeline.ObjectTracks}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Name="AddTimelineObject" Theme="{DynamicResource EditorIconButton}" ToolTip.Tip="{loc:Localize Scene.AddObject}" AutomationProperties.Name="{loc:Localize Scene.AddObject}" Click="OnAddObject"><PathIcon Width="16" Height="16" Data="{StaticResource AddIcon}"/></Button>
        </Grid>
        <timeline:TimelineCanvas Grid.Column="2" Name="TimelineRuler" IsRuler="True" Model="{Binding Session.Canvas}"/>
        <ScrollViewer Name="TimelineVertical" Grid.Row="1" Grid.ColumnSpan="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding #Root.TreeColumnWidth,Mode=TwoWay}" MinWidth="180" MaxWidth="600"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ItemsControl Name="TimelinePropertyTree" ItemsSource="{Binding Session.VisibleNodes}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="services:TimelineTreeNode">
                <Grid Name="TimelineTreeRow" Height="{Binding Height}" ColumnDefinitions="*,180" Background="Transparent" PointerPressed="OnTreeRowPointerPressed" ContextRequested="OnTreeContextRequested">
                  <Grid ColumnDefinitions="Auto,24,18,*" Height="38" VerticalAlignment="Top">
                    <Border Width="{Binding Indent}"/>
                    <Button Grid.Column="1" Name="AddTimelineProperty" Theme="{DynamicResource EditorIconButton}" Width="24" Padding="4" ToolTip.Tip="{loc:Localize Scene.AddProperty}" AutomationProperties.Name="{loc:Localize Scene.AddProperty}" IsVisible="{Binding IsObject}" IsEnabled="{Binding CanAddProperties}" Click="OnAddProperty"><PathIcon Width="14" Height="14" Data="{StaticResource AddIcon}"/></Button>
                    <ToggleButton Grid.Column="2" Name="TimelineExpand" Width="18" MinWidth="0" Height="26" Padding="0" Content="{Binding ExpandGlyph}" IsVisible="{Binding CanExpand}" IsChecked="{Binding IsExpanded,Mode=TwoWay}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Label}" ToolTip.Tip="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="3,0"/>
                  </Grid>
                  <StackPanel Grid.ColumnSpan="2" Margin="30,44,10,0" VerticalAlignment="Top" IsVisible="{Binding HasCurve}" Spacing="6">
                    <TextBlock Text="{loc:Localize Timeline.Curve.Hint}" Width="380" TextWrapping="Wrap" Opacity="0.65"/>
                    <Button Name="FitTimelineCurve" Content="{loc:Localize Timeline.Curve.Fit}" Click="OnFitCurve" HorizontalAlignment="Left"/>
                  </StackPanel>
                  <ContentControl Height="38" VerticalAlignment="Top" Grid.Column="1" Content="{Binding Value}" IsVisible="{Binding IsLeaf}">
                    <ContentControl.ContentTemplate><DataTemplate x:DataType="services:TimelineValueRow">
                      <Grid ColumnDefinitions="90,*" ColumnSpacing="4">
                        <NumericUpDown Name="TimelineValue" Value="{Binding DraftValue,Mode=TwoWay}" Increment="0.1" FormatString="G9" IsEnabled="{Binding IsEditable}" LostFocus="OnValueLostFocus">
                          <ToolTip.Tip><StackPanel MaxWidth="420"><TextBlock Text="{Binding Hint}" TextWrapping="Wrap"/><TextBlock Text="{loc:Localize Timeline.InputHint}" TextWrapping="Wrap"/></StackPanel></ToolTip.Tip>
                        </NumericUpDown>
                        <ComboBox Grid.Column="1" Name="TimelineBlendMode" SelectedIndex="{Binding BlendModeIndex,Mode=OneWay}" SelectionChanged="OnBlendModeSelectionChanged" VerticalAlignment="Center" ToolTip.Tip="{loc:Localize Timeline.ModeHint}">
                          <ComboBoxItem Content="{loc:Localize Timeline.Absolute}"/>
                          <ComboBoxItem Content="{loc:Localize Timeline.Offset}"/>
                        </ComboBox>
                      </Grid>
                    </DataTemplate></ContentControl.ContentTemplate>
                  </ContentControl>
                </Grid>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <timeline:TimelineCanvas Grid.Column="2" Name="TimelineKeys" KeyContextRequested="OnKeyContextRequested" Model="{Binding Session.Canvas}" Height="{Binding Session.Canvas.ContentHeight}" VerticalAlignment="Top"/>
            <TextBlock Text="{loc:Localize Timeline.Empty}" IsVisible="{Binding Session.HasNoRows}" TextWrapping="Wrap" Margin="4"/>
          </Grid>
        </ScrollViewer>
        <GridSplitter Grid.Column="1" Grid.RowSpan="2" Width="3" MinWidth="0" HorizontalAlignment="Center" ResizeDirection="Columns"/>
      </Grid>
      <GridSplitter Name="TimelineSectionsSplitter" Grid.Row="1" Height="6" MinHeight="0" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="{DynamicResource SemiColorBorder}" ToolTip.Tip="{loc:Localize Timeline.ResizeSections}" AutomationProperties.Name="{loc:Localize Timeline.ResizeSections}"/>
      <Grid Name="TimelineEventsSection" Grid.Row="2" RowDefinitions="32,*" IsVisible="{Binding Session.CanEdit}"><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding #Root.TreeColumnWidth,Mode=TwoWay}" MinWidth="180" MaxWidth="600"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid ColumnDefinitions="*,Auto" Margin="4,0,6,0">
          <TextBlock Text="{loc:Localize Timeline.Event.Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <controls:EntryTypePicker Grid.Column="1" Name="TimelineEventType" Width="170" Options="{Binding Session.EventTypes}" SelectedValue="layer.show" ToolTip.Tip="{loc:Localize Timeline.Event.Add}" AutomationProperties.Name="{loc:Localize Timeline.Event.Add}" Opened="OnEventTypeOpened" Closed="OnEventTypeClosed" TypeConfirmed="OnEventTypeConfirmed"/>
        </Grid>
        <timeline:TimelineCanvas Grid.Column="2" Name="TimelineEventRuler" IsRuler="True" Model="{Binding Session.Canvas}"/>
        <ScrollViewer Grid.Row="1" Grid.ColumnSpan="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding #Root.TreeColumnWidth,Mode=TwoWay}" MinWidth="180" MaxWidth="600"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ItemsControl Name="TimelineEvents" ItemsSource="{Binding Session.Events}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="services:TimelineEventRow">
                <Border Name="TimelineEventRow" Height="38" Background="Transparent" PointerPressed="OnEventPointerPressed" ContextRequested="OnEventContextRequested">
                  <Grid ColumnDefinitions="20,*,Auto" Margin="4,0,6,0">
                    <TextBlock Text="◆" Foreground="DodgerBlue" IsVisible="{Binding IsSelected}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Label}" ToolTip.Tip="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Name="EditTimelineEvent" Content="{loc:Localize Timeline.Event.Edit}" IsEnabled="{Binding CanEdit}" Click="OnEditEvent"/>
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <timeline:TimelineCanvas Grid.Column="2" Name="TimelineEventKeys" KeyContextRequested="OnEventKeyContextRequested" Model="{Binding Session.EventCanvas}" Height="{Binding Session.EventCanvas.ContentHeight}" VerticalAlignment="Top"/>
          </Grid>
        </ScrollViewer>
        <GridSplitter Grid.Column="1" Grid.RowSpan="2" Width="3" MinWidth="0" HorizontalAlignment="Center" ResizeDirection="Columns"/>
      </Grid>
    </Grid>
    <Grid Grid.Row="3" IsVisible="{Binding Session.CanEdit}"><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding #Root.TreeColumnWidth,Mode=TwoWay}" MinWidth="180" MaxWidth="600"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ScrollBar Grid.Column="2" Name="TimelineScroll" Orientation="Horizontal" Minimum="0" Maximum="{Binding Session.Duration}" SmallChange="1" LargeChange="10" Value="{Binding Session.Canvas.StartFrame,Mode=TwoWay}"/>
    </Grid>
    <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0" IsVisible="{Binding Session.CanEdit}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="{loc:Localize Uiux.Timeline.Fit}" Click="OnFitTimeline"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
        <TextBlock Name="TimelineCurrentFrame" Text="{Binding Session.CurrentFrameText}" VerticalAlignment="Center"/>
        <Slider Name="TimelineZoom" Width="140" Minimum="0.001" Maximum="64" Value="{Binding Session.Canvas.PixelsPerFrame,Mode=TwoWay}" ToolTip.Tip="{loc:Localize Timeline.Zoom}" AutomationProperties.Name="{loc:Localize Timeline.Zoom}"/>
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="5" Margin="0,4,0,0" Text="{Binding Session.Message}" IsVisible="{Binding !!Session.Message.Length}" TextWrapping="Wrap" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
  </Grid>
</UserControl>
