<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GalNet.Editor.ViewModels" xmlns:services="using:GalNet.Editor.Services"
             xmlns:loc="clr-namespace:GalNet.Editor.MarkupExtensions"
             x:Class="GalNet.Editor.Views.GameLocalizationPanelView" x:DataType="vm:GameLocalizationPanelViewModel">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://GalNet.Editor/Themes/AuthoringPanelResources.axaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBox.localizationCell">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="MaxHeight" Value="44"/>
    </Style>
    <Style Selector="TextBox.localizationCell:focus">
      <Setter Property="MinHeight" Value="76"/>
      <Setter Property="MaxHeight" Value="240"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}"/>
    </Style>
  </UserControl.Styles>
  <Grid x:Name="LocalizationColumns" ColumnDefinitions="160,6,*" Margin="8">
    <ListBox x:Name="LocalizationCategories" ItemsSource="{Binding Categories}" SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate><DataTemplate x:DataType="services:LocalizationCategory"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <GridSplitter x:Name="CategorySplitter" Grid.Column="1" ResizeDirection="Columns" HorizontalAlignment="Stretch" Background="Transparent"/>
    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
        <TextBox x:Name="LocalizationSearch" Text="{Binding Search}" PlaceholderText="{loc:Localize Uiux.I18n.Search}" MinWidth="0"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
          <ToggleButton x:Name="OnlyMissingTranslations" Theme="{StaticResource EditorIconToggleButton}" IsChecked="{Binding OnlyMissing}" ToolTip.Tip="{loc:Localize Uiux.I18n.Missing}" AutomationProperties.Name="{loc:Localize Uiux.I18n.Missing}"><PathIcon Width="16" Height="16" Data="{StaticResource FilterIcon}"/></ToggleButton>
          <Button x:Name="ManageLanguages" Theme="{StaticResource EditorIconButton}" ToolTip.Tip="{loc:Localize Uiux.I18n.Languages}" AutomationProperties.Name="{loc:Localize Uiux.I18n.Languages}">
            <PathIcon Width="16" Height="16" Data="{StaticResource PanelLanguageIcon}"/>
            <Button.Flyout><Flyout><ScrollViewer MaxHeight="480"><StackPanel Width="350" Spacing="8">
              <TextBlock Text="{loc:Localize Uiux.I18n.Languages}" FontWeight="SemiBold"/>
              <TextBlock Text="{loc:Localize Uiux.I18n.VisibleColumns}" Foreground="{DynamicResource SemiColorText2}" FontSize="12"/>
              <StackPanel x:Name="LanguageManagerRows" Spacing="2"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <AutoCompleteBox x:Name="NewLocalizationLanguage" Text="{Binding NewLanguage, Mode=TwoWay}" ItemsSource="{Binding LanguageSuggestions}" FilterMode="None" IsTextCompletionEnabled="False" MinimumPrefixLength="0" MaxDropDownHeight="220" PlaceholderText="{loc:Localize Uiux.I18n.SearchLanguage}"/>
                <Button x:Name="AddLocalizationLanguage" Grid.Column="1" Theme="{StaticResource EditorIconButton}" Command="{Binding AddLanguageCommand}" ToolTip.Tip="{loc:Localize I18n.Add}" AutomationProperties.Name="{loc:Localize I18n.Add}"><PathIcon Width="16" Height="16" Data="{StaticResource AddIcon}"/></Button>
              </Grid>
              <TextBlock Text="{loc:Localize Uiux.I18n.RemoveHint}" TextWrapping="Wrap" Foreground="{DynamicResource SemiColorText2}" FontSize="12"/>
              <StackPanel IsVisible="{Binding CanChangeDevelopmentLanguage}" Spacing="6">
                <TextBlock Text="{Binding PreviewMessage}" TextWrapping="Wrap"/>
                <Button x:Name="ApplyDevelopmentLanguage" Content="{loc:Localize I18n.ApplyDevelopment}" Command="{Binding ChangeDevelopmentLanguageCommand}"/>
              </StackPanel>
            </StackPanel></ScrollViewer></Flyout></Button.Flyout>
          </Button>
          <Button x:Name="ImportLocalization" Theme="{StaticResource EditorIconButton}" IsEnabled="{Binding !ApplyImportCommand.IsRunning}" ToolTip.Tip="{loc:Localize Exchange.Import}" AutomationProperties.Name="{loc:Localize Exchange.Import}">
            <PathIcon Width="16" Height="16" Data="{StaticResource PanelImportIcon}"/>
            <Button.Flyout><Flyout><StackPanel Width="260" Spacing="8">
              <TextBlock Text="{loc:Localize Uiux.I18n.Exchange}" FontWeight="SemiBold"/>
              <ComboBox x:Name="ExchangeLanguage" ItemsSource="{Binding Languages}" SelectedItem="{Binding ExchangeLanguage}" HorizontalAlignment="Stretch"/>
              <Button x:Name="ChooseLocalizationImport" Content="{loc:Localize Exchange.Import}" Command="{Binding PreviewImportCommand}"/>
            </StackPanel></Flyout></Button.Flyout>
          </Button>
          <Button x:Name="ExportOptions" Theme="{StaticResource EditorIconButton}" ToolTip.Tip="{loc:Localize Exchange.Export}" AutomationProperties.Name="{loc:Localize Exchange.Export}">
            <PathIcon Width="16" Height="16" Data="{StaticResource PanelExportIcon}"/>
            <Button.Flyout><Flyout><StackPanel Width="260" Spacing="8" IsEnabled="{Binding !ApplyImportCommand.IsRunning}">
              <TextBlock Text="{loc:Localize Uiux.I18n.Exchange}" FontWeight="SemiBold"/>
              <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding ExchangeLanguage}" HorizontalAlignment="Stretch"/>
              <CheckBox Content="{loc:Localize Exchange.All}" IsChecked="{Binding ExportAll}"/>
              <CheckBox Content="{loc:Localize Exchange.Runtime}" IsChecked="{Binding ExportRuntime}"/>
              <Button x:Name="ExportLocalization" Content="{loc:Localize Exchange.Export}" Command="{Binding ExportCommand}"/>
            </StackPanel></Flyout></Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="1" IsVisible="{Binding HasImport}" IsEnabled="{Binding !ApplyImportCommand.IsRunning}" Spacing="6">
        <WrapPanel><CheckBox x:Name="AllowEmptyImport" Content="{loc:Localize Exchange.AllowEmpty}" IsChecked="{Binding AllowEmpty}"/>
          <Button x:Name="ApplyLocalizationImport" Content="{loc:Localize Exchange.Apply}" Command="{Binding ApplyImportCommand}" Margin="8,0"/>
          <Button Content="{loc:Localize Exchange.Cancel}" Command="{Binding CancelImportCommand}"/>
        </WrapPanel>
        <ListBox x:Name="LocalizationImportRows" ItemsSource="{Binding ImportRows}" MaxHeight="160">
          <ListBox.ItemTemplate><DataTemplate x:DataType="vm:LocalizationImportRowViewModel"><Grid ColumnDefinitions="Auto,*,*,Auto" ColumnSpacing="8">
            <CheckBox IsChecked="{Binding Include}" IsEnabled="{Binding CanInclude}"/>
            <TextBlock Grid.Column="1" Text="{Binding Source}" ToolTip.Tip="{Binding ExportedSource}" TextWrapping="Wrap" MaxWidth="300"/>
            <TextBlock Grid.Column="2" Text="{Binding Translation}" TextWrapping="Wrap" MaxWidth="300"/>
            <TextBlock Grid.Column="3" Text="{Binding Status}" TextWrapping="Wrap"/>
          </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
      <StackPanel Grid.Row="2" Spacing="4">
        <ComboBox x:Name="CompactLocalizationCategory" ItemsSource="{Binding Categories}" SelectedItem="{Binding Selected}" IsVisible="False" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="services:LocalizationCategory"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{loc:Localize I18n.Incomplete}" IsVisible="{Binding Incomplete}" TextWrapping="Wrap"/>
      </StackPanel>
      <Grid Grid.Row="3" Background="{DynamicResource SemiColorBackground0}">
        <ScrollViewer x:Name="LocalizationTableScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" ScrollChanged="OnTableScroll">
          <Grid RowDefinitions="Auto,*">
            <Grid x:Name="LocalizationHeader" ClipToBounds="True">
              <StackPanel x:Name="LanguageHeaders" Orientation="Horizontal" Margin="188,0,0,0"/>
              <Border x:Name="ContextHeader" Width="188" HorizontalAlignment="Left" Background="{DynamicResource SemiColorBackground0}" ZIndex="1"/>
            </Grid>
            <ListBox x:Name="LocalizationRows" Grid.Row="1" ItemsSource="{Binding Rows}" Padding="0" HorizontalAlignment="Left">
              <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
            </ListBox>
          </Grid>
        </ScrollViewer>
        <TextBlock Text="{loc:Localize Uiux.Panel.NoResults}" IsVisible="{Binding !HasRows}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16" Foreground="{DynamicResource SemiColorText2}"/>
      </Grid>
      <TextBlock Grid.Row="4" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
    </Grid>
  </Grid>
</UserControl>
