<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GalNet.Editor.ViewModels" xmlns:services="using:GalNet.Editor.Services"
             xmlns:loc="clr-namespace:GalNet.Editor.MarkupExtensions"
             xmlns:globalization="clr-namespace:System.Globalization;assembly=System.Runtime"
             x:Class="GalNet.Editor.Views.VariablesPanelView" x:Name="Root" x:DataType="vm:VariablesPanelViewModel">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://GalNet.Editor/Themes/AuthoringPanelResources.axaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12" RowSpacing="8">
    <TabControl x:Name="ScopeTabs" Height="44" SelectedIndex="{Binding ScopeIndex}">
      <TabItem Header="{loc:Localize Variables.Player}" />
      <TabItem Header="{loc:Localize Variables.Save}" />
    </TabControl>
    <TextBlock Grid.Row="1" Text="{loc:Localize ScopeHintKey}" TextWrapping="Wrap" Opacity="0.75" />
    <Grid x:Name="VariableColumns" Grid.Row="2" ColumnDefinitions="220,10,*">
      <Grid RowDefinitions="Auto,*" RowSpacing="6">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
          <TextBox Text="{Binding Search}" PlaceholderText="{loc:Localize Uiux.Panel.Search}" MinWidth="0"/>
          <Button x:Name="AddVariableButton" Grid.Column="1" Theme="{StaticResource EditorIconButton}" Command="{Binding AddVariableCommand}" ToolTip.Tip="{loc:Localize Variables.Add}" AutomationProperties.Name="{loc:Localize Variables.Add}" Click="OnVariableAdded"><PathIcon Width="16" Height="16" Data="{StaticResource AddIcon}"/></Button>
        </Grid>
        <Grid Grid.Row="1">
          <ListBox x:Name="VariableRows" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
            <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
            <ListBox.ItemTemplate><DataTemplate x:DataType="vm:VariableDefinitionRow"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/><TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Description}"/></Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{loc:Localize Uiux.Panel.NoResults}" IsVisible="{Binding !HasRows}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8" TextWrapping="Wrap" Foreground="{DynamicResource SemiColorText2}"/>
        </Grid>
      </Grid>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Grid Grid.Column="2" RowDefinitions="Auto,*">
      <StackPanel Grid.RowSpan="2" IsVisible="{Binding !HasSelection}" VerticalAlignment="Center" Margin="8" Spacing="8">
        <TextBlock Text="{loc:Localize Uiux.Panel.SelectItem}" TextWrapping="Wrap" Foreground="{DynamicResource SemiColorText2}"/>
        <TextBlock Text="{loc:Localize Uiux.Panel.MissingSelection}" IsVisible="{Binding MissingSelection}" TextWrapping="Wrap"/>
        <Button Content="{loc:Localize Variables.Revert}" Command="{Binding RevertCommand}" IsVisible="{Binding MissingSelection}"/>
      </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasSelection}" Margin="0,0,0,6">
            <Button x:Name="ApplyVariableButton" Theme="{StaticResource EditorIconButton}" Command="{Binding ApplyCommand}" ToolTip.Tip="{loc:Localize Variables.Apply}" AutomationProperties.Name="{loc:Localize Variables.Apply}"><PathIcon Width="16" Height="16" Data="{StaticResource PanelApplyIcon}"/></Button>
            <Button Theme="{StaticResource EditorIconButton}" Command="{Binding RevertCommand}" ToolTip.Tip="{loc:Localize Variables.Revert}" AutomationProperties.Name="{loc:Localize Variables.Revert}"><PathIcon Width="16" Height="16" Data="{StaticResource ResetIcon}"/></Button>
            <Button x:Name="DeleteVariableButton" Theme="{StaticResource EditorIconButton}" Command="{Binding DeleteVariableCommand}" ToolTip.Tip="{loc:Localize Variables.Delete}" AutomationProperties.Name="{loc:Localize Variables.Delete}"><PathIcon Width="16" Height="16" Data="{StaticResource DeleteRegularIcon}"/></Button>
            <Button Theme="{StaticResource EditorIconButton}" Command="{Binding CheckReferencesCommand}" ToolTip.Tip="{loc:Localize Variables.References}" AutomationProperties.Name="{loc:Localize Variables.References}"><PathIcon Width="16" Height="16" Data="{StaticResource PanelNavigateIcon}"/></Button>
            <TextBlock Text="{loc:Localize Uiux.Panel.Unapplied}" IsVisible="{Binding HasChanges}" VerticalAlignment="Center" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap"/>
          </StackPanel>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasSelection}">
        <StackPanel Spacing="8" IsEnabled="{Binding HasSelection}">
          <TextBlock Text="{loc:Localize Variables.Name}"/><TextBox x:Name="NameInput" Text="{Binding DraftName}" />
          <TextBlock Text="{loc:Localize Variables.Type}"/>
          <ComboBox x:Name="TypeInput" ItemsSource="{Binding Types}" SelectedItem="{Binding DraftType}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:VariableTypeOption"><TextBlock Text="{loc:Localize LabelKey}"/></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{loc:Localize Variables.Default}"/>
          <Grid>
            <TextBox x:Name="DefaultInput" IsVisible="{Binding IsTextDefault}" Text="{Binding StringDefaultText}" />
            <NumericUpDown x:Name="NumericDefaultInput" IsVisible="{Binding IsNumericDefault}"
                           Text="{Binding NumericDefaultText, Mode=TwoWay}" Increment="{Binding DefaultIncrement}"
                           NumberFormat="{x:Static globalization:NumberFormatInfo.InvariantInfo}" ParsingNumberStyle="Float"
                           AutomationProperties.Name="{loc:Localize Variables.Default}" />
            <CheckBox x:Name="BooleanDefaultInput" IsVisible="{Binding IsBooleanDefault}"
                      IsChecked="{Binding DraftBoolean, Mode=TwoWay}" AutomationProperties.Name="{loc:Localize Variables.Default}" />
          </Grid>
          <TextBlock Text="{loc:Localize DefaultHintKey}" Opacity="0.65" TextWrapping="Wrap"/>
          <TextBlock Text="{loc:Localize Variables.Description}"/><TextBox x:Name="DescriptionInput" Text="{Binding DraftDescription}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/>

          <TextBlock Text="{loc:Localize Variables.ReferenceHint}" TextWrapping="Wrap" Opacity="0.65"/>
          <ItemsControl ItemsSource="{Binding References}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="services:VariableReference"><StackPanel Margin="0,4"><Button Background="Transparent" Command="{Binding #Root.DataContext.NavigateReferenceCommand}" CommandParameter="{Binding}" HorizontalContentAlignment="Left"><TextBlock Text="{Binding Location}" TextWrapping="Wrap"/></Button><TextBlock Text="{loc:Localize Variables.Certain}" IsVisible="{Binding Certain}"/><TextBlock Text="{loc:Localize Variables.Possible}" IsVisible="{Binding !Certain}" Opacity="0.65"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </ScrollViewer>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="3" Text="{Binding MessageText}" TextWrapping="Wrap" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
  </Grid>
</UserControl>
