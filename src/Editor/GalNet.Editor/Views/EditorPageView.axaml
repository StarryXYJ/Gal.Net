<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GalNet.Editor.ViewModels"
             xmlns:dock="using:Dock.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="GalNet.Editor.Views.EditorPageView"
             x:DataType="vm:EditorPageViewModel">

    <Grid RowDefinitions="*,Auto,Auto" Background="{DynamicResource SemiColorBackground0}">
        <DockControl Name="DockHost" Grid.Row="0"
                     Margin="0,30,0,0"
                     Layout="{Binding Layout}"
                     Background="{DynamicResource SemiColorBackground0}" />

        <Border Grid.Row="1" IsVisible="{Binding HasExternalIssue}" Padding="12,8" Background="{DynamicResource SemiColorBackground1}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3"><TextBlock Text="{Binding ExternalStatus}" TextWrapping="Wrap"/><TextBlock Text="{Binding ExternalDetails}" TextWrapping="Wrap" FontSize="11"/></StackPanel>
                <Button Grid.Column="1" Command="{Binding RetryExternalChangesCommand}" Content="{Binding L[External.Retry]}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Command="{Binding ReloadExternalChangesCommand}" IsEnabled="{Binding CanReloadExternal}" Content="{Binding L[External.Reload]}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Border Grid.Row="2"
                Background="{DynamicResource SemiColorBackground1}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,6"
                x:DataType="vm:EditorPageViewModel">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}"
                           FontSize="12"
                           Foreground="{DynamicResource SemiColorText2}" />
                <TextBlock Grid.Column="1" Text="{Binding SaveStatus}" FontSize="12" VerticalAlignment="Center" />
                <Button Grid.Column="2" Command="{Binding ShowProblemsCommand}" Padding="4,0" MinHeight="0" Background="Transparent">
                    <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding DraftCount}"/><TextBlock Text="{Binding Problems.Status}"/><TextBlock Text="{Binding Problems.Count}"/></StackPanel>
                </Button>
                <TextBlock Grid.Column="3"
                           Text="{Binding ProjectName}"
                           FontSize="12"
                           Foreground="{DynamicResource SemiColorText3}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
