<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GalNet.Editor.MarkupExtensions"
             xmlns:vm="using:GalNet.Editor.ViewModels"
             xmlns:services="using:GalNet.Editor.Services"
             xmlns:forms="using:GalNet.Game.Controls.Forms"
             x:Class="GalNet.Editor.Views.ProjectSettingsPanelView"
             x:DataType="vm:ProjectSettingsPanelViewModel"
             Background="{DynamicResource SemiColorBackground0}">
    <UserControl.Styles><StyleInclude Source="/Controls/AuthorFormStyles.axaml" /></UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <TextBlock Grid.Row="0" Text="{loc:Localize Settings.Project.Title}"
                   FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource SemiColorText0}"
                   Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Localize Settings.Project.Name}" />
                <TextBox Name="ProjectNameInput" Text="{Binding ProjectName}" />
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:ConfigurationSectionEditor">
                            <Expander Header="{Binding Id}" IsExpanded="True" HorizontalAlignment="Stretch">
                                <forms:DtoEditorHost Item="{Binding Item}" Registry="{Binding Registry}" />
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Expander Header="{loc:Localize Debug.Configuration}">
                    <StackPanel Spacing="6">
                        <TextBox Text="{Binding DebugExecutable}" PlaceholderText="{loc:Localize Debug.Executable}"/>
                        <TextBox Text="{Binding DebugArguments}" PlaceholderText="{loc:Localize Debug.Arguments}" AcceptsReturn="True" MinHeight="50"/>
                        <TextBox Text="{Binding DebugWorkingDirectory}" PlaceholderText="{loc:Localize Debug.WorkingDirectory}"/>
                        <Button Content="{loc:Localize Debug.SaveConfiguration}" Command="{Binding SaveDebugConfigurationCommand}"/>
                        <TextBlock Text="{Binding DebugConfigurationMessage}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0" Text="{Binding IsDirtyText}"
                       Foreground="{DynamicResource SemiColorText2}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="{loc:Localize Settings.Project.Cancel}" Command="{Binding CancelDraftCommand}" />
                <Button Name="ApplySettingsButton"
                        Content="{loc:Localize Settings.Project.Apply}"
                        Command="{Binding SaveSettingsCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
