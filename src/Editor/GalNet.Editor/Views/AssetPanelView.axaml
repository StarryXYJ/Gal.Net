<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GalNet.Editor.ViewModels" xmlns:model="using:GalNet.Editor.Models"
             xmlns:loc="clr-namespace:GalNet.Editor.MarkupExtensions"
             x:Class="GalNet.Editor.Views.AssetPanelView" x:Name="Root" x:DataType="vm:AssetPanelViewModel"
             Background="{DynamicResource SemiColorBackground0}" KeyDown="OnBrowserKeyDown">
  <UserControl.Styles>
    <Style Selector="Border.drop-target"><Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}" /><Setter Property="BorderThickness" Value="2" /></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="4" RowSpacing="4">
    <WrapPanel Grid.Row="1">
      <Button Content="{loc:Localize Files.Import}" Command="{Binding ImportCommand}" Margin="0,0,6,0" />
      <Button Content="{loc:Localize Files.NewText}" Command="{Binding NewFileCommand}" Margin="0,0,6,0" />
      <Button Content="{loc:Localize Asset.Menu.NewFolder}" Command="{Binding NewFolderCommand}" Margin="0,0,6,0" />
      <ComboBox Name="FileTypeFilter" SelectedIndex="{Binding TypeFilterIndex}" MinWidth="110" Margin="0,0,6,0">
        <ComboBoxItem Content="{loc:Localize Uiux.Files.All}"/><ComboBoxItem Content="{loc:Localize Uiux.Files.Images}"/>
        <ComboBoxItem Content="{loc:Localize Uiux.Files.Audio}"/><ComboBoxItem Content="{loc:Localize Uiux.Files.Video}"/>
        <ComboBoxItem Content="{loc:Localize Uiux.Files.Groups}"/><ComboBoxItem Content="{loc:Localize Uiux.Files.Other}"/><ComboBoxItem Content="{loc:Localize Uiux.Files.Folders}"/>
      </ComboBox>
      <CheckBox Content="{loc:Localize Uiux.Files.List}" IsChecked="{Binding IsListView}" IsCheckedChanged="OnListViewChanged"/>
      <TextBlock Text="{loc:Localize Uiux.Files.SearchScope}" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource SemiColorText2}"/>
    </WrapPanel>
    <Grid ColumnDefinitions="Auto,Auto,Auto,*,220" ColumnSpacing="4">
      <Button Theme="{DynamicResource EditorIconButton}" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip.Tip="{loc:Localize Files.Back}" AutomationProperties.Name="{loc:Localize Files.Back}"><PathIcon Width="16" Height="16" Data="M14 4L6 12L14 20L16 18L10 12L16 6Z"/></Button>
      <Button Grid.Column="1" Theme="{DynamicResource EditorIconButton}" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip.Tip="{loc:Localize Files.Forward}" AutomationProperties.Name="{loc:Localize Files.Forward}"><PathIcon Width="16" Height="16" Data="M8 4L16 12L8 20L6 18L12 12L6 6Z"/></Button>
      <Button Grid.Column="2" Theme="{DynamicResource EditorIconButton}" Command="{Binding UpCommand}" IsEnabled="{Binding CanGoUp}" ToolTip.Tip="{loc:Localize Files.Up}" AutomationProperties.Name="{loc:Localize Files.Up}"><PathIcon Width="16" Height="16" Data="M4 14L12 6L20 14L18 16L12 10L6 16Z"/></Button>
      <Border x:Name="AddressBar" Grid.Column="3" BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}" CornerRadius="4" Background="{DynamicResource SemiColorBackground0}" PointerPressed="OnAddressPressed">
        <Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding !IsEditingPath}" HorizontalAlignment="Left">
            <ItemsControl ItemsSource="{Binding Breadcrumbs}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:FileBreadcrumb">
                <Border DragDrop.AllowDrop="True" DragDrop.DragOver="OnTargetDragOver" DragDrop.DragLeave="OnTargetDragLeave" DragDrop.Drop="OnTargetDrop">
                  <Button Content="{Binding Name}" Command="{Binding #Root.DataContext.NavigateDirectoryCommand}" CommandParameter="{Binding Path}" Padding="6,4" Background="Transparent" />
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBox x:Name="PathInput" Text="{Binding PathText,Mode=TwoWay}" IsVisible="{Binding IsEditingPath}" PlaceholderText="{loc:Localize Files.Path}" KeyDown="OnPathKeyDown" LostFocus="OnPathLostFocus" />
        </Grid>
      </Border>
      <Grid Grid.Column="4">
        <TextBox x:Name="SearchInput" Text="{Binding SearchText,Mode=TwoWay}" Padding="8,5,30,5" PlaceholderText="{loc:Localize Files.Search}" />
        <Button x:Name="ClearSearchButton" Content="×" Width="20" Height="20" MinHeight="0" MinWidth="0" Padding="0" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" IsVisible="{Binding HasSearch}" Command="{Binding ClearSearchCommand}" ToolTip.Tip="{loc:Localize Files.ClearSearch}" />
      </Grid>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="180,5,*">
      <TreeView x:Name="DirectoryTree" ItemsSource="{Binding Directories}" SelectedItem="{Binding SelectedDirectory,Mode=TwoWay}">
        <TreeView.Styles><Style Selector="TreeViewItem"><Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded,Mode=TwoWay}" /></Style></TreeView.Styles>
        <TreeView.DataTemplates>
          <TreeDataTemplate DataType="model:ProjectDirectoryNode" ItemsSource="{Binding Children}">
            <Border Padding="3" DragDrop.AllowDrop="True" DragDrop.DragOver="OnTargetDragOver" DragDrop.DragLeave="OnTargetDragLeave" DragDrop.Drop="OnTargetDrop"><StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Data="{Binding IconGeometry}" Width="16" Height="16"/><TextBlock Text="{Binding Name}" /></StackPanel></Border>
          </TreeDataTemplate>
        </TreeView.DataTemplates>
      </TreeView>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" HorizontalAlignment="Stretch" />
      <ListBox x:Name="FileGrid" Grid.Column="2" ItemsSource="{Binding Entries}" SelectionMode="Multiple" SelectedItems="{Binding SelectedEntries,Mode=OneWay}" DragDrop.AllowDrop="True" DragDrop.DragOver="OnGridDragOver" DragDrop.Drop="OnGridDrop">
        <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
        <ListBox.ContextMenu><ContextMenu>
          <MenuItem Header="{loc:Localize Files.Import}" Command="{Binding ImportCommand}" />
          <MenuItem Header="{loc:Localize Asset.Menu.Paste}" Command="{Binding PasteCommand}" />
          <MenuItem Header="{loc:Localize Files.New}">
            <MenuItem Header="{loc:Localize Asset.Menu.NewFolder}" Command="{Binding NewFolderCommand}" />
            <MenuItem Header="{loc:Localize Files.NewText}" Command="{Binding NewFileCommand}" />
            <MenuItem Header="{loc:Localize Variants.New}" Command="{Binding NewVariantsCommand}" />
          </MenuItem>
          <MenuItem Header="{loc:Localize Asset.Menu.Refresh}" Command="{Binding RefreshCommand}" />
          <MenuItem Header="{loc:Localize Asset.Menu.OpenInExplorer}" Command="{Binding ShowInExplorerCommand}" />
        </ContextMenu></ListBox.ContextMenu>
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate x:DataType="model:ProjectFileItem">
          <Border Width="{Binding #Root.DataContext.ItemWidth}" Height="{Binding #Root.DataContext.ItemHeight}" Margin="2" Padding="5" ToolTip.Tip="{Binding Name}" DoubleTapped="OnEntryDoubleTapped" PointerPressed="OnEntryPressed" PointerMoved="OnEntryMoved" DragDrop.AllowDrop="True" DragDrop.DragOver="OnTargetDragOver" DragDrop.DragLeave="OnTargetDragLeave" DragDrop.Drop="OnTargetDrop">
            <Border.ContextMenu><ContextMenu>
              <MenuItem Header="{loc:Localize Asset.Menu.Open}" Command="{Binding #Root.DataContext.OpenCommand}" CommandParameter="{Binding}" />
              <MenuItem Header="{loc:Localize Asset.Menu.Rename}" Command="{Binding #Root.DataContext.BeginRenameCommand}" CommandParameter="{Binding}" IsEnabled="{Binding #Root.DataContext.CanRename}" />
              <MenuItem Header="{loc:Localize Asset.Menu.Copy}" Command="{Binding #Root.DataContext.CopySelectedCommand}" IsEnabled="{Binding #Root.DataContext.CanChangeSelection}" />
              <MenuItem Header="{loc:Localize Asset.Menu.Cut}" Command="{Binding #Root.DataContext.CutSelectedCommand}" IsEnabled="{Binding #Root.DataContext.CanChangeSelection}" />
              <MenuItem Header="{loc:Localize Asset.Menu.Paste}" Command="{Binding #Root.DataContext.PasteCommand}" />
              <MenuItem Header="{loc:Localize Files.Duplicate}" Command="{Binding #Root.DataContext.DuplicateCommand}" IsEnabled="{Binding #Root.DataContext.CanChangeSelection}" />
              <MenuItem Header="{loc:Localize Files.Import}" Command="{Binding #Root.DataContext.ImportCommand}" />
              <MenuItem Header="{loc:Localize Files.New}">
                <MenuItem Header="{loc:Localize Asset.Menu.NewFolder}" Command="{Binding #Root.DataContext.NewFolderCommand}" />
                <MenuItem Header="{loc:Localize Files.NewText}" Command="{Binding #Root.DataContext.NewFileCommand}" />
                <MenuItem Header="{loc:Localize Variants.New}" Command="{Binding #Root.DataContext.NewVariantsCommand}" />
              </MenuItem>
              <MenuItem Header="{loc:Localize Asset.Menu.Refresh}" Command="{Binding #Root.DataContext.RefreshCommand}" />
              <Separator />
              <MenuItem Header="{loc:Localize Asset.Menu.Delete}" Command="{Binding #Root.DataContext.DeleteSelectedCommand}" IsEnabled="{Binding #Root.DataContext.CanChangeSelection}" />
              <MenuItem Header="{loc:Localize Asset.Menu.OpenInExplorer}" Command="{Binding #Root.DataContext.ShowInExplorerCommand}" CommandParameter="{Binding}" />
            </ContextMenu></Border.ContextMenu>
            <Grid RowDefinitions="*,Auto">
              <Border Background="{DynamicResource SemiColorFill0}" CornerRadius="4" IsVisible="{Binding !#Root.DataContext.IsListView}"><Grid><PathIcon Data="{Binding IconGeometry}" Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image Source="{Binding Thumbnail}" Stretch="Uniform" /></Grid></Border>
              <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding #Root.DataContext.IsListView}"><PathIcon Data="{Binding IconGeometry}" Width="16" Height="16"/><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SemiColorText2}" FontSize="11"/></StackPanel>
              <TextBlock Grid.Row="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" IsVisible="{Binding !IsRenaming}" />
              <TextBox Grid.Row="1" Text="{Binding #Root.DataContext.RenameText,Mode=TwoWay}" IsVisible="{Binding IsRenaming}" AttachedToVisualTree="OnRenameAttached" PropertyChanged="OnRenamePropertyChanged" KeyDown="OnRenameKeyDown" LostFocus="OnRenameLostFocus" />
            </Grid>
          </Border>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Column="2" Text="{Binding EmptyMessage}" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12" IsHitTestVisible="False"/>
    </Grid>
    <Border Grid.Row="3" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}" IsVisible="{Binding IsDeletePending}">
      <StackPanel Spacing="4">
        <TextBlock Text="{loc:Localize Files.DeleteQuestion}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding DeleteDetails}" TextWrapping="Wrap" MaxHeight="90" />
        <CheckBox Content="{loc:Localize Files.DeleteGroups}" IsChecked="{Binding DeleteLinkedGroups}" />
        <CheckBox Content="{loc:Localize Files.AllowCandidates}" IsChecked="{Binding AllowCandidateReferences}" />
        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="{loc:Localize Asset.Menu.Delete}" Command="{Binding ConfirmDeleteCommand}" /><Button Content="{loc:Localize Files.Cancel}" Command="{Binding CancelDeleteCommand}" /></StackPanel>
      </StackPanel>
    </Border>
    <Grid Grid.Row="4" ColumnDefinitions="*,120,Auto" RowDefinitions="Auto,Auto">
      <TextBlock Text="{Binding SelectionInformation}" TextTrimming="CharacterEllipsis" />
      <Slider Grid.Column="1" Minimum="48" Maximum="144" Value="{Binding ThumbnailSize}" ToolTip.Tip="{loc:Localize Files.ThumbnailSize}" />
      <Button x:Name="RefreshButton" Grid.Column="2" Theme="{DynamicResource EditorIconButton}" Command="{Binding RefreshCommand}" ToolTip.Tip="{loc:Localize Asset.Menu.Refresh}" AutomationProperties.Name="{loc:Localize Asset.Menu.Refresh}"><PathIcon Width="16" Height="16" Data="M20 4V11H13L16 8A6 6 0 1 0 18 14H20A8 8 0 1 1 17.4 6.6Z"/></Button>
      <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding ErrorText}" Foreground="{DynamicResource SemiColorDanger}" TextWrapping="Wrap" />
    </Grid>
  </Grid>
</UserControl>
