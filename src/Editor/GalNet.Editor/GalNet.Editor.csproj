<Project Sdk="Microsoft.NET.SDK">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <DefaultContractsOutputRoot Condition="'$(Benchmark)' == 'true'">benchmark/</DefaultContractsOutputRoot>
        <DefaultContractsOutputRoot Condition="'$(PublishProfile)' == 'WindowsReadyToRun' And '$(Benchmark)' != 'true'">publish/WindowsReadyToRun/</DefaultContractsOutputRoot>
        <DefaultContractsOutputRoot Condition="'$(PublishProfile)' == 'Desktop' And '$(Benchmark)' != 'true'">publish/Desktop/$(RuntimeIdentifier)/</DefaultContractsOutputRoot>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GalNet.Editor.Tests" />
    <ProjectReference Include="../../Infrastructure/GalNet.Media.LibVlc/GalNet.Media.LibVlc.csproj" />
        <Folder Include="Models\" />
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Dock.Avalonia" />
        <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
        <PackageReference Include="Dock.Model" />
        <PackageReference Include="Dock.Model.Avalonia" />
        <PackageReference Include="Dock.Model.Mvvm" />
        <PackageReference Include="Dock.Settings" />
        <PackageReference Include="DynamicLocalization.Core" />
        <PackageReference Include="Irihi.Ursa" />
        <PackageReference Include="Irihi.Ursa.Themes.Semi" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Semi.Avalonia.ColorPicker" />
        <PackageReference Include="Semi.Avalonia.Dock" />
        <PackageReference Include="Serilog" />
        <PackageReference Include="Serilog.Sinks.Console" />
        <PackageReference Include="Serilog.Sinks.Debug" />
        <PackageReference Include="VideoLAN.LibVLC.Windows" Condition="('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))) Or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Localization\*.json" />
      <ProjectReference Include="..\GalNet.Editor.DefaultContracts\GalNet.Editor.DefaultContracts.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="OutputPath;OutDir" />
      <Content Include="..\GalNet.Editor.DefaultContracts\bin\$(DefaultContractsOutputRoot)$(Configuration)\net10.0\GalNet.Project.Contracts.dll"
               Link="DefaultContracts\GalNet.Project.Contracts.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="..\GalNet.Editor.DefaultContracts\bin\$(DefaultContractsOutputRoot)$(Configuration)\net10.0\GalNet.Core.dll"
               Link="DefaultContracts\GalNet.Core.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="..\GalNet.Editor.DefaultContracts\bin\$(DefaultContractsOutputRoot)$(Configuration)\net10.0\GalNet.Contracts.Builtins.dll"
               Link="DefaultContracts\GalNet.Contracts.Builtins.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\GalNet.Editor.Abstraction\GalNet.Editor.Abstraction.csproj" />
      <ProjectReference Include="..\..\Shared\GalNet.Assets\GalNet.Assets.csproj" />
      <ProjectReference Include="..\..\Presentation\GalNet.Avalonia.Controls\GalNet.Avalonia.Controls.csproj" />
      <ProjectReference Include="..\..\Presentation\GalNet.Avalonia.Rendering\GalNet.Avalonia.Rendering.csproj" />
      <ProjectReference Include="..\..\Presentation\GalNet.Avalonia.GameView\GalNet.Avalonia.GameView.csproj" Aliases="GameViewAssembly" />
      <ProjectReference Include="..\..\Shared\GalNet.Core\GalNet.Core.csproj" />
      <ProjectReference Include="..\..\Shared\GalNet.Contracts.Builtins\GalNet.Contracts.Builtins.csproj" />
      <ProjectReference Include="..\GalNet.Editor.Shared\GalNet.Editor.Shared.csproj" />
      <ProjectReference Include="..\..\Shared\GalNet.Presentation.Abstractions\GalNet.Presentation.Abstractions.csproj" />
      <ProjectReference Include="..\..\Shared\GalNet.Runtime\GalNet.Runtime.csproj" />
      <ProjectReference Include="..\..\Infrastructure\GalNet.Storage.FileSystem\GalNet.Storage.FileSystem.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\EditorPageView.axaml.cs">
        <DependentUpon>EditorPageView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\ProjectSettingsPanelView.axaml.cs">
        <DependentUpon>ProjectSettingsPanelView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\EditorSettingsPanelView.axaml.cs">
        <DependentUpon>EditorSettingsPanelView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\ProjectSettingsWindow.axaml.cs">
        <DependentUpon>ProjectSettingsWindow.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\EditorSettingsWindow.axaml.cs">
        <DependentUpon>EditorSettingsWindow.axaml</DependentUpon>
      </Compile>
      <Compile Update="Controls\BranchOptionListEditorControl.axaml.cs">
        <DependentUpon>BranchOptionListEditorControl.axaml</DependentUpon>
      </Compile>
      <Compile Update="Inspector\Views\InspectorHostView.axaml.cs">
        <DependentUpon>InspectorHostView.axaml</DependentUpon>
      </Compile>
    </ItemGroup>
  <ItemGroup Condition="'$(Benchmark)' == 'true'">
    <ProjectReference Include="../../Shared/GalNet.Diagnostics/GalNet.Diagnostics.csproj" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../../Shared/GalNet.GameHost/GalNet.GameHost.csproj" /></ItemGroup>
</Project>
