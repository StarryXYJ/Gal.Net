<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GalNet.Editor.ViewModels"
             x:Class="GalNet.Editor.Controls.VariableListEditorControl"
             x:Name="Root"
             x:DataType="vm:VariableListEditorViewModel">
    <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VariableEditorItemViewModel">
                <Border Margin="0,4" Padding="8" CornerRadius="6"
                        Background="{DynamicResource SemiColorBackground1}"
                        BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,80,*,*" ColumnSpacing="8">
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedType}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding DefaultValueText}" VerticalAlignment="Center" />
                        <Grid Grid.Column="3" IsVisible="{Binding #Root.DataContext.ShowCurrentValue}"
                              IsEnabled="{Binding CanEditCurrentValue}">
                            <CheckBox IsVisible="{Binding IsBool}" IsChecked="{Binding CurrentBoolValue}" />
                            <NumericUpDown IsVisible="{Binding IsInt}" Value="{Binding CurrentIntValue}" />
                            <NumericUpDown IsVisible="{Binding IsFloat}" Increment="0.1" Value="{Binding CurrentFloatValue}" />
                            <TextBox IsVisible="{Binding IsString}" Text="{Binding CurrentStringValue}" />
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
