<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GalNet.Editor.Controls" xmlns:forms="using:GalNet.Game.Controls.Forms" x:Class="GalNet.Editor.Controls.AssetPicker" x:Name="Root">
  <UserControl.Styles>
    <Style Selector="Border.resource-card"><Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" /><Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" /><Setter Property="BorderThickness" Value="1" /></Style>
  </UserControl.Styles>
  <Button Name="PickerButton" HorizontalContentAlignment="Stretch" Background="{DynamicResource SemiColorFill0}">
    <Button.Flyout><Flyout Placement="Bottom" Opened="OnFlyoutOpened" Closed="OnFlyoutClosed"><Border Width="520" Height="450" Padding="10" Background="{DynamicResource SemiColorBackground0}" CornerRadius="8"><forms:ResourcePickerPanel Name="PickerPanel"/></Border></Flyout></Button.Flyout>
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><TextBlock Text="{Binding DisplayIcon, ElementName=Root}" FontSize="16" /><TextBlock Grid.Column="1" Text="{Binding DisplayText, ElementName=Root}" TextTrimming="CharacterEllipsis" /></Grid>
  </Button>
</UserControl>
