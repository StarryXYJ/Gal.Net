<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:GalNet.Editor.Controls"
             xmlns:loc="using:GalNet.Editor.MarkupExtensions"
             x:Class="GalNet.Editor.Controls.EntryTypePicker"
             x:Name="Root"
             HorizontalContentAlignment="Stretch"
             Focusable="True">
    <Grid>
        <ToggleButton x:Name="OpenButton"
                      IsChecked="{Binding #PickerPopup.IsOpen, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding SelectedDisplayName,ElementName=Root}" IsVisible="{Binding !#Root.IsButtonMode}"
                           HorizontalAlignment="Left" TextAlignment="Left" />
                <TextBlock Text="{Binding ButtonLabel,ElementName=Root}" IsVisible="{Binding #Root.IsButtonMode}" />
                <TextBlock Grid.Column="1" Text="{Binding SelectedGestureText, ElementName=Root}" IsVisible="{Binding !#Root.IsButtonMode}"
                           Foreground="{DynamicResource SemiColorText2}" FontSize="11" />
            </Grid>
        </ToggleButton>
        <Popup x:Name="PickerPopup"
               PlacementTarget="{Binding #OpenButton}"
               Placement="BottomEdgeAlignedLeft"
               IsLightDismissEnabled="True"
               Opened="OnPopupOpened" Closed="OnPopupClosed">
            <Border x:Name="PopupContent" MinWidth="320" MaxHeight="420" Padding="6"
                    Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1" CornerRadius="6">
                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                <TextBox x:Name="SearchInput" PlaceholderText="{loc:Localize Entry.SearchTypes}" TextChanged="OnSearchChanged" />
                <TreeView Grid.Row="1" x:Name="TypeTree" ItemsSource="{Binding Categories, ElementName=Root}">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True" />
                        </Style>
                    </TreeView.Styles>
                    <TreeView.DataTemplates>
                        <TreeDataTemplate DataType="controls:EntryTypeCategoryItem" ItemsSource="{Binding Items}">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        </TreeDataTemplate>
                        <DataTemplate DataType="controls:EntryTypeLeafItem">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel><TextBlock Text="{Binding DisplayName}" /><TextBlock Text="{Binding Value}" FontSize="11" Opacity="0.65" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding GestureText}"
                                           Foreground="{DynamicResource SemiColorText2}" FontSize="11" />
                            </Grid>
                        </DataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
