<controls:ReorderableListControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:GalNet.Editor.Controls" xmlns:loc="using:GalNet.Editor.MarkupExtensions" xmlns:vm="using:GalNet.Editor.ViewModels" xmlns:models="using:GalNet.Editor.Models.Graph" x:Class="GalNet.Editor.Controls.BranchOptionListEditorControl" x:Name="Root" PointerMoved="OnDragPointerMoved" PointerReleased="OnDragPointerReleased">
  <controls:ReorderableListControl.Styles><StyleInclude Source="avares://GalNet.Editor/Controls/AuthorFormStyles.axaml"/></controls:ReorderableListControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <Button ToolTip.Tip="{loc:Localize Graph.Branch.Add}" AutomationProperties.Name="{loc:Localize Graph.Branch.Add}" HorizontalAlignment="Left" Command="{Binding AddCommand, ElementName=Root}">
      <TextBlock Text="{loc:Localize Graph.Branch.Add}" />
    </Button>
    <ListBox x:Name="ItemsListBox" Grid.Row="1" ItemsSource="{Binding ItemsSource, ElementName=Root}"
             Background="Transparent">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="models:BranchOptionEditorItemViewModel">
          <Border Margin="0,4" Padding="8" Background="{DynamicResource SemiColorBackground1}" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1" CornerRadius="6">
            <Grid ColumnDefinitions="Auto,*,*,Auto" ColumnSpacing="6">
              <Border Padding="6,0" Height="32" VerticalAlignment="Center" Background="Transparent" Cursor="SizeAll" PointerPressed="OnDragHandlePressed">
                <TextBlock Text="::" />
              </Border>
              <controls:GameTextBox Grid.Column="1" Binding="{Binding TextBinding}" Authoring="{Binding GameTexts}"
                                   VerticalAlignment="Top" AutomationProperties.Name="{loc:Localize Graph.Branch.Text}" />
              <controls:ConditionEditorControl ToolTip.Tip="{loc:Localize Graph.Branch.Condition}" AutomationProperties.Name="{loc:Localize Graph.Branch.Condition}" Grid.Column="2"
                                               VerticalAlignment="Top"
                                               Text="{Binding Condition}" Suggestions="{Binding ConditionSuggestions, ElementName=Root}"
                                               ValidationVariables="{Binding ValidationVariables, ElementName=Root}" />
              <Button Grid.Column="3" Height="32" VerticalAlignment="Top" ToolTip.Tip="{loc:Localize Graph.Branch.Remove}" AutomationProperties.Name="{loc:Localize Graph.Branch.Remove}" Command="{Binding RemoveCommand, ElementName=Root}" CommandParameter="{Binding}">
                <TextBlock Text="×" />
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</controls:ReorderableListControl>
