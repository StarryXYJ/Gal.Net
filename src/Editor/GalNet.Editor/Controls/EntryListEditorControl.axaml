<controls:ReorderableListControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:forms="using:GalNet.Game.Controls.Forms" xmlns:controls="using:GalNet.Editor.Controls"
             xmlns:vm="using:GalNet.Editor.ViewModels" xmlns:models="using:GalNet.Editor.Models.Graph"
             xmlns:loc="clr-namespace:GalNet.Editor.MarkupExtensions"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="GalNet.Editor.Controls.EntryListEditorControl"
             x:Name="Root"
             x:DataType="vm:GroupEditorPanelViewModel"
             MoveCommand="{Binding ReorderEntryCommand}" Focusable="True">
    <controls:ReorderableListControl.Styles>
        <Style Selector="forms|FieldEditorActions">
            <Setter Property="DefaultText" Value="{loc:Localize Form.Default}" />
            <Setter Property="OmitText" Value="{loc:Localize Form.Omit}" />
            <Setter Property="NullText" Value="{loc:Localize Form.Null}" />
            <Setter Property="RevertText" Value="{loc:Localize Form.Revert}" />
        </Style>
        <Style Selector="Expander.structured-field">
            <Setter Property="forms:StructuredFieldEditor.AddText" Value="{loc:Localize Form.AddElement}" />
            <Setter Property="forms:StructuredFieldEditor.RemoveText" Value="{loc:Localize Form.RemoveElement}" />
            <Setter Property="forms:StructuredFieldEditor.UpText" Value="{loc:Localize Form.MoveUp}" />
            <Setter Property="forms:StructuredFieldEditor.DownText" Value="{loc:Localize Form.MoveDown}" />
        </Style>
        <Style Selector="forms|SchemaForm" x:CompileBindings="False">
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Spacing="6">
                        <ItemsControl ItemsSource="{TemplateBinding Editors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="130,*" ColumnSpacing="8">
                                        <TextBlock DataContext="{Binding Context}" Text="{loc:Localize Label, FallbackPath=Field.Id}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1"><ContentControl Content="{Binding Control}" /><TextBlock Text="JSON" IsVisible="{Binding IsJsonFallback}" Opacity="0.65"/><forms:FieldEditorActions Context="{Binding Context}"/><TextBlock Text="{Binding Context.Issue.Message}" TextWrapping="Wrap" /></StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{TemplateBinding Diagnostics}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Message}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>
    </controls:ReorderableListControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <WrapPanel x:Name="EntryToolbar" Orientation="Horizontal">
            <Button Content="{loc:Localize Entry.Add}" Command="{Binding AddEntryCommand}" Margin="0,0,6,0" />
            <Button Content="{loc:Localize Entry.AppendBatch}" Command="{Binding AppendEntriesCommand}" Margin="0,0,6,0" />
            <NumericUpDown x:Name="BatchCount" Width="90" Minimum="1" Maximum="1000" Increment="1" FormatString="0" Value="{Binding BatchAddCount,Mode=TwoWay}" Margin="0,0,6,0" ToolTip.Tip="{loc:Localize Entry.BatchCount}" />
            <controls:EntryTypePicker x:Name="InsertPicker" MinWidth="180" Options="{Binding EntryTypes}" ShortcutService="{Binding ShortcutService}" SelectedValue="{Binding InsertionType,Mode=OneWay}" Opened="OnInsertPickerOpened" Closed="OnInsertPickerClosed" TypeConfirmed="OnInsertTypeConfirmed" />
        </WrapPanel>

        <ListBox Name="ItemsListBox"
                 Grid.Row="1"
                 Margin="0,8,0,0"
                 ItemsSource="{Binding GroupNode.Entries}"
                 SelectedItems="{Binding SelectedEntries, Mode=OneWay}"
                 SelectionMode="Multiple"
                 Background="Transparent" Padding="0,0,0,64">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:EntryEditorItemViewModel">
                    <Border Margin="0,4"
                            Padding="8"
                            Background="{DynamicResource SemiColorBackground1}"
                            BorderBrush="{DynamicResource SemiColorBorder}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                        <Grid ColumnDefinitions="Auto,48,140,*,Auto,Auto"
                              ColumnSpacing="8">
                            <Border Padding="6,0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Cursor="SizeAll"
                                    PointerPressed="OnDragHandlePressed">
                                <TextBlock Text="::" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Id}"
                                       VerticalAlignment="Center" />
                            <controls:EntryTypePicker Grid.Column="2"
                                                      Options="{Binding #Root.DataContext.EntryTypes}"
                                                      ShortcutService="{Binding #Root.DataContext.ShortcutService}"
                                                      SelectedValue="{Binding Type, Mode=OneWay}" TypeConfirmed="OnEntryTypeConfirmed" />
                            <controls:ConditionEditorControl Grid.Column="3"
                                                             Text="{Binding Condition}"
                                                             Suggestions="{Binding #Root.DataContext.ConditionSuggestions}"
                                                             ValidationVariables="{Binding #Root.DataContext.ValidationVariables}" />
                            <ToggleButton Name="ParametersToggle" Grid.Column="4"
                                          Width="30"
                                          IsChecked="{Binding IsParametersExpanded,Mode=TwoWay}"
                                          ToolTip.Tip="{loc:Localize Entry.ToggleParameters}">
                                <Grid>
                                    <PathIcon Width="16"
                                              Height="16"
                                              Data="{StaticResource ChevronUpRegular}"
                                              IsVisible="{Binding #ParametersToggle.IsChecked}" />
                                    <PathIcon Width="16"
                                              Height="16"
                                              Data="{StaticResource ChevronDownRegular}"
                                              IsVisible="{Binding #ParametersToggle.IsChecked, Converter={x:Static converters:BoolConverters.Not}}" />
                                </Grid>
                            </ToggleButton>
                            <Button Grid.Column="5"
                                    ToolTip.Tip="{loc:Localize Entry.Remove}"
                                    AutomationProperties.Name="{loc:Localize Entry.Remove}"
                                    Command="{Binding #Root.DataContext.RemoveEntryCommand}"
                                    CommandParameter="{Binding}"><PathIcon Width="16" Height="16" Data="{StaticResource DeleteRegularIcon}" /></Button>
                        </Grid>
                        <StackPanel Margin="0,8,0,0" Spacing="6" IsVisible="{Binding #ParametersToggle.IsChecked}">
                            <TextBlock Text="{loc:Localize Entry.UnknownTypePreserved}" IsVisible="{Binding IsUnknownType}" TextWrapping="Wrap" />
                            <TextBlock Text="{loc:Localize Entry.UnknownParametersPreserved}" IsVisible="{Binding HasUnknownParameters}" TextWrapping="Wrap" />
                            <forms:DtoEditorHost Item="{Binding ParameterForm.Item}" Registry="{Binding #Root.DataContext.FieldEditors}" IsVisible="{Binding HasParameterForm}" />
                            <ItemsControl ItemsSource="{Binding ParameterFields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:EntryParameterEditorItemViewModel">
                                        <ContentControl Content="{Binding}">
                                            <ContentControl.DataTemplates>
                                                <DataTemplate DataType="models:SchemaEntryParameterEditorItemViewModel" x:CompileBindings="False">
                                                    <forms:SchemaForm Schema="{Binding Fields}" Binding="{Binding FieldBinding}" Registry="{Binding #Root.DataContext.FieldEditors}" />
                                                </DataTemplate>
                                                <DataTemplate DataType="models:TextEntryParameterEditorItemViewModel"><Grid ColumnDefinitions="130,*" ColumnSpacing="8"><TextBlock Text="{loc:Localize DisplayNameKey}" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding StringValue}" AcceptsReturn="{Binding IsMultiline}" TextWrapping="Wrap" MinHeight="30" HorizontalAlignment="Stretch" /></Grid></DataTemplate>
                                                <DataTemplate DataType="models:AutocompleteEntryParameterEditorItemViewModel"><Grid ColumnDefinitions="130,*" ColumnSpacing="8"><TextBlock Text="{loc:Localize DisplayNameKey}" VerticalAlignment="Center" /><ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding Suggestions}" Text="{Binding StringValue}" HorizontalAlignment="Stretch" LostFocus="OnAutocompleteLostFocus" /></Grid></DataTemplate>
                                                <DataTemplate DataType="models:AssetEntryParameterEditorItemViewModel"><Grid ColumnDefinitions="130,*" ColumnSpacing="8"><TextBlock Text="{loc:Localize DisplayNameKey}" VerticalAlignment="Center" /><controls:AssetPicker Grid.Column="1" AssetManager="{Binding #Root.DataContext.AssetManager}" Filter="{Binding AssetFilter}" SelectedAssetId="{Binding StringValue}" HorizontalAlignment="Left" /></Grid></DataTemplate>
                                                <DataTemplate DataType="models:VariableNameEntryParameterEditorItemViewModel"><Grid ColumnDefinitions="130,*" ColumnSpacing="8"><TextBlock Text="{loc:Localize DisplayNameKey}" VerticalAlignment="Center" /><ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding Suggestions}" Text="{Binding StringValue, Mode=TwoWay}" HorizontalAlignment="Stretch" /></Grid></DataTemplate>
                                                <DataTemplate DataType="models:ExpressionEntryParameterEditorItemViewModel"><Grid ColumnDefinitions="130,*" ColumnSpacing="8"><TextBlock Text="{loc:Localize DisplayNameKey}" VerticalAlignment="Center" /><controls:ConditionEditorControl Grid.Column="1" Text="{Binding StringValue}" Suggestions="{Binding #Root.DataContext.ConditionSuggestions}" ValidationVariables="{Binding #Root.DataContext.ValidationVariables}" /></Grid></DataTemplate>
                                            </ContentControl.DataTemplates>
                                        </ContentControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding EffectHint}" Opacity="0.72" TextWrapping="Wrap" IsVisible="{Binding !HasEffectDiagnostic}" />
                            <TextBlock Text="{Binding EffectDiagnostic}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" TextWrapping="Wrap" IsVisible="{Binding HasEffectDiagnostic}" />
                        </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="{Binding ErrorText}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" TextWrapping="Wrap" />

    </Grid>
</controls:ReorderableListControl>
