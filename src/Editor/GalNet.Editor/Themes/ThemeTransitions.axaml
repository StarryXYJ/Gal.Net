<Styles xmlns="https://github.com/avaloniaui" xmlns:themes="using:GalNet.Editor.Themes">
    <Style Selector="Button">
        <Setter Property="Transitions"><Transitions>
            <themes:LinearBrushTransition Property="Background" Duration="0:0:0.16"/>
            <themes:LinearBrushTransition Property="BorderBrush" Duration="0:0:0.16"/>
        </Transitions></Setter>
    </Style>    <Style Selector="ToggleButton">
        <Setter Property="Transitions"><Transitions>
            <themes:LinearBrushTransition Property="Background" Duration="0:0:0.16"/>
            <themes:LinearBrushTransition Property="BorderBrush" Duration="0:0:0.16"/>
        </Transitions></Setter>
    </Style>    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions"><Transitions>
            <themes:LinearBrushTransition Property="Background" Duration="0:0:0.16"/>
            <themes:LinearBrushTransition Property="BorderBrush" Duration="0:0:0.16"/>
        </Transitions></Setter>
    </Style>    <Style Selector="ToggleButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions"><Transitions>
            <themes:LinearBrushTransition Property="Background" Duration="0:0:0.16"/>
            <themes:LinearBrushTransition Property="BorderBrush" Duration="0:0:0.16"/>
        </Transitions></Setter>
    </Style>
    <Style Selector="Border">
        <Setter Property="Transitions">
            <Transitions>
                <themes:LinearBrushTransition Property="Background" Duration="0:0:0.16" />
                <themes:LinearBrushTransition Property="BorderBrush" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Panel">
        <Setter Property="Transitions">
            <Transitions>
                <themes:LinearBrushTransition Property="Background" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Transitions">
            <Transitions>
                <themes:LinearBrushTransition Property="Foreground" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>
</Styles>
