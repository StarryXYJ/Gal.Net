<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="using:GalNet.Editor.Themes">
    <!-- Animate the painted surface, never its template-binding source as well.
         Icon templates paint ButtonSurface, so their empty presenter is excluded. -->
    <Style Selector="Button:not(.editor-icon) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions"><Transitions>
            <themes:LinearBrushTransition Property="Background" Duration="{x:Static themes:EditorMotion.HoverDuration}"/>
            <themes:LinearBrushTransition Property="BorderBrush" Duration="{x:Static themes:EditorMotion.HoverDuration}"/>
        </Transitions></Setter>
    </Style>
    <Style Selector="ToggleButton:not(.editor-icon) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions"><Transitions>
            <themes:LinearBrushTransition Property="Background" Duration="{x:Static themes:EditorMotion.HoverDuration}"/>
            <themes:LinearBrushTransition Property="BorderBrush" Duration="{x:Static themes:EditorMotion.HoverDuration}"/>
        </Transitions></Setter>
    </Style>
    <!-- TextBox, ComboBox and menu templates paint their border directly. -->
    <Style Selector="Border">
        <Setter Property="Transitions"><Transitions>
            <themes:LinearBrushTransition Property="Background" Duration="{x:Static themes:EditorMotion.HoverDuration}"/>
            <themes:LinearBrushTransition Property="BorderBrush" Duration="{x:Static themes:EditorMotion.HoverDuration}"/>
        </Transitions></Setter>
    </Style>
</Styles>
