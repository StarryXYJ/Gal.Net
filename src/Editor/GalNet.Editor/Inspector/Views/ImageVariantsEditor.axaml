<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:GalNet.Editor.Inspector.ViewModels" xmlns:loc="using:GalNet.Editor.MarkupExtensions"
 x:Class="GalNet.Editor.Inspector.Views.ImageVariantsEditor" x:Name="Root" x:DataType="vm:ImageVariantsInspector">
 <StackPanel Spacing="8">
  <TextBlock Text="{loc:Localize Variants.Title}" FontWeight="SemiBold"/>
  <StackPanel Spacing="6" IsEnabled="{Binding CanConfigure}">
   <TextBlock Text="{loc:Localize Variants.Folder}"/>
   <TextBox Name="VariantsFolder" Text="{Binding Folder}"/>
   <TextBlock Text="{loc:Localize Variants.Default}"/>
   <TextBox Name="VariantsDefault" Text="{Binding Default}"/>
   <ComboBox Name="VariantsDefaultChoices" ItemsSource="{Binding VariantKeys}" SelectedItem="{Binding DefaultChoice}" PlaceholderText="{loc:Localize Variants.Default}"/>
   <ItemsControl ItemsSource="{Binding Dimensions}">
    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:VariantDimensionRow">
     <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="4" Margin="0,2">
      <TextBox Name="VariantsDimensionKey" Text="{Binding Key}" PlaceholderText="key"/>
      <TextBox Grid.Column="1" Text="{Binding Label}" PlaceholderText="{loc:Localize Variants.Label}"/>
      <Button Grid.Column="2" Content="↑" Command="{Binding #Root.DataContext.MoveUpCommand}" CommandParameter="{Binding}"/>
      <Button Grid.Column="3" Content="×" Command="{Binding #Root.DataContext.RemoveDimensionCommand}" CommandParameter="{Binding}"/>
     </Grid>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <WrapPanel>
    <Button Content="{loc:Localize Variants.AddDimension}" Command="{Binding AddDimensionCommand}"/>
    <Button Content="{loc:Localize Variants.Infer}" Command="{Binding InferDimensionsCommand}"/>
   </WrapPanel>
  </StackPanel>
  <TextBlock Text="{Binding Impact}" TextWrapping="Wrap" Foreground="DarkOrange"/>
  <WrapPanel>
   <Button Name="VariantsApply" Content="{loc:Localize Variants.Apply}" Command="{Binding ApplyCommand}"/>
   <Button Name="VariantsRefresh" Content="{loc:Localize Variants.Refresh}" Command="{Binding RefreshCommand}"/>
   <Button Content="{loc:Localize Variants.ResetPreview}" Command="{Binding ResetPreviewCommand}"/>
  </WrapPanel>
  <TextBlock Text="{Binding Diagnostics}" TextWrapping="Wrap" Foreground="OrangeRed"/>
  <TextBlock Text="{Binding Buffer.Error}" TextWrapping="Wrap" Foreground="OrangeRed"/>
  <ItemsControl ItemsSource="{Binding PreviewRows}">
   <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:VariantPreviewRow">
    <Grid ColumnDefinitions="*,*" Margin="0,2">
     <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
     <ComboBox Name="VariantsPreviewChoice" Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Value}"/>
    </Grid>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <TextBlock Text="{loc:Localize Variants.Requested}" FontWeight="SemiBold"/>
  <TextBlock Text="{Binding Requested}" TextWrapping="Wrap"/>
  <TextBlock Text="{loc:Localize Variants.Actual}" FontWeight="SemiBold"/>
  <TextBlock Text="{Binding Actual}" TextWrapping="Wrap"/>
  <Image Source="{Binding Preview}" MaxHeight="300" Stretch="Uniform"/>
  <TextBlock Text="{Binding Fallback}" TextWrapping="Wrap"/>
  <Expander Header="JSON"><TextBox Name="VariantsJson" Text="{Binding Buffer.Text}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" IsReadOnly="{Binding Buffer.IsReadOnly}"/></Expander>
 </StackPanel>
</UserControl>
