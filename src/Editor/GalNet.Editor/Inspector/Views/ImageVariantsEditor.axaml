<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:GalNet.Editor.Inspector.ViewModels" xmlns:loc="using:GalNet.Editor.MarkupExtensions"
 x:Class="GalNet.Editor.Inspector.Views.ImageVariantsEditor" x:Name="Root" x:DataType="vm:ImageVariantsInspector">
 <StackPanel Spacing="8">
  <TextBlock Text="{loc:Localize Variants.Title}" FontWeight="SemiBold"/>
  <StackPanel Spacing="6" IsEnabled="{Binding CanConfigure}">
   <TextBlock Text="{loc:Localize Variants.Folder}"/>
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
    <TextBox Name="VariantsFolder" Text="{Binding Folder}" IsReadOnly="True"/>
    <Button Grid.Column="1" Content="{loc:Localize Common.Browse}" Command="{Binding BrowseFolderCommand}"/>
   </Grid>
   <TextBlock Text="{loc:Localize Variants.Default}"/>
   <ComboBox Name="VariantsDefaultChoices" ItemsSource="{Binding VariantKeys}" SelectedItem="{Binding DefaultChoice}"/>
   <ItemsControl ItemsSource="{Binding Dimensions}">
    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:VariantDimensionRow">
     <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
      <TextBlock Name="VariantsDimensionHeading" Text="{Binding Heading}" VerticalAlignment="Center"/>
      <TextBox Name="VariantsDimensionLabel" Grid.Column="1" Text="{Binding Label}" PlaceholderText="{loc:Localize Variants.Label}"/>
     </Grid>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </StackPanel>
  <TextBlock Text="{Binding Diagnostics}" TextWrapping="Wrap" Foreground="OrangeRed"/>
  <TextBlock Text="{Binding Buffer.Error}" TextWrapping="Wrap" Foreground="OrangeRed"/>
 </StackPanel>
</UserControl>
