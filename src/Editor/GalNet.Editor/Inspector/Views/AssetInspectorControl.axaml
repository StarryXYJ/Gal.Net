<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GalNet.Editor.Inspector.ViewModels" xmlns:views="using:GalNet.Editor.Inspector.Views" xmlns:converters="using:Avalonia.Data.Converters" xmlns:loc="using:GalNet.Editor.MarkupExtensions" x:Class="GalNet.Editor.Inspector.Views.AssetInspectorControl" x:DataType="vm:AssetInspectorControlViewModel">
 <Grid RowDefinitions="*,Auto,Auto">
  <ScrollViewer x:Name="AssetProperties" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="12" Spacing="10" IsVisible="{Binding HasSelectedAsset}">
    <TextBlock Text="{loc:Localize Inspector.Asset.Title}" FontWeight="SemiBold"/>
    <SelectableTextBlock Text="{Binding InspectedAsset.Name}" TextWrapping="Wrap"/>
    <TextBlock Text="{loc:Localize Inspector.Asset.Id}" Foreground="{DynamicResource SemiColorText2}"/>
    <SelectableTextBlock Text="{Binding InspectedAsset.Id}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
    <TextBlock Text="{loc:Localize Inspector.Asset.Path}" Foreground="{DynamicResource SemiColorText2}"/>
    <SelectableTextBlock Text="{Binding InspectedAsset.RelativePath}" TextWrapping="Wrap"/>
    <StackPanel IsVisible="{Binding IsSelectedAssetImage}" Spacing="6">
     <TextBlock Text="{loc:Localize Inspector.Asset.Filter}"/>
     <ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding AssetFilter}" HorizontalAlignment="Stretch"/>
     <TextBlock Text="{loc:Localize Inspector.Asset.Compression}"/>
     <ComboBox ItemsSource="{Binding CompressionOptions}" SelectedItem="{Binding AssetCompression}" HorizontalAlignment="Stretch"/>
    </StackPanel>
    <StackPanel IsVisible="{Binding IsSelectedAssetVideo}" Spacing="6">
     <TextBlock Text="{loc:Localize Inspector.Asset.Compression}"/>
     <ComboBox ItemsSource="{Binding CompressionOptions}" SelectedItem="{Binding AssetCompression}" HorizontalAlignment="Stretch"/>
    </StackPanel>
    <Panel IsVisible="{Binding Variants, Converter={x:Static converters:ObjectConverters.IsNotNull}}"><views:ImageVariantsEditor DataContext="{Binding Variants}"/></Panel>
   </StackPanel>
  </ScrollViewer>
  <GridSplitter Grid.Row="1" Height="6" ResizeDirection="Rows" HorizontalAlignment="Stretch" Background="Transparent" IsVisible="{Binding HasPreview}"/>
  <Expander x:Name="AssetPreview" Grid.Row="2" Header="{loc:Localize Uiux.Inspector.Preview}" IsExpanded="True" IsVisible="{Binding HasPreview}" HorizontalAlignment="Stretch" MaxHeight="300">
   <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="12,4,12,12">
    <StackPanel Spacing="8">
     <StackPanel IsVisible="{Binding IsSelectedAssetImage}" Spacing="6">
      <Image x:Name="AssetImagePreview" Source="{Binding ImagePreview}" MaxHeight="220" Stretch="Uniform"/>
      <TextBlock Text="{Binding ImagePreviewError}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" TextWrapping="Wrap"/>
     </StackPanel>
   <StackPanel IsVisible="{Binding IsSelectedAssetAudio}" Spacing="6">
    <TextBlock Text="{loc:Localize Inspector.Asset.AudioPreview}" />
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
     <Button Command="{Binding ToggleAudioPreviewCommand}" IsVisible="{Binding !IsAudioPreviewPlaying}"><PathIcon Data="M8,5V19L19,12Z" /></Button>
     <Button Command="{Binding ToggleAudioPreviewCommand}" IsVisible="{Binding IsAudioPreviewPlaying}"><PathIcon Data="M6,5H10V19H6ZM14,5H18V19H14Z" /></Button>
     <TextBlock Grid.Column="2" Text="{Binding AudioPreviewTimeText}" VerticalAlignment="Center" />
    </Grid>
    <Slider Minimum="0" Maximum="{Binding AudioPreviewDuration}" Value="{Binding AudioPreviewPosition}" PointerPressed="OnAudioSeekStarted" PointerReleased="OnAudioSeekCompleted" />
    <TextBlock Text="{Binding AudioPreviewError}" Foreground="OrangeRed" TextWrapping="Wrap" />
   </StackPanel>
   
     <Panel IsVisible="{Binding Variants, Converter={x:Static converters:ObjectConverters.IsNotNull}}"><views:ImageVariantsPreview DataContext="{Binding Variants}"/></Panel>
    </StackPanel>
   </ScrollViewer>
  </Expander>
 </Grid>
</UserControl>
