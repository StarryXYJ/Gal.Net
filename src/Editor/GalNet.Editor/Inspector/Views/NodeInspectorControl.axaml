<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:forms="using:GalNet.Game.Controls.Forms" xmlns:controls="using:GalNet.Editor.Controls" xmlns:vm="using:GalNet.Editor.Inspector.ViewModels" xmlns:views="using:GalNet.Editor.Inspector.Views" xmlns:loc="using:GalNet.Editor.MarkupExtensions"
             x:Class="GalNet.Editor.Inspector.Views.NodeInspectorControl" x:DataType="vm:NodeInspectorControlViewModel">
  <UserControl.Styles><StyleInclude Source="avares://GalNet.Editor/Inspector/Views/InspectorFormStyles.axaml"/></UserControl.Styles>
  <ScrollViewer><StackPanel Margin="12" Spacing="10">

    <TextBlock Text="{loc:Localize Inspector.Node.NoSelection}" Foreground="{DynamicResource SemiColorText2}" IsVisible="{Binding !HasSelectedNode}" />
    <StackPanel Spacing="8" IsVisible="{Binding HasSelectedNode}">
      <forms:FieldEditorRow ShowActions="False"><forms:FieldEditorRow.Label><TextBlock Text="{loc:Localize Inspector.Node.Name}" TextWrapping="Wrap"/></forms:FieldEditorRow.Label><forms:FieldEditorRow.Editor><TextBox Text="{Binding InspectedNode.Name}" /></forms:FieldEditorRow.Editor></forms:FieldEditorRow>
      <forms:FieldEditorRow ShowActions="False"><forms:FieldEditorRow.Label><TextBlock Text="{loc:Localize Inspector.Node.Type}" TextWrapping="Wrap"/></forms:FieldEditorRow.Label><forms:FieldEditorRow.Editor><TextBlock Text="{loc:Localize Path=InspectedNode.KindLabelKey}" Foreground="{DynamicResource SemiColorText1}" TextWrapping="Wrap" Margin="0,6,0,0"/></forms:FieldEditorRow.Editor></forms:FieldEditorRow>
      <forms:FieldEditorRow ShowActions="False"><forms:FieldEditorRow.Label><TextBlock Text="{loc:Localize Inspector.Node.Id}" TextWrapping="Wrap"/></forms:FieldEditorRow.Label><forms:FieldEditorRow.Editor><SelectableTextBlock Text="{Binding InspectedNode.Id}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" Margin="0,6,0,0"/></forms:FieldEditorRow.Editor></forms:FieldEditorRow>
      <Panel IsVisible="{Binding IsLinearGroupSelected}"><views:ResourceMetadataEditor DataContext="{Binding ResourceMetadata}" /></Panel>
      <StackPanel Spacing="6" IsVisible="{Binding IsLinearGroupSelected}"><TextBlock Text="{loc:Localize Inspector.Node.LinearGroup}" FontWeight="SemiBold" /><TextBlock Text="{Binding EntryCountText}" Foreground="{DynamicResource SemiColorText2}" /><TextBlock Text="{loc:Localize Packaging.StoryPackage}" /><AutoCompleteBox Name="StoryPackageInput" ItemsSource="{Binding StoryPackageNames}" Text="{Binding InspectedNode.StoryPackage, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Watermark="{loc:Localize Packaging.BaseGroup}" /><Button Content="{loc:Localize Inspector.Node.OpenGroupEditor}" HorizontalAlignment="Left" Command="{Binding OpenGroupEditorCommand}" /></StackPanel>
      <StackPanel Spacing="6" IsVisible="{Binding IsChoiceBranchSelected}"><TextBlock Text="{loc:Localize Inspector.Node.Options}" FontWeight="SemiBold" /><controls:BranchOptionListEditorControl ItemsSource="{Binding InspectedNode.Options}" AddCommand="{Binding AddChoiceOptionCommand}" RemoveCommand="{Binding RemoveChoiceOptionCommand}" MoveCommand="{Binding ReorderChoiceOptionCommand}" ConditionSuggestions="{Binding ConditionSuggestions}" ValidationVariables="{Binding ValidationVariables}" /></StackPanel>
      <StackPanel Spacing="6" IsVisible="{Binding IsConditionBranchSelected}"><TextBlock Text="{loc:Localize Inspector.Node.Conditions}" FontWeight="SemiBold" /><controls:BranchConditionListEditorControl ItemsSource="{Binding InspectedNode.Conditions}" AddCommand="{Binding AddConditionCommand}" RemoveCommand="{Binding RemoveConditionCommand}" MoveCommand="{Binding ReorderConditionCommand}" ConditionSuggestions="{Binding ConditionSuggestions}" ValidationVariables="{Binding ValidationVariables}" /></StackPanel>
    </StackPanel>
  </StackPanel></ScrollViewer>
</UserControl>
