<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GalNet.IntegrationTests"
             x:Class="GalNet.IntegrationTests.ProjectSettingsView"
             x:DataType="local:ProjectSettingsPage">
  <StackPanel>
    <CheckBox x:Name="Hints" Content="Project hints" IsChecked="{Binding Preferences.ShowHints}" />
    <Button Content="Apply project settings" Command="{Binding ApplyCommand}" />
  </StackPanel>
</UserControl>
