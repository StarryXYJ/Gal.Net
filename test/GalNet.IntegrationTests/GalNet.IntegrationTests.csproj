<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableGameDebugging Condition="'$(EnableGameDebugging)' == '' And '$(Configuration)' == 'Debug'">true</EnableGameDebugging>
    <EnableGameDebugging Condition="'$(EnableGameDebugging)' == ''">false</EnableGameDebugging>
    <DefineConstants Condition="'$(EnableGameDebugging)' == 'true'">$(DefineConstants);GALNET_GAME_DEBUG</DefineConstants>
    <EnableLaunchArguments Condition="'$(EnableLaunchArguments)' == ''">$(EnableGameDebugging)</EnableLaunchArguments>
    <DefineConstants Condition="'$(EnableLaunchArguments)' == 'true'">$(DefineConstants);GALNET_LAUNCH_ARGS</DefineConstants>
    <NuGetLockFilePath Condition="'$(EnableGameDebugging)' != 'true'">$(MSBuildProjectDirectory)/packages.lock.NoGameDebugging.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <ProjectReference Include="..\..\src\Shared\GalNet.Assets\GalNet.Assets.csproj" />
    <ProjectReference Include="..\..\src\Shared\GalNet.Core\GalNet.Core.csproj" />
    <ProjectReference Include="..\..\src\Editor\GalNet.Editor.Abstraction\GalNet.Editor.Abstraction.csproj" />
    <ProjectReference Include="..\..\src\Editor\GalNet.Editor.Shared\GalNet.Editor.Shared.csproj" />
    <ProjectReference Include="..\..\src\Shared\GalNet.Presentation.Abstractions\GalNet.Presentation.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Shared\GalNet.Primitives.Builtins\GalNet.Primitives.Builtins.csproj" />
    <ProjectReference Include="..\..\src\Shared\GalNet.Contracts.Builtins\GalNet.Contracts.Builtins.csproj" />
    <ProjectReference Include="..\..\src\Shared\GalNet.Runtime\GalNet.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Samples\GalNet.Sample.Avalonia\GalNet.Sample.Avalonia.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\GalNet.Storage.FileSystem\GalNet.Storage.FileSystem.csproj" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../../src/Shared/GalNet.GameHost/GalNet.GameHost.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(EnableGameDebugging)' != 'true'">
    <Compile Remove="ExternalSampleDebugTests.cs;SampleDebugLogStoreTests.cs;SampleDebugSnapshotFactoryTests.cs" />
  </ItemGroup>
</Project>
