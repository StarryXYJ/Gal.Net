<Project>
  <Import Project="packaging/GalNet.Player.targets" />
  <!-- Contracts use strict binary identity, including referenced metadata and
       PDB checksums. Keep this compile-time closure stable across Git commits. -->
  <PropertyGroup Condition="'$(AssemblyName)' == 'GalNet.Project.Contracts' Or '$(MSBuildProjectName)' == 'GalNet.Core' Or '$(MSBuildProjectName)' == 'GalNet.Contracts.Builtins'">
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Preserve portable PDBs and local debugging; omit commit-specific URLs. -->
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>
  <!-- The SDK maps the repository root, but leaves profile/RID-specific obj
       paths in portable PDBs. Those paths also change the DLL's PDB checksum. -->
  <Target Name="NormalizeContractGeneratedPaths" BeforeTargets="CoreCompile" DependsOnTargets="_SetPathMapFromSourceRoots"
          Condition="'$(AssemblyName)' == 'GalNet.Project.Contracts' Or '$(MSBuildProjectName)' == 'GalNet.Core' Or '$(MSBuildProjectName)' == 'GalNet.Contracts.Builtins'">
    <PropertyGroup>
      <_ContractIntermediateRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)'))</_ContractIntermediateRoot>
      <PathMap>$(_ContractIntermediateRoot)=/_/generated/$(MSBuildProjectName)/,$(PathMap)</PathMap>
    </PropertyGroup>
  </Target>
  <!-- Contract identity is the deployed IL binary, not an R2R-transformed copy. -->
  <ItemGroup Condition="'$(PublishReadyToRun)' == 'true'">
    <PublishReadyToRunExclude Include="GalNet.Core.dll;GalNet.Contracts.Builtins.dll;GalNet.Project.Contracts.dll" />
  </ItemGroup>
  <!-- SkiaSharp 3.119.4 R2R can crash in SKStream.Read during synthetic
       system-font creation on win-x64/.NET 10. Keep its original IL; the
       application and other dependencies still use ReadyToRun. -->
  <ItemGroup Condition="'$(PublishReadyToRun)' == 'true' And '$(RuntimeIdentifier)' == 'win-x64'">
    <PublishReadyToRunExclude Include="SkiaSharp.dll" />
  </ItemGroup>
  <Target Name="ValidateDesktopPublishTarget" BeforeTargets="_GenerateRestoreGraphProjectEntry;PrepareForBuild" Condition="'$(PublishProfile)' == 'Desktop'">
    <Error Condition="'$(GalNetDesktopPublishTarget)' != 'win-x64' And '$(GalNetDesktopPublishTarget)' != 'linux-x64' And '$(GalNetDesktopPublishTarget)' != 'osx-x64' And '$(GalNetDesktopPublishTarget)' != 'osx-arm64'"
           Text="Desktop publishing requires a global GalNetDesktopPublishTarget: win-x64, linux-x64, osx-x64 or osx-arm64." />
    <Error Condition="('$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe') And '$(RuntimeIdentifier)' != '$(GalNetDesktopPublishTarget)'"
           Text="Pass the same application RuntimeIdentifier and global GalNetDesktopPublishTarget for Desktop publishing." />
  </Target>
  <!-- Generate a normal SDK apphost targeting the packaged managed entry in lib/.
       Ordinary bin/publish apphosts are unaffected unless packaging opts in. -->
  <Target Name="CreatePackageAppHost" AfterTargets="Publish"
          DependsOnTargets="_GetAppHostPaths;_GetAppHostCreationConfiguration"
          Condition="'$(PackageAppHostDestinationPath)' != '' And '$(_IsExecutable)' == 'true'">
    <Error Condition="'$(AppHostSourcePath)' == '' Or !Exists('$(AppHostSourcePath)')" Text="Packaging requires an SDK apphost template." />
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(PackageAppHostDestinationPath)"
                   AppBinaryName="lib/$(AssemblyName)$(TargetExt)"
                   IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                   WindowsGraphicalUserInterface="$(_UseWindowsGraphicalUserInterface)"
                   EnableMacOSCodeSign="$(_EnableMacOSCodeSign)"
                   DisableCetCompat="$(_DisableCetCompat)" />
  </Target>
</Project>
