<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DefineConstants Condition="'$(Benchmark)' == 'true'">$(DefineConstants);BENCHMARK</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Benchmark)' == 'true'">
    <!-- Keep restore graphs and binaries separate from ordinary builds. -->
    <BaseIntermediateOutputPath>obj/benchmark/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/benchmark/</BaseOutputPath>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/obj/benchmark/packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishProfile)' == 'WindowsReadyToRun' And '$(Benchmark)' != 'true'">
    <!-- Keep the RID publish graph separate from ordinary development locks, but track it for locked CI restores. -->
    <BaseIntermediateOutputPath>obj/publish/WindowsReadyToRun/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/publish/WindowsReadyToRun/</BaseOutputPath>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages.lock.WindowsReadyToRun.json</NuGetLockFilePath>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Both output trees are generated, regardless of the active build mode. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)/obj/**;$(MSBuildProjectDirectory)/bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishProfile)' == 'Desktop' And '$(Benchmark)' != 'true'">
    <!-- Cross-target restores must not rewrite the normal/Windows R2R graph. -->
    <!-- Passed globally by publishing tools: the SDK clears RuntimeIdentifier
         while building portable ProjectReferences, but restore used the target RID. -->
    <GalNetDesktopPublishTarget Condition="'$(GalNetDesktopPublishTarget)' == ''">unspecified</GalNetDesktopPublishTarget>
    <BaseIntermediateOutputPath>obj/publish/Desktop/$(GalNetDesktopPublishTarget)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/publish/Desktop/$(GalNetDesktopPublishTarget)/</BaseOutputPath>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages.lock.Desktop.$(GalNetDesktopPublishTarget).json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
